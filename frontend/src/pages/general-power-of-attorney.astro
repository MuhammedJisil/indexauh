---
import ContactForm from '../components/ContactForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro'

const coverAreas = [
  {
    icon: "🏢",
    title: "Business and company matters",
    desc: "A representative may handle certain company procedures, sign documents, submit applications and manage administrative requirements. The POA should clearly state the powers granted.",
  },
  {
    icon: "💰",
    title: "Financial matters",
    desc: "A General POA may cover selected financial activities. These can include handling documents, accounts or specific financial procedures. Banks and financial institutions may have their own requirements.",
  },
  {
    icon: "🏛️",
    title: "Government and administrative work",
    desc: "The representative can handle certain government procedures, applications and document submissions on behalf of the principal.",
  },
  {
    icon: "🏠",
    title: "Personal and property matters",
    desc: "The POA may also cover selected personal or property related activities. However, certain transactions may require express wording or additional authorisation.",
  },
]

const gpoaAreas = [
  { icon: "👤", label: "Personal affairs" },
  { icon: "💰", label: "Financial matters" },
  { icon: "💼", label: "Business operations" },
  { icon: "🏢", label: "Company related procedures" },
  { icon: "🏛️", label: "Government and administrative work" },
  { icon: "✍️", label: "Document signing and submission" },
  { icon: "🏠", label: "Selected property related matters" },
]

const limitOrgs = ["A bank", "A property authority", "A court", "A government department"]

const comparisonRows = [
  { general: "Covers broader responsibilities", special: "Covers defined responsibilities" },
  { general: "Can address several matters", special: "Usually focuses on a specific purpose" },
  { general: "Useful for ongoing delegated tasks", special: "Useful for a particular task or transaction" },
  { general: "Powers depend on the drafted terms", special: "Powers are limited by the stated purpose" },
]

const docIncludes = [
  "Full details of the principal",
  "Details of the authorised representative",
  "Powers granted to the representative",
  "Scope of authority",
  "Relevant business, financial or administrative powers",
  "Duration or conditions, where applicable",
  "Signature requirements",
  "Translation requirements, where applicable",
]

const getSteps = [
  { step: "01", title: "Explain the purpose", desc: "Start by identifying what you want the representative to handle. This helps determine the powers that should appear in the POA." },
  { step: "02", title: "Prepare the draft", desc: "The General POA draft should clearly state the authority being granted. Proper wording matters, especially for documents used by banks, companies or government authorities." },
  { step: "03", title: "Check the documents", desc: "Prepare the required identification and supporting documents. Requirements can vary according to the applicant and purpose." },
  { step: "04", title: "Arrange translation", desc: "Arabic or certified translation may apply in certain cases. The required format depends on the authority handling the document." },
  { step: "05", title: "Complete notarisation", desc: "The document can then proceed through the applicable UAE notarisation process." },
  { step: "06", title: "Arrange attestation or legalisation", desc: "A POA intended for use outside the UAE may require further authentication. The process depends on the destination country and its requirements." },
]

const docsRequired = [
  "Passport",
  "Emirates ID, where applicable",
  "Representative's identification details",
  "General Power of Attorney draft",
  "Company documents for corporate matters",
  "Supporting documents related to the intended transaction",
  "Translation, where required",
]

const outsideProcess = [
  "Notarisation",
  "Attestation",
  "Legalisation",
  "Certified translation",
]

const services = [
  "General Power of Attorney drafting",
  "Document processing",
  "Notarisation",
  "Attestation",
  "Legalisation",
  "Certified translation",
  "Document coordination",
  "Pickup and delivery support",
]

const stats = [
  { num: "25+", label: "Years of experience" },
  { num: "200+", label: "Professionals" },
  { num: "100+", label: "Countries supported" },
]

const faqs = [
  { q: "Can I change the powers in my General Power of Attorney?", a: "Yes. A POA can be amended or replaced when you need to change the authority given to the representative. The applicable formalities depend on the document and authority involved." },
  { q: "Can a General Power of Attorney be cancelled?", a: "A principal can generally revoke a POA through the applicable legal procedure. The process can depend on how and where the original POA was issued." },
  { q: "Can I make a General Power of Attorney for a limited period?", a: "Yes. The document can state a duration or other conditions. The wording should clearly reflect the intended period of authority." },
  { q: "Can a company issue a General Power of Attorney?", a: "Yes. A company can use a POA to authorise an individual to handle certain business or administrative matters. Corporate documents and additional requirements may apply." },
  { q: "Can a General Power of Attorney be prepared for someone outside the UAE?", a: "The process depends on where the principal is located and where the POA will be used. Documents issued outside the UAE may require additional authentication and legalisation." },
  { q: "How can I start the General Power of Attorney process?", a: "Contact Index Office Services and share the purpose of the POA along with the available details. The team can review the requirements and assist with the applicable process." },
]
---

<BaseLayout
  title="General Power of Attorney in UAE | Index Office Services"
  description="Need a General Power of Attorney in the UAE? Index Office Services offers 25+ years of experience in drafting, notarisation, attestation and legalisation."
>

<style>
  .sec-inner { position: relative; z-index: 1; }
  .in-link { color: #fff; font-weight: 700; text-decoration: underline; text-decoration-color: #38B2AC; text-underline-offset: 3px; transition: color 0.2s; }
  .in-link:hover { color: #38B2AC; }
  .in-link-dark { color: #1A202C; font-weight: 700; text-decoration: underline; text-decoration-color: #38B2AC; text-underline-offset: 3px; transition: color 0.2s; }
  .in-link-dark:hover { color: #38B2AC; }
  .step-card { display: flex; align-items: flex-start; gap: 16px; background: #fff; border: 1px solid #eef0f6; border-radius: 14px; padding: 18px; transition: all 0.25s; }
  .step-card:hover { border-color: #B2F5EA; box-shadow: 0 10px 24px rgba(56,178,172,0.08); }
  .benefit-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px; }
  .poa-type-card { background: #F8FAFF; border: 1px solid #eef0f6; border-radius: 16px; padding: 26px; transition: all 0.25s; }
  .poa-type-card:hover { border-color: #B2F5EA; box-shadow: 0 8px 24px rgba(56,178,172,0.08); }
  .area-chip { display: flex; align-items: center; gap: 12px; background: #fff; border: 1px solid #eef0f6; border-radius: 12px; padding: 14px 16px; font-size: 0.9rem; font-weight: 600; color: #1A202C; transition: all 0.25s; }
  .area-chip:hover { border-color: #B2F5EA; box-shadow: 0 8px 20px rgba(56,178,172,0.08); }
  .cmp-table { width: 100%; border-collapse: separate; border-spacing: 0; min-width: 520px; }
  .cmp-table th { text-align: left; padding: 16px 20px; font-size: 0.95rem; font-weight: 800; }
  .cmp-table td { padding: 14px 20px; font-size: 0.9rem; color: #4B5563; line-height: 1.6; border-top: 1px solid #eef0f6; }
  .faq-item { border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden; }
  .faq-q { width: 100%; background: #fff; border: none; text-align: left; padding: 18px 20px; font-size: 0.9rem; font-weight: 600; color: #1A202C; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .faq-a { padding: 0 20px; max-height: 0; overflow: hidden; transition: max-height 0.35s ease, padding 0.2s; }
  .faq-a.open { max-height: 320px; padding: 0 20px 16px; }
  .faq-icon { font-size: 1.1rem; transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-icon { transform: rotate(45deg); }

  .split-grid { display: grid !important; }
  .three-col { display: grid !important; }
  .two-col { display: grid !important; }
  .four-col { display: grid !important; }

  @media(max-width:768px){
    .hero-title { font-size: 2rem !important; }
    .split-grid { grid-template-columns: 1fr !important; gap: 32px !important; }
    .three-col { grid-template-columns: 1fr !important; }
    .two-col { grid-template-columns: 1fr !important; }
    .four-col { grid-template-columns: 1fr !important; }
    .img-first { order: -1 !important; }
    .hero-btns { flex-direction: column !important; align-items: stretch !important; }
    .hero-btns a { text-align: center; justify-content: center; }
  }
</style>

<!-- ════════════ HERO ════════════ -->
<section style="position:relative;overflow:hidden;min-height:500px;display:flex;align-items:center;">
  <img src="/images/img-16.webp" alt="General Power of Attorney in UAE" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%;display:block;" loading="eager" fetchpriority="high" width="1200" height="600" />
  <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(26,32,44,0.92) 0%,rgba(45,55,72,0.80) 100%);"></div>
  <div style="position:absolute;inset:0;background-image:radial-gradient(rgba(56,178,172,0.18) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:880px;margin:0 auto;padding:96px 24px;text-align:center;width:100%;">
    <h1 class="hero-title" style="font-size:clamp(2rem,4vw,3.2rem);font-weight:900;color:#fff;line-height:1.15;margin:0 0 20px;">
      General Power of Attorney in UAE | Index Office Services
    </h1>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 20px;max-width:660px;">
      A General Power of Attorney is a legal document that lets one person authorise another person to act on their behalf. The person giving the authority is called the principal. The authorised person is the representative or attorney.
    </p>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 20px;max-width:660px;">
      A General POA can give broad authority for different matters. These may include business activities, administrative work, financial matters and document related tasks. The exact powers depend on the wording of the general power of attorney document.
    </p>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 20px;max-width:660px;">
      A General POA does not automatically cover every transaction. Some organisations may require specific powers or a Special Power of Attorney. Therefore, the document should match the purpose for which you need it.
    </p>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 32px;max-width:660px;">
      With 25+ years of experience, Index Office Services provides complete Power of Attorney assistance in the UAE. We handle drafting, processing, notarisation, attestation, legalisation and <a href="https://indexauh.com/legal-translation-in-uae/" class="in-link">certified translation</a>.
    </p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;" class="hero-btns">
      <a href="#get-in-touch" style="display:inline-flex;align-items:center;gap:8px;background:#38B2AC;color:#fff;font-weight:700;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none;box-shadow:0 4px 20px rgba(56,178,172,0.4);">Get Started &rarr;</a>
      <a href="#details" style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.3);color:#fff;font-weight:600;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none;">Learn More</a>
    </div>
  </div>
</section>

<!-- ════ WHAT CAN A GPOA COVER ════ -->
<section id="details" style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1280px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:48px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Service Overview</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">What Can a General Power of Attorney Cover?</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;max-width:700px;margin:0 auto;">
        A General Power of Attorney can cover several areas of responsibility. The principal can grant powers based on the matters they want the representative to handle.
      </p>
    </div>

    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-bottom:28px;" class="four-col">
      {coverAreas.map(c => (
        <div class="poa-type-card">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
            <span style="font-size:1.5rem;">{c.icon}</span>
            <h3 style="font-size:1rem;font-weight:800;color:#1A202C;margin:0;">{c.title}</h3>
          </div>
          <p style="font-size:0.85rem;color:#6B7280;line-height:1.7;margin:0;">{c.desc}</p>
        </div>
      ))}
    </div>

    <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:12px;padding:20px 24px;">
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0 0 8px;">
        For example, a property authority may ask for clearly stated powers before accepting a particular transaction. Similar requirements can apply to banks, courts and other organisations.
      </p>
    </div>
  </div>
</section>

<!-- ════ TYPES OF GPOA ════ -->
<section style="background:#F8FAFF;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner split-grid" style="max-width:1280px;margin:0 auto;grid-template-columns:1fr 1.2fr;gap:52px;align-items:center;">
    <div class="img-first">
      <div style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 12px 40px rgba(0,0,0,0.12);">
        <img src="/images/img-11.webp" alt="Types of general power of attorney in UAE" style="width:100%;height:460px;object-fit:cover;display:block;" loading="lazy" width="800" height="450" />
        <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(26,32,44,0.72) 100%);"></div>
        <div style="position:absolute;bottom:20px;left:20px;right:20px;">
          <p style="color:#fff;font-size:0.9rem;font-weight:800;margin:0 0 4px;">Powers That Match Your Purpose</p>
          <p style="color:#B2F5EA;font-size:0.75rem;margin:0;">Personal, financial, business and government matters</p>
        </div>
      </div>
    </div>

    <div>
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;display:flex;align-items:center;gap:8px;margin-bottom:12px;">
        <span style="display:inline-block;width:28px;height:1px;background:#2D3748;"></span>Our POA Services
      </p>
      <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);font-weight:900;color:#1A202C;line-height:1.2;margin:0 0 18px;">Types of General Power of Attorney</h2>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">
        The scope of a General Power of Attorney can vary according to the authority given in the document. There is no need to use one broad format for every situation.
      </p>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">Common areas include:</p>
      <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:20px;">
        {gpoaAreas.map(a => (
          <div class="area-chip">
            <span style="font-size:1.2rem;">{a.icon}</span>{a.label}
          </div>
        ))}
      </div>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">
        A general power of attorney draft should focus on the powers the representative actually needs. Clear wording can make the document easier to use later.
      </p>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin:0;">
        The purpose also matters. A POA prepared for company administration may need different powers from one prepared for personal or financial matters.
      </p>
    </div>
  </div>
</section>

<!-- ════ LIMITS ════ -->
<section style="background:#F0FFFE;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:44px 44px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1200px;margin:0 auto;">
    <div style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,0.1);margin-bottom:40px;">
      <img src="/images/img-7.webp" alt="Limits of a general power of attorney" style="width:100%;height:240px;object-fit:cover;object-position:center 35%;display:block;" loading="lazy" width="800" height="450" />
      <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(26,32,44,0.88) 0%,rgba(26,32,44,0.5) 55%,transparent 100%);"></div>
      <div style="position:absolute;top:50%;left:40px;transform:translateY(-50%);">
        <p style="color:#38B2AC;font-weight:700;font-size:0.75rem;letter-spacing:0.12em;text-transform:uppercase;margin:0 0 6px;">Know the Scope</p>
        <h2 style="color:#fff;font-size:clamp(1.4rem,2.5vw,2rem);font-weight:900;margin:0;max-width:500px;line-height:1.25;">What Are the Limits of a General Power of Attorney?</h2>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:1.3fr 1fr;gap:32px;align-items:flex-start;" class="split-grid">
      <div>
        <p style="color:#1A202C;font-size:1.05rem;font-weight:700;line-height:1.7;margin:0 0 14px;">
          The word “General” does not mean unlimited authority.
        </p>
        <p style="color:#4B5563;font-size:0.95rem;line-height:1.8;margin:0 0 14px;">
          The principal decides the powers granted through the document. At the same time, the organisation receiving the POA may have its own requirements.
        </p>
        <p style="color:#4B5563;font-size:0.95rem;line-height:1.8;margin:0 0 14px;">
          Certain transactions may need express authority. For example, a bank, property authority, court or government department may ask for specific wording. In some cases, a Special Power of Attorney may be more suitable.
        </p>
        <p style="color:#4B5563;font-size:0.95rem;line-height:1.8;margin:0 0 14px;">
          Therefore, using a generic template without considering its purpose can create problems later. The wording should clearly reflect the responsibilities you want to delegate.
        </p>
        <p style="color:#4B5563;font-size:0.95rem;line-height:1.8;margin:0;">
          A properly prepared document can also help avoid unnecessary delays during notarisation or submission.
        </p>
      </div>
      <div style="background:#fff;border:1px solid #B2F5EA;border-radius:14px;padding:22px 26px;">
        <h3 style="font-size:0.95rem;font-weight:800;color:#1A202C;margin:0 0 12px;">May ask for specific wording</h3>
        <div style="display:flex;flex-direction:column;gap:8px;">
          {limitOrgs.map(d => (
            <div style="display:flex;align-items:flex-start;gap:10px;font-size:0.9rem;color:#4B5563;line-height:1.5;">
              <span style="color:#38B2AC;font-weight:bold;flex-shrink:0;margin-top:2px;">→</span>{d}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ════ GENERAL VS SPECIAL ════ -->
<section style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:960px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:36px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Compare</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">General Power of Attorney vs Special Power of Attorney</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;max-width:700px;margin:0 auto;">
        A General POA provides broader authority across several matters. A Special POA focuses on a particular matter, transaction or defined responsibility.
      </p>
    </div>

    <div style="border:1px solid #eef0f6;border-radius:16px;overflow-x:auto;background:#fff;box-shadow:0 8px 24px rgba(0,0,0,0.04);margin-bottom:20px;">
      <table class="cmp-table">
        <thead>
          <tr>
            <th style="background:#2D3748;color:#fff;">General Power of Attorney</th>
            <th style="background:#38B2AC;color:#fff;">Special Power of Attorney</th>
          </tr>
        </thead>
        <tbody>
          {comparisonRows.map(r => (
            <tr>
              <td style="width:50%;">{r.general}</td>
              <td style="width:50%;background:#F8FAFF;">{r.special}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:12px;padding:18px 22px;">
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0;">
        The suitable format depends on the purpose of the document and the requirements of the organisation receiving it.
      </p>
    </div>
  </div>
</section>

<!-- ════ WHAT SHOULD IT INCLUDE ════ -->
<section style="background:#F8FAFF;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner split-grid" style="max-width:1280px;margin:0 auto;grid-template-columns:1.2fr 1fr;gap:52px;align-items:center;">
    <div>
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;display:flex;align-items:center;gap:8px;margin-bottom:12px;">
        <span style="display:inline-block;width:28px;height:1px;background:#2D3748;"></span>Drafting
      </p>
      <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);font-weight:900;color:#1A202C;line-height:1.2;margin:0 0 18px;">What Should a General Power of Attorney Document Include?</h2>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">
        A well prepared general power of attorney document should clearly identify everyone involved. It should also explain the authority being given.
      </p>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">It may include:</p>
      <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:20px;">
        {docIncludes.map(item => (
          <div style="display:flex;align-items:flex-start;gap:12px;background:#fff;border:1px solid #eef0f6;border-radius:10px;padding:12px 16px;">
            <span style="color:#38B2AC;font-weight:bold;font-size:1rem;flex-shrink:0;margin-top:2px;">→</span>
            <p style="font-size:0.9rem;color:#374151;line-height:1.6;margin:0;">{item}</p>
