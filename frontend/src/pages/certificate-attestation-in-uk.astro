---
import BaseLayout from '../layouts/BaseLayout.astro'
import ContactForm from '../components/ContactForm.astro';
import DocumentCoverage from '../components/DocumentCoverage.astro';

const linkStyle = "color:#1A202C;font-weight:700;text-decoration:underline;text-decoration-color:#38B2AC;text-underline-offset:3px;";
const waLink = "https://wa.me/971529300200";

const whoNeeds = [
  "Employment visa or a new job contract",
  "Spouse or family visa",
  "Child visa or school admission",
  "University admission or professional licensing",
  `<a href='/company-formation-in-dubai/' style='${linkStyle}'>Company formation in Dubai</a> or bank account opening`,
  "Court or legal use",
]

// Passed to the shared DocumentCoverage component (country="uk")
const docTypes = [
  {
    category: "Education",
    icon: "🎓",
    docs: [
      "UK degree certificate attestation, including master’s and PhD",
      "Diploma certificate attestation and transcripts",
      "Educational certificate attestation for A Level and O Level",
      "Transfer certificate attestation for school admission",
      "ACCA and NEBOSH certificates",
    ],
  },
  {
    category: "Personal",
    icon: "👤",
    docs: [
      "UK marriage certificate attestation for UAE family visas",
      "Birth certificate attestation",
      "Death certificate attestation",
      "Divorce certificate attestation",
      "ACRO police clearance certificate attestation",
      "Medical certificate attestation",
      "Powers of attorney, through power of attorney notarization",
    ],
  },
  {
    category: "Commercial",
    icon: "⚖️",
    docs: [
      "Certificate of incorporation and certificate of good standing",
      "Memorandum of Association",
      "Articles of Association",
      "Board resolutions",
      "Corporate power of attorney",
    ],
  },
]

const processSteps = [
  { step: "01", title: "File review", desc: "Our compliance experts check your originals, name match and route." },
  { step: "02", title: "Doorstep pickup", desc: "We collect your documents from your home or office." },
  { step: "03", title: "UK certification", desc: `A UK solicitor or notary certifies your document. Our <a href='/notary-attestation-services/' style='${linkStyle}'>notary attestation services</a> and certified true copy support cover this stage.` },
  { step: "04", title: "FCDO apostille", desc: `Next, we submit your file through our <a href='/apostille-service-uae/' style='${linkStyle}'>apostille service</a>.` },
  { step: "05", title: "UAE Embassy attestation", desc: `We then file it with the UAE Embassy in London. Our <a href='/embassy-attestation-in-uae/' style='${linkStyle}'>embassy attestation</a> team uses the digital route or the physical route, based on your document.` },
  { step: "06", title: "MOFA attestation", desc: `Digital attestation returns one copy attested by the embassy and MOFA. For physical cases, we complete <a href='/mofa-attestation-in-uae/' style='${linkStyle}'>MOFA attestation</a> in the UAE.` },
  { step: "07", title: "Translation and delivery", desc: `We add Arabic through <a href='/legal-translation-in-uae/' style='${linkStyle}'>legal translation</a> where needed. Finally, we deliver your document to your door.` },
]

const timingFactors = [
  "Your document type",
  "The FCDO service you choose",
  "Embassy processing time",
  "Courier and pickup time",
]

const costFactors = [
  "Document type: education, personal or commercial",
  "Number of documents in your file",
  "Standard or express handling",
  "Government and embassy fees",
  "Courier, pickup and delivery",
  "Arabic translation, in case you need it",
]

const mistakes = [
  { title: "Laminated documents", desc: "The UAE Embassy in London does not legalise them." },
  { title: "Photocopies", desc: "Personal documents such as marriage certificates need originals." },
  { title: "Wrong stage order", desc: "A missing apostille blocks the embassy stage." },
  { title: "Name mismatch", desc: "The spelling must match your passport." },
  { title: "No certification", desc: "Private documents need a solicitor or notary first." },
]

const checklist = [
  "Original document, with no lamination",
  "Passport copy of the holder, front and back",
  "Name and date of birth that match the passport",
  "The purpose: visa, job, study or business",
  "A phone number for status updates",
]

const whyChoose = [
  { title: "25+ Years of Experience", desc: "We bring 25+ years of attestation experience, since 2000." },
  { title: "UK Stages Managed for You", desc: "We manage the UK stages, even when you live in the UAE." },
  { title: "200+ Attestation Professionals", desc: "Our team handles your file from start to finish." },
  { title: "Compliance Checks", desc: "Our compliance experts check each file before submission." },
  { title: "Digital Attestation", desc: "We offer digital attestation where your document allows it." },
  { title: "Arabic Translation Included", desc: "We arrange Arabic translation within the same file." },
]

const faqs = [
  { q: "Can I attest UK documents without travelling to the UK?", a: "Yes. Our team manages the UK stages for you. You stay in the UAE." },
  { q: "Can I attest a photocopy?", a: "Personal documents need the original. For degrees, a solicitor can certify a copy. We confirm this case by case." },
  { q: "Do ACCA and NEBOSH certificates need London attestation?", a: "Usually yes, in whichever country they were issued. We confirm your route at review." },
  { q: "Does attestation expire?", a: "Attestation itself has no set expiry in most cases. However, an authority can ask for a recent document. Police certificates often have limited validity." },
  { q: "What happens in case of rejection?", a: "The embassy returns your originals. It does not refund its service fee. You can resubmit once you fix the issue. We check files first to prevent this." },
  { q: "Do documents from Scotland, Wales and Northern Ireland follow the same route?", a: "Yes. The UAE Embassy in London handles documents issued in the United Kingdom." },
]
---

<BaseLayout
  title="UK Certificate Attestation in UAE: Steps, Timeline and Cost Factors"
  description="Get UK certificate attestation for the UAE. See documents, steps, timeline and cost factors. End to end help from Index, serving clients since 2000."
>
<style>
  .sec-inner { position: relative; z-index: 1; }
  .idx-pill { background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.28); color: #fff; font-size: 0.78rem; padding: 5px 14px; border-radius: 9999px; font-weight: 500; white-space: nowrap; }
  .step-card { display: flex; align-items: flex-start; gap: 16px; background: #fff; border: 1px solid #eef0f6; border-radius: 14px; padding: 18px; transition: all 0.25s; }
  .step-card:hover { border-color: #B2F5EA; box-shadow: 0 10px 24px rgba(56,178,172,0.08); }
  .benefit-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px; }
  .faq-item { border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden; }
  .faq-q { width: 100%; background: #fff; border: none; text-align: left; padding: 18px 20px; font-size: 0.9rem; font-weight: 600; color: #1A202C; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .faq-a { padding: 0 20px; max-height: 0; overflow: hidden; transition: max-height 0.35s ease, padding 0.2s; }
  .faq-a.open { max-height: 240px; padding: 0 20px 16px; }
  .faq-icon { font-size: 1.1rem; transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-icon { transform: rotate(45deg); }
  .inline-link { color:#1A202C;font-weight:700;text-decoration:underline;text-decoration-color:#38B2AC;text-underline-offset:3px; }
  .wa-btn { display:inline-flex;align-items:center;gap:8px;background:#38B2AC;color:#fff;font-weight:700;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none;box-shadow:0 4px 20px rgba(56,178,172,0.4); }

  .split-grid { display: grid !important; }
  .three-col { display: grid !important; }
  .two-col { display: grid !important; }

  @media(max-width:768px){
    .hero-title { font-size: 2rem !important; }
    .split-grid { grid-template-columns: 1fr !important; gap: 32px !important; }
    .three-col { grid-template-columns: 1fr !important; }
    .two-col { grid-template-columns: 1fr !important; }
  }
</style>

<!-- ════════════ HERO ════════════ -->
<section style="position:relative;overflow:hidden;min-height:500px;display:flex;align-items:center;">
  <img src="/images/img-32.webp" alt="UK Certificate Attestation in UAE — London" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%;display:block;" loading="eager" fetchpriority="high" width="1200" height="600" />
  <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(26,32,44,0.92) 0%,rgba(45,55,72,0.80) 100%);"></div>
  <div style="position:absolute;inset:0;background-image:radial-gradient(rgba(56,178,172,0.18) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:880px;margin:0 auto;padding:96px 24px;text-align:center;width:100%;">
    <div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:18px;">
      <span class="idx-pill">Established 2000</span>
      <span class="idx-pill">25+ Yrs Experience</span>
      <span class="idx-pill">400,000+ Clients Served</span>
      <span class="idx-pill">100+ Countries</span>
    </div>
    <h1 class="hero-title" style="font-size:clamp(2rem,4vw,3.2rem);font-weight:900;color:#fff;line-height:1.15;margin:0 0 20px;">UK Certificate Attestation in UAE</h1>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 16px;max-width:700px;">
      Rejected documents cost you weeks, fees and sleep. Most rejections come from one missed stamp or one wrong order. Therefore, the right path matters from day one.
    </p>
    <p style="color:#E2E8F0;font-size:1rem;line-height:1.8;margin:0 auto 32px;max-width:700px;">
      UK certificate attestation makes your UK document valid in the UAE. It runs through four checks: UK certification, FCDO apostille, UAE Embassy attestation in London, and MOFA. We manage every stage, including digital attestation, through our <a href="/certificate-attestation-in-the-uae/" style="color:#fff;font-weight:700;text-decoration:underline;text-decoration-color:#38B2AC;text-underline-offset:3px;">certificate attestation in the UAE</a> service.
    </p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
      <a href={waLink} class="wa-btn">Chat with us on WhatsApp: (+971) 529 300 200</a>
      <a href="#details" style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.3);color:#fff;font-weight:600;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none;">Learn More</a>
    </div>
  </div>
</section>

<!-- ════ OVERVIEW ════ -->
<section id="details" style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner split-grid" style="max-width:1280px;margin:0 auto;grid-template-columns:1.2fr 1fr;gap:52px;align-items:center;">
    <div>
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;display:flex;align-items:center;gap:8px;margin-bottom:12px;">
        <span style="display:inline-block;width:28px;height:1px;background:#2D3748;"></span>Service Overview
      </p>
      <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);font-weight:900;color:#1A202C;line-height:1.2;margin:0 0 18px;">What is UK certificate attestation for the UAE?</h2>
      <p style="color:#4B5563;font-size:0.95rem;line-height:1.8;margin-bottom:14px;">
        It confirms that your UK document is genuine. UAE employers, universities, banks and visa offices then accept it.
      </p>
      <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:12px;padding:18px;">
        <h3 style="color:#1A202C;font-size:0.95rem;font-weight:700;margin:0 0 6px;">Why an apostille alone is not enough</h3>
        <p style="color:#4B5563;font-size:1rem;line-height:1.75;margin:0;">
          The UK is part of the Hague Apostille Convention. However, the UAE is not. As a result, an apostille alone does not work. You also need UAE Embassy attestation and the MOFA stage.
        </p>
      </div>
    </div>

    <div>
      <div style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 12px 40px rgba(0,0,0,0.12);">
        <img src="/images/uk-flag.webp" alt="UK document attestation" style="width:100%;height:420px;object-fit:cover;display:block;" loading="lazy" width="400" height="260" />
        <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(26,32,44,0.72) 100%);"></div>
        <div style="position:absolute;bottom:20px;left:20px;right:20px;">
          <p style="color:#fff;font-size:0.9rem;font-weight:800;margin:0 0 4px;">UK Certification · FCDO · UAE Embassy · MOFA</p>
          <p style="color:#B2F5EA;font-size:0.75rem;margin:0;">End to end handling: home country, embassy and MOFA stages</p>
        </div>
        <div style="position:absolute;bottom:80px;left:-14px;background:#2D3748;color:#fff;padding:10px 16px;border-radius:10px;font-size:0.75rem;font-weight:700;box-shadow:0 6px 20px rgba(0,0,0,0.2);">
          25+ Years Experience
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ════ WHO NEEDS ════ -->
<section style="background:#F8FAFF;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1280px;margin:0 auto;">
    <div style="display:grid;grid-template-columns:0.9fr 1.4fr;gap:48px;align-items:center;" class="split-grid">
      <div style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,0.1);">
        <img src="/images/img-11.webp" alt="Who needs UK document attestation for UAE" style="width:100%;height:400px;object-fit:cover;display:block;" loading="lazy" width="800" height="450" />
        <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(26,32,44,0.75) 100%);"></div>
        <div style="position:absolute;bottom:20px;left:20px;right:20px;">
          <p style="color:#fff;font-size:0.9rem;font-weight:800;margin:0 0 4px;">When You Need Attestation</p>
          <p style="color:#B2F5EA;font-size:0.75rem;margin:0;">Visa · Business · Education · Family</p>
        </div>
      </div>
      <div>
        <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Key Situations</p>
        <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">Who needs UK document attestation for UAE?</h2>
        <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;margin-bottom:24px;">You usually need it in these cases:</p>
        <div style="display:flex;flex-direction:column;gap:12px;">
          {whoNeeds.map(item => (
            <div style="display:flex;align-items:flex-start;gap:12px;background:#fff;border:1px solid #eef0f6;border-radius:12px;padding:14px 18px;">
              <span style="color:#38B2AC;font-weight:bold;font-size:1rem;flex-shrink:0;margin-top:2px;">→</span>
              <p style="font-size:0.9rem;color:#374151;line-height:1.6;margin:0;" set:html={item}></p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ════ DOCUMENT TYPES (shared component) ════ -->
<DocumentCoverage
  title="Which UK documents can you attest?"
  description="We handle attestation for education, personal and commercial documents. Always check with the requesting authority to confirm exactly what form of attestation they require."
  imageSrc="/images/img-1.webp"
  imageAlt="Document types for UK attestation"
  docTypes={docTypes}
  country="uk"
/>

<!-- ════ PROCESS ════ -->
<section style="background:#F0FFFE;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:44px 44px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1000px;margin:0 auto;">
    <div style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,0.1);margin-bottom:40px;">
      <img src="/images/img-7.webp" alt="UK attestation process steps" style="width:100%;height:240px;object-fit:cover;object-position:center 35%;display:block;" loading="lazy" width="800" height="450" />
      <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(26,32,44,0.88) 0%,rgba(26,32,44,0.5) 55%,transparent 100%);"></div>
      <div style="position:absolute;top:50%;left:40px;transform:translateY(-50%);">
        <p style="color:#38B2AC;font-weight:700;font-size:0.75rem;letter-spacing:0.12em;text-transform:uppercase;margin:0 0 6px;">Step-by-Step</p>
        <h2 style="color:#fff;font-size:clamp(1.4rem,2.5vw,2rem);font-weight:900;margin:0;max-width:500px;line-height:1.25;">What is the UK certificate attestation process at Index?</h2>
      </div>
    </div>

    <p style="color:#4B5563;font-size:1rem;line-height:1.75;margin:0 0 24px;text-align:center;">You hand over your document once. We then run every stage and share real time updates.</p>

    <div style="display:flex;flex-direction:column;gap:14px;">
      {processSteps.map(s => (
        <div class="step-card">
          <div style="width:42px;height:42px;border-radius:10px;background:#2D3748;color:#38B2AC;font-weight:900;font-size:1rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;">{s.step}</div>
          <div>
            <p style="font-size:1.05rem;font-weight:700;color:#1A202C;margin:0 0 4px;">{s.title}</p>
            <p style="font-size:0.9rem;color:#6B7280;line-height:1.6;margin:0;" set:html={s.desc}></p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ════ TIMELINE & COST ════ -->
<section style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1280px;margin:0 auto;">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start;" class="two-col">

      <div>
        <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Timeline</p>
        <h2 style="font-size:1.7rem;font-weight:900;color:#1A202C;margin:0 0 14px;">How long does UK certificate attestation take?</h2>
        <p style="color:#4B5563;font-size:0.95rem;line-height:1.8;margin-bottom:20px;">
          Market timelines range from 18 to 30 working days. Your file can move faster or slower.
        </p>
        <div style="background:#F8FAFF;border:1px solid #eef0f6;border-radius:16px;padding:24px;margin-bottom:18px;">
          <h3 style="font-size:0.9rem;font-weight:800;color:#1A202C;margin:0 0 14px;border-left:3px solid #38B2AC;padding-left:12px;">Four things decide your timeline</h3>
          <div style="display:flex;flex-direction:column;gap:10px;">
            {timingFactors.map(f => (
              <div style="display:flex;align-items:center;gap:10px;font-size:0.9rem;color:#4B5563;">
                <span style="color:#38B2AC;font-weight:bold;flex-shrink:0;">→</span>{f}
              </div>
            ))}
          </div>
        </div>
        <p style="color:#4B5563;font-size:0.95rem;line-height:1.8;margin:0;">
          We never promise a fixed date. However, you can check progress anytime on our <a href="/track-document/" class="inline-link">document tracking</a> page.
        </p>
      </div>

      <div>
        <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Cost</p>
        <h2 style="font-size:1.7rem;font-weight:900;color:#1A202C;margin:0 0 14px;">UK certificate attestation for UAE cost: what affects the price?</h2>
        <p style="color:#4B5563;font-size:0.95rem;line-height:1.8;margin-bottom:20px;">
          Each file differs, so please <a href="#get-in-touch" class="inline-link">contact us for a quote</a>.
        </p>
        <div style="background:#F8FAFF;border:1px solid #eef0f6;border-radius:16px;padding:24px;margin-bottom:18px;">
          <h3 style="font-size:0.9rem;font-weight:800;color:#1A202C;margin:0 0 14px;border-left:3px solid #38B2AC;padding-left:12px;">These factors shape your cost</h3>
          <div style="display:flex;flex-direction:column;gap:10px;">
            {costFactors.map(f => (
              <div style="display:flex;align-items:center;gap:10px;font-size:0.9rem;color:#4B5563;">
                <span style="color:#38B2AC;font-weight:bold;flex-shrink:0;">→</span>{f}
              </div>
            ))}
          </div>
        </div>
        <p style="color:#4B5563;font-size:0.95rem;line-height:1.8;margin:0 0 18px;">
          Next, send a photo of your document. Then we share a clear quote before work starts.
        </p>
        <a href={waLink} class="wa-btn">Get your quote on WhatsApp</a>
      </div>

    </div>
  </div>
</section>

<!-- ════ MISTAKES ════ -->
<section style="background:#F8FAFF;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1280px;margin:0 auto;">
    <div style="display:grid;grid-template-columns:1.1fr 1fr;gap:48px;align-items:start;" class="two-col">

      <div>
        <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">What to Watch For</p>
        <h2 style="font-size:1.7rem;font-weight:900;color:#1A202C;margin:0 0 14px;">What are the common mistakes and rejection reasons?</h2>
        <p style="color:#4B5563;font-size:0.95rem;line-height:1.8;margin-bottom:20px;">Our team sees the same errors often:</p>
        <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:24px;">
          {mistakes.map(m => (
            <div style="display:flex;align-items:flex-start;gap:12px;background:#FFF5F5;border:1px solid #FED7D7;border-radius:10px;padding:12px 16px;">
              <span style="color:#E53E3E;font-weight:bold;font-size:1rem;flex-shrink:0;">!</span>
