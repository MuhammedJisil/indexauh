---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Thank You — Index Office Services"
  description="Your request has been received."
  hideCallbackPopup={true}
>
  <section style="min-height: 70vh; display: flex; align-items: center; justify-content: center; padding: 80px 20px; background: #F7FAFC;">
    <div style="text-align: center; max-width: 560px;">
      <div style="width: 84px; height: 84px; border-radius: 50%; background: #38B2AC; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
        <svg viewBox="0 0 24 24" width="42" height="42" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <h1 style="font-size: 30px; font-weight: 800; color: #1A202C; margin: 0 0 12px;">
        Thank You!
      </h1>
      <p style="font-size: 16px; color: #4A5568; margin-bottom: 32px; line-height: 1.6;">
        Your request has been submitted successfully. Our team will get back to
        you within 24 hours.
      </p>
<a
        href="/"
        style="background: #38B2AC; color: white; padding: 14px 28px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 15px; display: inline-block;"
      >
        Back to Home
      </a>
    </div>
  </section>
</BaseLayout>