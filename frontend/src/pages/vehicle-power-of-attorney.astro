---
import ContactForm from '../components/ContactForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro'

const whenNeeded = [
  { icon: "✈️", label: "The owner is outside the UAE" },
  { icon: "🚫", label: "The owner cannot attend the transaction personally" },
  { icon: "🤝", label: "Someone needs to sell the vehicle" },
  { icon: "🔄", label: "A representative needs to complete ownership transfer" },
  { icon: "📋", label: "Another person needs to handle registration matters" },
  { icon: "🚢", label: "The vehicle needs to be exported" },
  { icon: "✅", label: "The owner wants to authorise specific vehicle related actions" },
]

const useCases = [
  {
    icon: "🤝",
    title: "Selling a Vehicle Through Power of Attorney",
    desc: "A vehicle owner can appoint a representative to handle a sale on their behalf. The POA can authorise the representative to sign the required documents and complete procedures connected with the sale and ownership transfer. Details about the vehicle should appear clearly in the document. The wording should also give the representative enough authority to complete the intended transaction.",
  },
  {
    icon: "🛒",
    title: "Buying a Vehicle Through Power of Attorney",
    desc: "A buyer can authorise another person to handle a specified vehicle purchase. The representative may deal with the required paperwork and complete the permitted purchase procedures. The POA should clearly state the authority being granted.",
  },
  {
    icon: "🔄",
    title: "Vehicle Ownership Transfer",
    desc: "A representative may also handle vehicle ownership transfer when the POA provides the required authority. The document should identify the vehicle and describe the actions the representative can take. Requirements can vary based on the transaction and the authority involved.",
  },
  {
    icon: "📋",
    title: "Vehicle Registration and Related Procedures",
    desc: "A vehicle POA can cover selected registration related matters. Depending on the authority granted, the representative may handle specified procedures connected with registration, renewal, number plates, or other vehicle requirements.",
  },
  {
    icon: "🚢",
    title: "Vehicle Export Power of Attorney",
    desc: "Owners may need a vehicle export power of attorney when another person will handle export related procedures. The POA can state the authority given for the intended export. Additional documents may apply based on the vehicle, destination, and authority handling the export.",
  },
]

const includeItems = [
  "Full details of the vehicle owner",
  "Details of the authorised representative",
  "Vehicle make and model",
  "Registration or plate number",
  "Chassis number",
  "Vehicle registration details",
  "Purpose of the POA",
  "Specific powers granted",
  "Any limits placed on those powers",
]

const docsRequired = [
  "Passport of the vehicle owner",
  "Emirates ID, where applicable",
  "Identification document of the representative",
  "Vehicle registration card or Mulkiya",
  "Vehicle details",
  "Supporting documents connected with the transaction",
]

const getSteps = [
  { step: "01", title: "Share the vehicle details", desc: "Provide the vehicle information and explain the transaction or responsibility involved." },
  { step: "02", title: "Submit the required documents", desc: "Share the owner's identification, representative details, and available vehicle documents." },
  { step: "03", title: "Prepare the POA", desc: "The document is drafted around the authority you want to give the representative." },
  { step: "04", title: "Complete notarisation", desc: "The POA goes through the appropriate notarisation process based on the owner's circumstances and intended use." },
  { step: "05", title: "Complete attestation or legalisation", desc: "A POA issued outside the UAE may need authentication in the country of issue, followed by the required UAE formalities." },
  { step: "06", title: "Arrange certified translation", desc: "Translation may be required when the receiving authority needs the document in another language." },
  { step: "07", title: "Complete the vehicle procedure", desc: "Once the required document formalities are complete, the representative can proceed with the permitted vehicle transaction." },
]

const services = [
  "Vehicle POA drafting",
  "Document processing",
  "Notarisation",
  "Attestation",
  "Legalisation",
  "Certified translation",
  "Assistance for owners outside the UAE",
  "Coordination of supporting documents",
  "Pickup and delivery",
]

const stats = [
  { num: "25+", label: "Years of experience" },
  { num: "200+", label: "Professionals" },
  { num: "100+", label: "Countries supported" },
]

const faqs = [
  { q: "Can a Vehicle POA cover more than one vehicle?", a: "The document can be prepared according to the authority being granted. The vehicles covered should be clearly identified where the transaction requires specific vehicle details." },
  { q: "Can I cancel a Vehicle Power of Attorney?", a: "A POA can generally be revoked by the person who granted the authority. The relevant process can depend on how and where the POA was created." },
  { q: "Can a representative use a Vehicle POA for a different purpose?", a: "The representative should act within the authority stated in the POA. A document prepared for one transaction may not provide authority for another matter." },
  { q: "Does a Vehicle POA have to be translated?", a: "Translation requirements depend on the language of the document and the authority receiving it. Certified translation may be required for documents prepared in another language." },
  { q: "Can a Vehicle POA be prepared for an overseas vehicle owner?", a: "Yes. Owners outside the UAE can arrange a POA through the applicable authentication and legalisation process before using it for a UAE vehicle matter." },
]
---

<BaseLayout
  title="Vehicle Power of Attorney in the UAE | Index Office Services"
  description="Need a Vehicle Power of Attorney in the UAE? Index Office Services assists with drafting, notarisation, attestation and certified translation."
>

<style>
  .sec-inner { position: relative; z-index: 1; }
  .in-link { color: #fff; font-weight: 700; text-decoration: underline; text-decoration-color: #38B2AC; text-underline-offset: 3px; transition: color 0.2s; }
  .in-link:hover { color: #38B2AC; }
  .in-link-dark { color: #1A202C; font-weight: 700; text-decoration: underline; text-decoration-color: #38B2AC; text-underline-offset: 3px; transition: color 0.2s; }
  .in-link-dark:hover { color: #38B2AC; }
  .step-card { display: flex; align-items: flex-start; gap: 16px; background: #fff; border: 1px solid #eef0f6; border-radius: 14px; padding: 18px; transition: all 0.25s; }
  .step-card:hover { border-color: #B2F5EA; box-shadow: 0 10px 24px rgba(56,178,172,0.08); }
  .benefit-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px; }
  .poa-type-card { background: #F8FAFF; border: 1px solid #eef0f6; border-radius: 16px; padding: 26px; transition: all 0.25s; }
  .poa-type-card:hover { border-color: #B2F5EA; box-shadow: 0 8px 24px rgba(56,178,172,0.08); }
  .area-chip { display: flex; align-items: center; gap: 12px; background: #fff; border: 1px solid #eef0f6; border-radius: 12px; padding: 14px 16px; font-size: 0.9rem; font-weight: 600; color: #1A202C; line-height: 1.5; transition: all 0.25s; }
  .area-chip:hover { border-color: #B2F5EA; box-shadow: 0 8px 20px rgba(56,178,172,0.08); }
  .faq-item { border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden; }
  .faq-q { width: 100%; background: #fff; border: none; text-align: left; padding: 18px 20px; font-size: 0.9rem; font-weight: 600; color: #1A202C; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .faq-a { padding: 0 20px; max-height: 0; overflow: hidden; transition: max-height 0.35s ease, padding 0.2s; }
  .faq-a.open { max-height: 320px; padding: 0 20px 16px; }
  .faq-icon { font-size: 1.1rem; transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-icon { transform: rotate(45deg); }

  .split-grid { display: grid !important; }
  .three-col { display: grid !important; }
  .two-col { display: grid !important; }
  .four-col { display: grid !important; }

  @media(max-width:768px){
    .hero-title { font-size: 2rem !important; }
    .split-grid { grid-template-columns: 1fr !important; gap: 32px !important; }
    .three-col { grid-template-columns: 1fr !important; }
    .two-col { grid-template-columns: 1fr !important; }
    .four-col { grid-template-columns: 1fr !important; }
    .img-first { order: -1 !important; }
    .hero-btns { flex-direction: column !important; align-items: stretch !important; }
    .hero-btns a { text-align: center; justify-content: center; }
  }
</style>

<!-- ════════════ HERO ════════════ -->
<section style="position:relative;overflow:hidden;min-height:500px;display:flex;align-items:center;">
  <img src="/images/img-16.webp" alt="Vehicle Power of Attorney in the UAE" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%;display:block;" loading="eager" fetchpriority="high" width="1200" height="600" />
  <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(26,32,44,0.92) 0%,rgba(45,55,72,0.80) 100%);"></div>
  <div style="position:absolute;inset:0;background-image:radial-gradient(rgba(56,178,172,0.18) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:880px;margin:0 auto;padding:96px 24px;text-align:center;width:100%;">
    <h1 class="hero-title" style="font-size:clamp(2rem,4vw,3.2rem);font-weight:900;color:#fff;line-height:1.15;margin:0 0 20px;">
      Vehicle Power of Attorney in the UAE | Index Office Services
    </h1>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 20px;max-width:660px;">
      A vehicle power of attorney allows a vehicle owner to authorise another person to handle specific vehicle matters on their behalf. The authority can cover selling, buying, transferring, registering, exporting, or handling other approved vehicle procedures.
    </p>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 20px;max-width:660px;">
      This can be useful when the owner cannot attend a transaction personally. For example, an owner living outside the UAE may appoint someone to complete a vehicle sale or transfer.
    </p>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 20px;max-width:660px;">
      The powers given to the representative should match the intended transaction. Clear wording can also help prevent problems when the document reaches the relevant authority.
    </p>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 32px;max-width:660px;">
      Index Office Services provides complete assistance with motor vehicle power of attorney services. This includes drafting, processing, notarisation, attestation, legalisation, and <a href="https://indexauh.com/legal-translation-in-uae/" class="in-link">certified translation</a>.
    </p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;" class="hero-btns">
      <a href="#get-in-touch" style="display:inline-flex;align-items:center;gap:8px;background:#38B2AC;color:#fff;font-weight:700;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none;box-shadow:0 4px 20px rgba(56,178,172,0.4);">Get Started &rarr;</a>
      <a href="#details" style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.3);color:#fff;font-weight:600;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none;">Learn More</a>
    </div>
  </div>
</section>

<!-- ════ WHEN DO YOU NEED ════ -->
<section id="details" style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner split-grid" style="max-width:1280px;margin:0 auto;grid-template-columns:1.2fr 1fr;gap:52px;align-items:center;">
    <div>
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;display:flex;align-items:center;gap:8px;margin-bottom:12px;">
        <span style="display:inline-block;width:28px;height:1px;background:#2D3748;"></span>Service Overview
      </p>
      <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);font-weight:900;color:#1A202C;line-height:1.2;margin:0 0 18px;">When Do You Need a Vehicle Power of Attorney?</h2>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">
        A vehicle POA can help when another person needs to deal with a vehicle on the owner's behalf.
      </p>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">Common situations include:</p>
      <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:20px;">
        {whenNeeded.map(a => (
          <div class="area-chip" style="background:#F8FAFF;">
            <span style="font-size:1.2rem;flex-shrink:0;">{a.icon}</span>{a.label}
          </div>
        ))}
      </div>
      <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:12px;padding:18px;">
        <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0;">
          The authority should reflect the actual task. A narrowly drafted document can limit the representative's powers to the intended purpose.
        </p>
      </div>
    </div>

    <div>
      <div style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 12px 40px rgba(0,0,0,0.12);">
        <img src="/images/img-11.webp" alt="When do you need a vehicle power of attorney" style="width:100%;height:460px;object-fit:cover;display:block;" loading="lazy" width="800" height="450" />
        <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(26,32,44,0.72) 100%);"></div>
        <div style="position:absolute;bottom:20px;left:20px;right:20px;">
          <p style="color:#fff;font-size:0.9rem;font-weight:800;margin:0 0 4px;">Sell · Buy · Transfer · Export</p>
          <p style="color:#B2F5EA;font-size:0.75rem;margin:0;">Complete vehicle POA process handled end-to-end</p>
        </div>
        <div style="position:absolute;bottom:84px;left:-14px;background:#2D3748;color:#fff;padding:10px 16px;border-radius:10px;font-size:0.75rem;font-weight:700;box-shadow:0 6px 20px rgba(0,0,0,0.2);">
          100+ Countries Covered
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ════ WHAT CAN IT BE USED FOR ════ -->
<section style="background:#F8FAFF;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1280px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:48px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Common Transactions</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">What Can a Vehicle Power of Attorney Be Used For?</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;max-width:700px;margin:0 auto;">
        A power of attorney for vehicle use can cover different vehicle related transactions. The exact powers depend on the owner's instructions and the requirements of the relevant authority.
      </p>
    </div>

    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;" class="three-col">
      {useCases.map(c => (
        <div class="poa-type-card">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
            <span style="font-size:1.5rem;">{c.icon}</span>
            <h3 style="font-size:1rem;font-weight:800;color:#1A202C;margin:0;">{c.title}</h3>
          </div>
          <p style="font-size:0.85rem;color:#6B7280;line-height:1.7;margin:0;">{c.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ════ WHAT SHOULD IT INCLUDE ════ -->
<section style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner split-grid" style="max-width:1200px;margin:0 auto;grid-template-columns:1fr 1.2fr;gap:48px;align-items:center;">
    <div class="img-first" style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,0.1);">
      <img src="/images/img-7.webp" alt="What a vehicle power of attorney should include" style="width:100%;height:520px;object-fit:cover;display:block;" loading="lazy" width="800" height="450" />
      <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(26,32,44,0.7) 100%);"></div>
      <div style="position:absolute;bottom:16px;left:16px;right:16px;">
        <p style="color:#fff;font-size:0.98rem;font-weight:800;margin:0;">Clear Wording, Defined Authority</p>
      </div>
    </div>

    <div>
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Drafting</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">What Should a Vehicle Power of Attorney Include?</h2>
      <p style="color:#4B5563;font-size:0.95rem;line-height:1.8;margin:0 0 16px;">
        The document should provide enough information to identify the parties, the vehicle, and the authority being granted. A vehicle POA may include:
      </p>
      <div style="background:#F8FAFF;border:1px solid #eef0f6;border-radius:16px;padding:24px;margin-bottom:18px;">
        <div style="display:flex;flex-direction:column;gap:10px;">
          {includeItems.map(d => (
            <div style="display:flex;align-items:flex-start;gap:10px;font-size:0.9rem;color:#4B5563;line-height:1.5;">
              <span style="color:#38B2AC;font-weight:bold;flex-shrink:0;margin-top:2px;">→</span>{d}
            </div>
          ))}
        </div>
      </div>
      <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:12px;padding:18px;">
        <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0 0 8px;">
          The wording matters because the representative can only act within the authority granted by the document.
        </p>
        <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0;">
          For example, a POA prepared for a vehicle sale should clearly address the actions required for that sale. A document prepared for export may need different powers.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ════ DOCUMENTS REQUIRED ════ -->
<section style="background:#F0FFFE;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:44px 44px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner split-grid" style="max-width:1280px;margin:0 auto;grid-template-columns:1.2fr 1fr;gap:52px;align-items:center;">
    <div>
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Requirements</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">Documents Required for Vehicle POA in the UAE</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;margin-bottom:16px;">
        The required paperwork depends on the transaction and the circumstances of the vehicle owner. Common documents may include:
      </p>
      <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:20px;">
        {docsRequired.map(item => (
          <div style="display:flex;align-items:flex-start;gap:12px;background:#fff;border:1px solid #eef0f6;border-radius:10px;padding:12px 16px;">
            <span style="color:#38B2AC;font-weight:bold;font-size:1rem;flex-shrink:0;margin-top:2px;">→</span>
            <p style="font-size:0.9rem;color:#374151;line-height:1.6;margin:0;">{item}</p>
          </div>
        ))}
      </div>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">
        An overseas POA may require additional authentication and legalisation before use in the UAE.
      </p>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin:0;">
        Therefore, checking the document requirements at the start can help avoid unnecessary delays. Index Office Services can review the available documents and assist with the formalities needed for the intended use.
      </p>
    </div>

    <div>
      <div style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 12px 40px rgba(0,0,0,0.12);">
        <img src="/images/img-1.webp" alt="Documents required for vehicle power of attorney" style="width:100%;height:460px;object-fit:cover;display:block;" loading="lazy" width="800" height="450" />
        <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(26,32,44,0.72) 100%);"></div>
        <div style="position:absolute;bottom:20px;left:20px;right:20px;">
          <p style="color:#fff;font-size:0.9rem;font-weight:800;margin:0 0 4px;">Have the Right Documents Ready</p>
          <p style="color:#B2F5EA;font-size:0.75rem;margin:0;">Mulkiya, IDs and supporting paperwork</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ════ HOW TO GET ════ -->
<section style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1200px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:40px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Step-by-Step</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">How to Get Power of Attorney for a Vehicle in the UAE?</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;max-width:700px;margin:0 auto;">
        The process starts by identifying the vehicle matter you want another person to handle.
      </p>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:28px;" class="two-col">
      {getSteps.map(s => (
        <div class="step-card">
          <div style="width:42px;height:42px;border-radius:10px;background:#2D3748;color:#38B2AC;font-weight:900;font-size:1rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;">{s.step}</div>
          <div>
            <p style="font-size:1.05rem;font-weight:700;color:#1A202C;margin:0 0 4px;">{s.title}</p>
            <p style="font-size:0.9rem;color:#6B7280;line-height:1.6;margin:0;">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:14px;padding:20px 26px;">
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0;">
        Index Office Services assists throughout the process, from preparing the document to completing the required formalities.
      </p>
    </div>
  </div>
</section>

