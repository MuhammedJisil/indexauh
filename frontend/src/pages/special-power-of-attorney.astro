---
import ContactForm from '../components/ContactForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro'

const whenNeeded = [
  { icon: "🏠", title: "Property transactions", desc: "Authorise a representative to carry out a stated action involving a property." },
  { icon: "🏦", title: "Banking matters", desc: "Allow someone to handle a specified financial transaction or banking requirement." },
  { icon: "💼", title: "Business matters", desc: "Appoint a person to manage a defined company or commercial activity." },
  { icon: "🚗", title: "Vehicle transactions", desc: "Authorise another person to complete a particular vehicle related procedure." },
  { icon: "⚖️", title: "Legal matters", desc: "Assign authority for a specified court or legal proceeding." },
  { icon: "🏛️", title: "Government procedures", desc: "Allow a representative to complete a particular government application or administrative task." },
  { icon: "📈", title: "Shares and commercial licences", desc: "Give authority for a defined share transfer or licensing related transaction." },
]

const includeItems = [
  "Details of the person granting the authority",
  "Identification details of the appointed representative",
  "The reason for appointing the representative",
  "The action the representative is authorised to take",
  "Details of the property, vehicle, company, shares, account, contract, or other relevant subject",
  "Any conditions or restrictions on the authority",
  "A validity period or end date, where applicable",
  "Required signatures and authentication details",
]

const docsRequired = [
  "Passport details of the principal",
  "Emirates ID, where applicable",
  "Identification details of the representative",
  "Documents related to the intended transaction",
  "Property records for real estate matters",
  "Company or commercial records for business transactions",
  "Banking information for specific financial matters",
  "Existing contracts or supporting legal documents",
  "Certified translation, where required",
]

const getSteps = [
  { step: "01", title: "Explain the purpose", desc: "Tell the service provider what the representative needs to handle. The intended transaction helps determine the authority that should appear in the document." },
  { step: "02", title: "Provide the documents", desc: "Submit the identification records and supporting papers connected with the matter." },
  { step: "03", title: "Prepare the POA", desc: "The POA is prepared to reflect the exact powers you want to assign to the representative. Relevant transaction details should appear clearly." },
  { step: "04", title: "Review the details", desc: "Check names, identification information, transaction details, powers, restrictions, and duration before proceeding." },
  { step: "05", title: "Complete notarisation", desc: "The document can move through the applicable notarial or digital process. The UAE Ministry of Justice provides services for preparing and authenticating eligible Special Power of Attorney formats, including digital options." },
  { step: "06", title: "Complete further formalities", desc: "Some POAs may require attestation, legalisation, or certified translation for use with another authority or outside the UAE." },
  { step: "07", title: "Receive the completed document", desc: "Once the required stages are complete, the final document can be returned through the agreed delivery method." },
]

const focusAreas = [
  { icon: "🏠", title: "Property", desc: "A property POA can identify the relevant property and state the action the representative is authorised to undertake. Abu Dhabi Judicial Department has dedicated forms for certain property related powers." },
  { icon: "💼", title: "Business", desc: "A business POA can focus on a defined company activity, commercial licence, or transaction. The authority should match the responsibility assigned to the representative." },
  { icon: "🏦", title: "Banking", desc: "A banking POA can describe the financial action assigned to the representative. The concerned bank may also request its own forms or supporting documents." },
]

const comparisonRows = [
  { special: "Created for specified matters", general: "Provides wider authority" },
  { special: "Focuses on particular tasks", general: "Can cover multiple areas" },
  { special: "May concern one asset or transaction", general: "Can extend across several responsibilities" },
  { special: "Keeps the authority limited to its stated purpose", general: "Gives broader powers to the representative" },
]

const services = [
  "Special Power of Attorney drafting and preparation",
  "Document processing",
  "Notarisation coordination",
  "Attestation",
  "Legalisation",
  "Certified translation",
  "Coordination with relevant authorities",
  "Pickup and delivery where applicable",
]

const stats = [
  { num: "25+", label: "Years of experience" },
  { num: "200+", label: "Professionals" },
  { num: "100+", label: "Countries supported" },
]

const faqs = [
  { q: "Can I change a Special Power of Attorney after it is issued?", a: "A change may call for a new POA or another formal procedure. The appropriate route depends on the document and the authority handling the matter." },
  { q: "Can I appoint more than one person in a Special Power of Attorney?", a: "Multiple representatives may be possible for some arrangements. The permitted setup depends on the relevant transaction and the format accepted by the concerned authority." },
  { q: "Can a Special Power of Attorney be used for a court matter?", a: "Court related matters require a POA that meets the rules of the relevant legal authority. For example, the UAE Ministry of Justice requires a duly authenticated POA for registering a lawyer or agent in a public prosecution case." },
  { q: "Can I cancel a Special Power of Attorney?", a: "Cancellation follows the procedure applicable to the POA. The UAE Ministry of Justice provides a cancellation service for documented contracts and deeds, while the relevant judicial authority may have its own process for cancelling a POA." },
  { q: "Can a Special Power of Attorney be issued digitally?", a: "Yes, selected Special Power of Attorney formats can be issued through UAE Ministry of Justice digital services. Eligible applicants can complete the relevant application electronically and sign using UAE PASS." },
]
---

<BaseLayout
  title="Special Power of Attorney UAE | Index Office Services"
  description="Special Power of Attorney UAE services by Index Office Services. Get 25+ years of support for drafting, notarisation, attestation and legalisation."
>

<style>
  .sec-inner { position: relative; z-index: 1; }
  .in-link { color: #fff; font-weight: 700; text-decoration: underline; text-decoration-color: #38B2AC; text-underline-offset: 3px; transition: color 0.2s; }
  .in-link:hover { color: #38B2AC; }
  .in-link-dark { color: #1A202C; font-weight: 700; text-decoration: underline; text-decoration-color: #38B2AC; text-underline-offset: 3px; transition: color 0.2s; }
  .in-link-dark:hover { color: #38B2AC; }
  .step-card { display: flex; align-items: flex-start; gap: 16px; background: #fff; border: 1px solid #eef0f6; border-radius: 14px; padding: 18px; transition: all 0.25s; }
  .step-card:hover { border-color: #B2F5EA; box-shadow: 0 10px 24px rgba(56,178,172,0.08); }
  .benefit-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px; }
  .poa-type-card { background: #F8FAFF; border: 1px solid #eef0f6; border-radius: 16px; padding: 26px; transition: all 0.25s; }
  .poa-type-card:hover { border-color: #B2F5EA; box-shadow: 0 8px 24px rgba(56,178,172,0.08); }
  .cmp-table { width: 100%; border-collapse: separate; border-spacing: 0; min-width: 520px; }
  .cmp-table th { text-align: left; padding: 16px 20px; font-size: 0.95rem; font-weight: 800; }
  .cmp-table td { padding: 14px 20px; font-size: 0.9rem; color: #4B5563; line-height: 1.6; border-top: 1px solid #eef0f6; }
  .faq-item { border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden; }
  .faq-q { width: 100%; background: #fff; border: none; text-align: left; padding: 18px 20px; font-size: 0.9rem; font-weight: 600; color: #1A202C; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .faq-a { padding: 0 20px; max-height: 0; overflow: hidden; transition: max-height 0.35s ease, padding 0.2s; }
  .faq-a.open { max-height: 320px; padding: 0 20px 16px; }
  .faq-icon { font-size: 1.1rem; transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-icon { transform: rotate(45deg); }

  .split-grid { display: grid !important; }
  .three-col { display: grid !important; }
  .two-col { display: grid !important; }
  .four-col { display: grid !important; }

  @media(max-width:768px){
    .hero-title { font-size: 2rem !important; }
    .split-grid { grid-template-columns: 1fr !important; gap: 32px !important; }
    .three-col { grid-template-columns: 1fr !important; }
    .two-col { grid-template-columns: 1fr !important; }
    .four-col { grid-template-columns: 1fr !important; }
    .img-first { order: -1 !important; }
    .hero-btns { flex-direction: column !important; align-items: stretch !important; }
    .hero-btns a { text-align: center; justify-content: center; }
  }
</style>

<!-- ════════════ HERO ════════════ -->
<section style="position:relative;overflow:hidden;min-height:500px;display:flex;align-items:center;">
  <img src="/images/img-16.webp" alt="Special Power of Attorney in the UAE" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%;display:block;" loading="eager" fetchpriority="high" width="1200" height="600" />
  <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(26,32,44,0.92) 0%,rgba(45,55,72,0.80) 100%);"></div>
  <div style="position:absolute;inset:0;background-image:radial-gradient(rgba(56,178,172,0.18) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:880px;margin:0 auto;padding:96px 24px;text-align:center;width:100%;">
    <h1 class="hero-title" style="font-size:clamp(2rem,4vw,3.2rem);font-weight:900;color:#fff;line-height:1.15;margin:0 0 20px;">
      Special Power of Attorney in the UAE | Index Office Services
    </h1>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 20px;max-width:660px;">
      A Special Power of Attorney lets you appoint someone to handle a clearly identified matter on your behalf. The authority remains limited to the responsibility stated in the document.
    </p>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 20px;max-width:660px;">
      For example, you may appoint someone to manage a property transaction, complete a vehicle procedure, deal with shares, handle a company matter, or carry out another specific activity. The document should explain the action involved and the powers given to the representative.
    </p>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 20px;max-width:660px;">
      Precise wording matters because the receiving authority needs to know the extent of the representative's authority. Abu Dhabi Judicial Department provides specific forms for matters involving individual properties, vehicles, shares, and commercial licences.
    </p>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 32px;max-width:660px;">
      Index Office Services has more than 25 years of experience in document services. Our team assists with Special Power of Attorney drafting, processing, notarisation, attestation, legalisation, and <a href="https://indexauh.com/legal-translation-in-uae/" class="in-link">certified translation</a>.
    </p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;" class="hero-btns">
      <a href="#get-in-touch" style="display:inline-flex;align-items:center;gap:8px;background:#38B2AC;color:#fff;font-weight:700;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none;box-shadow:0 4px 20px rgba(56,178,172,0.4);">Get Started &rarr;</a>
      <a href="#details" style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.3);color:#fff;font-weight:600;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none;">Learn More</a>
    </div>
  </div>
</section>

<!-- ════ WHEN DO YOU NEED ════ -->
<section id="details" style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1280px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:48px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Service Overview</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">When Do You Need a Special Power of Attorney?</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;max-width:700px;margin:0 auto;">
        When a person needs to act for you in one defined matter, a Special Power of Attorney can provide the required authority. Common situations include:
      </p>
    </div>

    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:28px;" class="three-col">
      {whenNeeded.map(w => (
        <div class="poa-type-card">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
            <span style="font-size:1.4rem;">{w.icon}</span>
            <h3 style="font-size:0.95rem;font-weight:800;color:#1A202C;margin:0;">{w.title}</h3>
          </div>
          <p style="font-size:0.85rem;color:#6B7280;line-height:1.6;margin:0;">{w.desc}</p>
        </div>
      ))}
    </div>

    <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:12px;padding:18px 22px;">
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0;">
        The powers should match the responsibility being delegated. Therefore, the document should state the transaction clearly and avoid authority that is unrelated to its intended use.
      </p>
    </div>
  </div>
</section>

<!-- ════ WHAT SHOULD IT INCLUDE ════ -->
<section style="background:#F8FAFF;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner split-grid" style="max-width:1280px;margin:0 auto;grid-template-columns:1.2fr 1fr;gap:52px;align-items:center;">
    <div>
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;display:flex;align-items:center;gap:8px;margin-bottom:12px;">
        <span style="display:inline-block;width:28px;height:1px;background:#2D3748;"></span>Drafting
      </p>
      <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);font-weight:900;color:#1A202C;line-height:1.2;margin:0 0 18px;">What Should a Special Power of Attorney Include?</h2>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">
        A Special Power of Attorney should provide enough information for the representative and the receiving organisation to understand the authority being granted.
      </p>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">Depending on the transaction, the document may contain:</p>
      <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:20px;">
        {includeItems.map(item => (
          <div style="display:flex;align-items:flex-start;gap:12px;background:#fff;border:1px solid #eef0f6;border-radius:10px;padding:12px 16px;">
            <span style="color:#38B2AC;font-weight:bold;font-size:1rem;flex-shrink:0;margin-top:2px;">→</span>
            <p style="font-size:0.9rem;color:#374151;line-height:1.6;margin:0;">{item}</p>
          </div>
        ))}
      </div>
      <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:12px;padding:18px;">
        <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0;">
          The UAE Ministry of Justice provides different POA formats for areas such as real estate, banking, disputes, licensing, and shares.
        </p>
      </div>
    </div>

    <div>
      <div style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 12px 40px rgba(0,0,0,0.12);">
        <img src="/images/img-11.webp" alt="What a special power of attorney should include" style="width:100%;height:460px;object-fit:cover;display:block;" loading="lazy" width="800" height="450" />
        <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(26,32,44,0.72) 100%);"></div>
        <div style="position:absolute;bottom:20px;left:20px;right:20px;">
          <p style="color:#fff;font-size:0.9rem;font-weight:800;margin:0 0 4px;">Defined Authority, Clear Terms</p>
          <p style="color:#B2F5EA;font-size:0.75rem;margin:0;">Drafted around one specific matter</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ════ WHY SPECIFIC WORDING ════ -->
<section style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:900px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:28px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Precision Matters</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0;">Why Does the Wording Need to Be Specific?</h2>
    </div>

    <div style="background:#F8FAFF;border:1px solid #eef0f6;border-radius:16px;padding:28px;">
      <p style="color:#4B5563;font-size:0.95rem;line-height:1.8;margin:0 0 14px;">
        The document should leave little room for confusion about the authority being granted.
      </p>
      <p style="color:#4B5563;font-size:0.95rem;line-height:1.8;margin:0 0 14px;">
        For example, a property related POA can identify the relevant property and state the action the representative may carry out. This gives the receiving authority clear information about the intended transaction.
      </p>
      <p style="color:#4B5563;font-size:0.95rem;line-height:1.8;margin:0;">
        Good drafting also helps separate the powers you want to give from matters that remain outside the representative's authority.
      </p>
    </div>
  </div>
</section>

<!-- ════ DOCUMENTS REQUIRED ════ -->
<section style="background:#F0FFFE;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:44px 44px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner split-grid" style="max-width:1200px;margin:0 auto;grid-template-columns:1fr 1.2fr;gap:48px;align-items:center;">
    <div class="img-first" style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,0.1);">
      <img src="/images/img-7.webp" alt="Documents required for special power of attorney in UAE" style="width:100%;height:520px;object-fit:cover;display:block;" loading="lazy" width="800" height="450" />
      <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(26,32,44,0.7) 100%);"></div>
      <div style="position:absolute;bottom:16px;left:16px;right:16px;">
        <p style="color:#fff;font-size:0.98rem;font-weight:800;margin:0;">Check Requirements Before Finalising</p>
      </div>
    </div>

    <div>
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Requirements</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">Documents Required for a Special Power of Attorney in the UAE</h2>
      <p style="color:#4B5563;font-size:0.95rem;line-height:1.8;margin:0 0 16px;">
        The paperwork depends on the purpose of the POA. The transaction, parties involved, and authority handling the request can all affect the requirements. You may need:
      </p>
      <div style="background:#fff;border:1px solid #eef0f6;border-radius:16px;padding:24px;margin-bottom:18px;">
        <div style="display:flex;flex-direction:column;gap:10px;">
          {docsRequired.map(d => (
            <div style="display:flex;align-items:flex-start;gap:10px;font-size:0.9rem;color:#4B5563;line-height:1.5;">
              <span style="color:#38B2AC;font-weight:bold;flex-shrink:0;margin-top:2px;">→</span>{d}
            </div>
          ))}
        </div>
      </div>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin:0;">
        Additional records may apply to certain transactions. Checking the requirements before finalising the document can help reduce corrections and delays.
      </p>
    </div>
  </div>
</section>

<!-- ════ HOW TO GET ════ -->
<section style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1200px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:40px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Step-by-Step</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">How to Get a Special Power of Attorney in the UAE</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;max-width:700px;margin:0 auto;">
        The process starts with identifying the exact responsibility you want to delegate.
      </p>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:28px;" class="two-col">
      {getSteps.map(s => (
        <div class="step-card">
          <div style="width:42px;height:42px;border-radius:10px;background:#2D3748;color:#38B2AC;font-weight:900;font-size:1rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;">{s.step}</div>
          <div>
            <p style="font-size:1.05rem;font-weight:700;color:#1A202C;margin:0 0 4px;">{s.title}</p>
            <p style="font-size:0.9rem;color:#6B7280;line-height:1.6;margin:0;">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:14px;padding:20px 26px;">
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0;">
        Index Office Services can assist throughout the process, from drafting and processing to notarisation, attestation, legalisation, and certified translation.
      </p>
    </div>
  </div>
</section>

<!-- ════ PROPERTY / BUSINESS / BANKING ════ -->
<section style="background:#F8FAFF;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1200px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:40px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">By Purpose</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">Special Power of Attorney for Property, Business and Banking</h2>
    </div>

    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-bottom:28px;" class="three-col">
      {focusAreas.map(f => (
        <div class="poa-type-card">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
            <span style="font-size:1.5rem;">{f.icon}</span>
