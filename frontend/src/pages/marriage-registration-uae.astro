---
import ContactForm from '../components/ContactForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro'

const stats = [
  { value: "2000", label: "Established, 25+ years of experience" },
  { value: "400,000+", label: "Clients served" },
  { value: "100+", label: "Countries covered" },
  { value: "200+", label: "Attestation professionals" },
]

const whatItsFor = [
  "Your spouse residence visa",
  "Birth registration for your children",
  "Insurance, banking and housing",
  "Any future divorce or inheritance case",
]

const routeFit = [
  { title: "Non Muslim couples", desc: "Can choose civil marriage. Dubai needs one partner with Dubai residence, and both partners must be 21 or older. Marriage registration in Abu Dhabi also welcomes visitors, so destination couples often choose it." },
  { title: "Muslim couples", desc: "Register a court marriage contract. Expect premarital screening, male witnesses and a guardian where the law requires one." },
  { title: "Embassy or consulate", desc: "Some nationalities register at their own embassy or consulate. For example, the Indian Consulate in Dubai asks for three witnesses and a singleness certificate." },
  { title: "Married abroad", desc: "Couples married abroad attest the foreign certificate for UAE use." },
  { title: "Complex cases", desc: "Need extra proof, such as a previous marriage, a guardian abroad or a name mismatch." },
]

const compareCols = ["Dubai civil marriage", "Abu Dhabi civil marriage", "Muslim court marriage", "Embassy registration"]
const compareRows = [
  { point: "Who it suits", vals: ["Couples who are not Muslim", "Non Muslim couples, and some non UAE Muslims", "Muslim couples and UAE nationals", "Citizens of that country"] },
  { point: "Residence", vals: ["One partner lives in Dubai", "Residents and visitors", "At least one partner holds UAE residency", "Often a UAE residence visa"] },
  { point: "Witnesses", vals: ["Check the live service card", "Not needed for the ceremony", "Male witnesses", "Often three witnesses"] },
  { point: "Premarital screening", vals: ["Confirm on the live service card", "Exempt for eligible applicants", "Expected", "Ask the embassy"] },
  { point: "Certificate", vals: ["English", "Bilingual", "Court issued", "Embassy issued"] },
  { point: "Where we help", vals: ["Attested and translated documents", "Document check and attestation", "Translation and Power of Attorney", "Attestation and document check"] },
]

const civilSteps = [
  { num: "01", title: "Dubai: Apply and Consent", desc: "In Dubai, you apply through a Dubai Courts service centre. Both partners then give consent before the authentication judge." },
  { num: "02", title: "Abu Dhabi: Online Application", desc: "In Abu Dhabi, you apply online through the Civil Family Court. The court reviews your file, takes payment and schedules the ceremony." },
  { num: "03", title: "Optional Marriage Agreement", desc: "Abu Dhabi also offers an optional marriage agreement service." },
  { num: "04", title: "Attested and Translated Documents", desc: "Authorities ask for attested and translated documents. Preparing them is where many files stall. Therefore, start with a document check before you apply." },
]

const muslimConditions = [
  "Premarital screening through an approved health provider",
  "A guardian for the bride where the law requires one",
  "Eligible witnesses who attend and sign",
  "Proof that any previous marriage ended",
]

const docsRequired = [
  "Original passports and Emirates IDs, with residence visa copies",
  "Your original marriage certificate for marriages held abroad",
  "Single status or no impediment certificate obtained through your embassy",
  "Divorce certificate or spouse death certificate for a previous marriage",
  "Premarital medical certificate for the Muslim court route",
  "Witness passports and IDs for routes that need witnesses",
  "Venue certificate or hotel letter, for embassy registration after a church, temple or hotel wedding",
  "A Power of Attorney when a representative acts for you",
  "Certified Arabic translation of every foreign document",
  "Home country, embassy and MOFA stamps on foreign documents",
]

const processSteps = [
  { num: "01", title: "Free Document Check", desc: "We review your route, nationality and documents." },
  { num: "02", title: "Route Confirmation", desc: "We check the live rules of the court, embassy or consulate." },
  { num: "03", title: "Home Country Stage", desc: "Our team handles notarisation or apostille formalities as required for your document." },
  { num: "04", title: "Embassy Stage", desc: "We complete embassy attestation for the issuing country." },
  { num: "05", title: "MOFA Stage", desc: "We complete MOFA attestation in the UAE." },
  { num: "06", title: "Translation", desc: "A legal translator prepares your Arabic copy, and we match every name." },
  { num: "07", title: "Submission Support", desc: "We prepare your file, and you attend where the authority requires." },
  { num: "08", title: "Delivery", desc: "We return your documents to your door and update you at each stage." },
]

const afterCert = [
  "Check every name, date and ID number in Arabic and English",
  "Save the digital copy and the verification reference",
  "Order certified copies for visa, school and insurance files",
  "Ask for corrections at once when you find an error",
  "Keep the original unlaminated until all attestations finish",
  "Attest the certificate at MOFA and the destination embassy for use abroad",
]

const countryPoints = [
  "Some countries use an apostille for the first stage.",
  "Others need foreign office attestation and UAE embassy attestation before MOFA.",
  "Document language, validity dates and name formats also differ.",
]

const timeFactors = [
  "Your route and the authority's appointment availability",
  "Document readiness and name accuracy",
  "The number of attestation stages",
  "Translation and any correction rounds",
]

const costFactors = [
  "Authority fees for your route",
  "Embassy and MOFA attestation fees",
  "Certified translation volume",
  "Urgency and doorstep pickup",
]

const mistakes = [
  "Stopping early. A home country stamp alone does not finish the chain.",
  "Using an uncertified translation. Authorities expect certified Arabic.",
  "Mismatched names across passports, IDs and certificates.",
  "Choosing the wrong route, then filing for a service you cannot use.",
  "Expired documents. Many authorities count validity from the issue date.",
  "A weak Power of Attorney that does not cover marriage matters.",
  "Relying on a religious certificate without court or embassy registration.",
  "Skipping the guardian step on the Muslim route.",
  "Assuming an English certificate needs no Arabic translation.",
]

const whyUs = [
  { title: "400,000+ Clients Served", desc: "400,000+ clients served since 2000." },
  { title: "End-to-End Handling", desc: "End to end handling across home country, embassy and MOFA stages." },
  { title: "200+ Professionals", desc: "200+ attestation professionals and dedicated compliance experts." },
  { title: "Real Time Updates", desc: "Real time updates on your file." },
  { title: "Doorstep Pickup & Delivery", desc: "Doorstep document pickup and delivery across the UAE." },
  { title: "Dubai Office", desc: "Dubai office at Conrad Hotel Business Tower, Sheikh Zayed Road." },
  { title: "Abu Dhabi Office", desc: "Abu Dhabi office on Electra Street." },
]

const related = [
  "Divorce certificate attestation for a previous marriage",
  "Death certificate attestation for a widowed applicant",
  "Birth certificate attestation for your children",
  "Apostille service for countries that use apostille",
  "Certificate attestation for all other personal documents",
]

const faqs = [
  { q: "How do I complete marriage registration in Abu Dhabi?", a: "Marriage registration in Abu Dhabi runs through its Civil Family Court as a civil marriage service. The process has an online application, document review, payment and a ceremony. However, files often stall on attested and translated documents or proof of an earlier marriage ending. We check your file first, so your application starts correctly." },
  { q: "Can non Muslims register a civil marriage in the UAE?", a: "Yes. Federal law now allows civil marriage for eligible non Muslims. Dubai needs both partners to be non Muslim and one partner to live in Dubai. The minimum age is 21. Abu Dhabi has its own civil court route. We can confirm the live rules for your case before you apply." },
  { q: "Can tourists register a civil marriage in Abu Dhabi?", a: "Yes, in many cases. Abu Dhabi's civil court route accepts eligible non Muslim visitors as well as residents. Each applicant must meet age, consent and single status rules. Rules can change, so ask us to confirm the live position before you book travel. We can then review your documents." },
  { q: "Does every marriage need premarital screening?", a: "No. Screening applies to the Muslim court route, but civil routes can differ. Abu Dhabi's civil framework exempts eligible applicants from the medical certificate. Therefore, confirm your route before you book any tests. Our team can check the live requirement for you." },
  { q: "Do I need to attest my foreign marriage certificate?", a: "Yes, in most cases. A foreign certificate usually needs attestation in the issuing country, at the UAE embassy and at MOFA. Some countries use an apostille for the first stage. The receiving office decides the exact requirement, so ask us before you start." },
  { q: "Do both partners need to attend in person?", a: "Usually yes. Courts and embassies often ask for both partners, original passports and witnesses on the day. Some services allow an authorised representative with a valid Power of Attorney. We prepare your documents and Power of Attorney, but we cannot replace a required personal appearance." },
]
---

<BaseLayout title="Marriage Registration UAE | 25+ Years of Trust"
description="Marriage registration in the UAE, explained. Get expert document help for civil, Muslim and foreign marriages. Free consultation."
>

<style>
  .sec-inner { position: relative; z-index: 1; }
  .idx-pill { background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.28); color: #fff; font-size: 0.78rem; padding: 5px 14px; border-radius: 9999px; font-weight: 500; white-space: nowrap; }

  .step-card { display:flex; align-items:flex-start; gap:18px; padding:24px; background:#fff; border:1px solid #eef0f6; border-radius:16px; transition:all 0.25s; }
  .step-card:hover { border-color:#B2F5EA; box-shadow:0 12px 32px rgba(56,178,172,0.1); transform:translateY(-3px); }

  .info-card { background:#fff; border:1px solid #eef0f6; border-radius:16px; padding:24px; }
  .info-card h3 { font-size:0.95rem; font-weight:800; color:#1A202C; margin:0 0 14px; border-left:3px solid #38B2AC; padding-left:12px; }
  .info-card .info-intro { font-size:0.85rem; color:#6B7280; line-height:1.6; margin:0 0 12px; }
  .info-list-item { display:flex; align-items:flex-start; gap:10px; font-size:0.9rem; color:#4B5563; margin:0 0 9px; line-height:1.6; }

  .benefit-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px; }
  .stat-card { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.18); border-radius: 14px; padding: 16px 12px; }

  .cmp-wrap { overflow-x:auto; border:1px solid #eef0f6; border-radius:16px; background:#fff; }
  .cmp-table { width:100%; border-collapse:collapse; min-width:760px; font-size:0.88rem; }
  .cmp-table th { background:#2D3748; color:#fff; text-align:left; padding:14px 16px; font-weight:700; font-size:0.82rem; }
  .cmp-table th:first-child { color:#38B2AC; }
  .cmp-table td { padding:13px 16px; color:#4B5563; line-height:1.55; border-top:1px solid #eef0f6; vertical-align:top; }
  .cmp-table td:first-child { font-weight:700; color:#1A202C; background:#F0FFFE; }

  .faq-item { border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden; }
  .faq-q { width: 100%; background: #fff; border: none; text-align: left; padding: 18px 20px; font-size: 0.9rem; font-weight: 600; color: #1A202C; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .faq-a { padding: 0 20px; max-height: 0; overflow: hidden; transition: max-height 0.35s ease, padding 0.2s; }
  .faq-a.open { max-height: 260px; padding: 0 20px 16px; }
  .faq-icon { font-size: 1.1rem; transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-icon { transform: rotate(45deg); }

  @media(max-width:900px){
    .two-col { flex-direction:column !important; grid-template-columns:1fr !important; }
    .two-col > div { width:100% !important; }
    .grid-2 { grid-template-columns:1fr !important; }
    .grid-3 { grid-template-columns:1fr !important; }
    .grid-4 { grid-template-columns:1fr 1fr !important; }
  }
  @media(max-width:640px){
    .steps-grid { grid-template-columns:1fr !important; }
  }
</style>

<!-- ════════════ HERO ════════════ -->
<section style="position:relative;overflow:hidden;min-height:500px;display:flex;align-items:center;">
