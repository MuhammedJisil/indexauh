---
import AdminLayout from '../../layouts/AdminLayout.astro';
const apiUrl = import.meta.env.TRACKING_API_URL || 'http://localhost:3001';
---

<AdminLayout title="Document Types & Steps" currentPage="documents">

<style is:global>
  .doc-layout {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 20px;
    align-items: start;
  }
  .doc-list-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 13px 15px;
    border-radius: 12px;
    cursor: pointer;
    border: 1px solid rgba(255,255,255,0.06);
    transition: all 0.15s;
    margin-bottom: 8px;
    background: rgba(255,255,255,0.02);
  }
  .doc-list-item:hover {
    background: rgba(255,255,255,0.05);
    border-color: rgba(255,255,255,0.12);
  }
  .doc-list-item.selected {
    background: rgba(45,212,191,0.09);
    border-color: rgba(45,212,191,0.35);
    box-shadow: 0 0 0 1px rgba(45,212,191,0.25);
  }
  .doc-list-name { font-size: 0.9rem; font-weight: 700; color: var(--text); }
  .doc-list-meta { font-size: 0.73rem; color: var(--muted); margin-top: 3px; font-weight: 500; }
  
  .step-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid var(--border);
    margin-bottom: 8px;
    background: rgba(255,255,255,0.02);
    transition: background 0.15s;
  }
  .step-row:hover { background: rgba(255,255,255,0.04); }
  .step-order {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(45,212,191,0.15);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.78rem;
    font-weight: 800;
    flex-shrink: 0;
  }
  .step-label { flex: 1; font-size: 0.88rem; font-weight: 600; }
  .no-select { color: var(--muted); text-align: center; padding: 48px 20px; font-size: 0.88rem; line-height: 1.5; }

  @media (max-width: 900px) {
    .doc-layout {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>

<div class="doc-layout">
  <!-- Left: Document Types List -->
  <div class="card">
    <div class="card-header">
      <div>
        <span class="card-title">Document Types</span>
        <p style="font-size:0.75rem;color:var(--muted);margin-top:2px;">Select to view & manage steps</p>
      </div>
      <button class="btn btn-primary btn-sm" id="addDocBtn">+ New Type</button>
    </div>
    <div id="docList"><div class="empty"><span class="loading"></span> Loading types...</div></div>
  </div>

  <!-- Right: Steps for selected document type -->
  <div class="card" id="stepsCard">
    <div class="card-header">
      <div>
        <span class="card-title" id="stepsTitle">Select a Document Type</span>
        <p style="font-size:0.75rem;color:var(--muted);margin-top:2px;" id="stepsSubtitle">Milestone workflow for live tracking</p>
      </div>
      <button class="btn btn-primary btn-sm" id="addStepBtn" style="display:none;">+ Add Step</button>
    </div>
    <div id="stepsList"><div class="no-select">← Select a document type from the list to view or add tracking milestones.</div></div>
  </div>
</div>

<!-- Modal: Create Document Type -->
<div class="modal-overlay" id="docModal">
  <div class="modal-box">
    <div class="modal-header">
      <span class="modal-title">New Document Type</span>
      <button class="modal-close" id="closeDocModal">×</button>
    </div>
    <form id="docForm">
      <div class="form-group">
        <label class="form-label">Document Name</label>
        <input id="docName" class="form-control" type="text" placeholder="e.g. Certificate Attestation" required />
      </div>
      <div class="form-group">
        <label class="form-label">URL Slug <span style="font-size:0.7rem;color:var(--muted);text-transform:none;font-weight:400;">(auto-generated)</span></label>
        <input id="docSlug" class="form-control" type="text" placeholder="certificate-attestation" required pattern="[a-z0-9\-]+" />
      </div>
      <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:20px;">
        <button type="button" class="btn btn-ghost" id="cancelDocModal">Cancel</button>
        <button type="submit" class="btn btn-primary" id="docSaveBtn">Create Document Type</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Add Step -->
<div class="modal-overlay" id="stepModal">
  <div class="modal-box">
    <div class="modal-header">
      <span class="modal-title">Add Milestone Step</span>
      <button class="modal-close" id="closeStepModal">×</button>
    </div>
    <form id="stepForm">
      <div class="form-group">
        <label class="form-label">Step Label</label>
        <input id="stepLabel" class="form-control" type="text" placeholder="e.g. Notary Attestation / MOFA Verification" required />
      </div>
      <div class="form-group">
        <label class="form-label">Step Sequence Order <span style="font-size:0.7rem;color:var(--muted);text-transform:none;font-weight:400;">(1, 2, 3...)</span></label>
        <input id="stepOrder" class="form-control" type="number" min="1" placeholder="1" required />
      </div>
      <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:20px;">
        <button type="button" class="btn btn-ghost" id="cancelStepModal">Cancel</button>
        <button type="submit" class="btn btn-primary" id="stepSaveBtn">Save Step</button>
      </div>
    </form>
  </div>
</div>

<script define:vars={{ API: apiUrl }}>
  let docTypes      = [];
  let selectedDocId = null;

  function renderDocTypes() {
    const el = document.getElementById('docList');
    if (!docTypes.length) {
      el.innerHTML = '<div class="empty">No document types configured yet. Click "+ New Type" to create one.</div>';
      return;
    }
    el.innerHTML = docTypes.map(d => `
      <div class="doc-list-item${selectedDocId === d.id ? ' selected' : ''}" data-id="${d.id}" onclick="selectDocType(${d.id})">
        <div style="min-width:0;flex:1;padding-right:8px;">
          <div class="doc-list-name">${d.name}</div>
          <div class="doc-list-meta">${d.step_count} step${d.step_count !== 1 ? 's' : ''} · ${d.tracking_count} tracking record${d.tracking_count !== 1 ? 's' : ''}</div>
        </div>
        <button class="btn btn-danger btn-sm" onclick="event.stopPropagation();deleteDocType(${d.id},'${d.name.replace(/'/g,"\\'")}')" style="padding:4px 8px;font-size:0.75rem;">Delete</button>
      </div>`).join('');
  }

  async function loadDocTypes() {
    try {
      const res = await window.apiFetch(`${API}/api/admin/document-types`);
      docTypes = await res.json();
      renderDocTypes();
    } catch(e) {
      console.error(e);
      document.getElementById('docList').innerHTML = '<div class="empty" style="color:var(--danger)">Failed to load document types.</div>';
    }
  }

  window.selectDocType = async function(id) {
    selectedDocId = id;
    renderDocTypes();
    const dt = docTypes.find(d => d.id === id);
    document.getElementById('stepsTitle').textContent = dt ? dt.name : 'Steps';
    document.getElementById('stepsSubtitle').textContent = `Manage milestone sequence for ${dt ? dt.name : 'this document'}`;
    document.getElementById('addStepBtn').style.display = '';
    document.getElementById('stepsList').innerHTML = '<div class="empty"><span class="loading"></span> Loading steps...</div>';

    // On mobile, scroll to the steps container
    if (window.innerWidth < 900) {
      document.getElementById('stepsCard')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    try {
      const res   = await window.apiFetch(`${API}/api/admin/document-types/${id}/steps`);
      const steps = await res.json();
      renderSteps(steps);
    } catch(e) {
      console.error(e);
      document.getElementById('stepsList').innerHTML = '<div class="empty" style="color:var(--danger)">Failed to load steps.</div>';
    }
  };

  function renderSteps(steps) {
    const el = document.getElementById('stepsList');
    if (!steps || !steps.length) {
      el.innerHTML = '<div class="empty">No milestone steps added yet. Click "+ Add Step" above to add the first step.</div>';
      return;
    }
    const sorted = [...steps].sort((a,b) => a.order - b.order);
    el.innerHTML = sorted.map(s => `
      <div class="step-row">
        <div class="step-order">${s.order}</div>
        <div class="step-label">${s.label}</div>
        <button class="btn btn-danger btn-sm" onclick="deleteStep(${s.id})" style="padding:4px 8px;font-size:0.75rem;">Remove</button>
      </div>`).join('');
  }

  window.deleteDocType = async function(id, name) {
    if (!confirm(`Are you sure you want to delete "${name}"?\nThis will remove all associated steps.`)) return;
    try {
      const res = await window.apiFetch(`${API}/api/admin/document-types/${id}`, { method:'DELETE' });
      if (res.ok) {
        if (selectedDocId === id) {
          selectedDocId = null;
          document.getElementById('stepsTitle').textContent = 'Select a Document Type';
          document.getElementById('stepsSubtitle').textContent = 'Milestone workflow for live tracking';
          document.getElementById('addStepBtn').style.display = 'none';
          document.getElementById('stepsList').innerHTML = '<div class="no-select">← Select a document type from the list to view or add tracking milestones.</div>';
        }
        window.showToast('Document type removed.', 'ok');
        await loadDocTypes();
      } else {
        const d = await res.json();
        window.showToast(d.error || 'Delete failed.', 'err');
      }
    } catch(e) { window.showToast('Server communication error.', 'err'); }
  };

  window.deleteStep = async function(id) {
    if (!confirm('Remove this step milestone?')) return;
    try {
      const res = await window.apiFetch(`${API}/api/admin/steps/${id}`, { method:'DELETE' });
      if (res.ok) {
        window.showToast('Step removed.', 'ok');
        if (selectedDocId) window.selectDocType(selectedDocId);
      } else {
        const d = await res.json();
        window.showToast(d.error || 'Delete failed.', 'err');
      }
    } catch(e) { window.showToast('Server communication error.', 'err'); }
  };

  // ── Modal Handlers ────────────────────────────────
  const docModal     = document.getElementById('docModal');
  const docForm      = document.getElementById('docForm');
  const docNameInput = document.getElementById('docName');
  const docSlugInput = document.getElementById('docSlug');

  document.getElementById('addDocBtn').onclick = () => {
    docForm.reset();
    docModal.classList.add('open');
    docNameInput.focus();
  };
  document.getElementById('closeDocModal').onclick  = () => docModal.classList.remove('open');
  document.getElementById('cancelDocModal').onclick = () => docModal.classList.remove('open');

  docNameInput.addEventListener('input', () => {
    docSlugInput.value = docNameInput.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  });

  docForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('docSaveBtn');
    btn.disabled = true; btn.textContent = 'Creating...';
    try {
      const res = await window.apiFetch(`${API}/api/admin/document-types`, {
        method: 'POST',
        body: JSON.stringify({ name: docNameInput.value.trim(), slug: docSlugInput.value.trim() }),
      });
      const d = await res.json();
      if (res.ok) {
        window.showToast('Document type created!', 'ok');
        docModal.classList.remove('open');
        docForm.reset();
        await loadDocTypes();
        window.selectDocType(d.id);
      } else {
        window.showToast(d.error || 'Create failed.', 'err');
      }
    } catch(e) { window.showToast('Server communication error.', 'err'); }
    finally { btn.disabled = false; btn.textContent = 'Create Document Type'; }
  });

  const stepModal      = document.getElementById('stepModal');
  const stepForm       = document.getElementById('stepForm');
  const stepLabelInput = document.getElementById('stepLabel');
  const stepOrderInput = document.getElementById('stepOrder');

  document.getElementById('addStepBtn').onclick = () => {
    stepForm.reset();
    const existingCount = document.querySelectorAll('.step-row').length;
    stepOrderInput.value = existingCount + 1;
    stepModal.classList.add('open');
    stepLabelInput.focus();
  };
  document.getElementById('closeStepModal').onclick  = () => stepModal.classList.remove('open');
  document.getElementById('cancelStepModal').onclick = () => stepModal.classList.remove('open');

  stepForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!selectedDocId) return;
    const btn = document.getElementById('stepSaveBtn');
    btn.disabled = true; btn.textContent = 'Saving...';
    try {
      const res = await window.apiFetch(`${API}/api/admin/document-types/${selectedDocId}/steps`, {
        method: 'POST',
        body: JSON.stringify({ label: stepLabelInput.value.trim(), order: parseInt(stepOrderInput.value) }),
      });
      const d = await res.json();
      if (res.ok) {
        window.showToast('Milestone step added!', 'ok');
        stepModal.classList.remove('open');
        stepForm.reset();
        window.selectDocType(selectedDocId);
      } else {
        window.showToast(d.error || 'Add step failed.', 'err');
      }
    } catch(e) { window.showToast('Server communication error.', 'err'); }
    finally { btn.disabled = false; btn.textContent = 'Save Step'; }
  });

  [docModal, stepModal].forEach(m => {
    m.addEventListener('click', (e) => { if (e.target === m) m.classList.remove('open'); });
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadDocTypes);
  } else {
    loadDocTypes();
  }
</script>

</AdminLayout>
