---
import ContactForm from '../components/ContactForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro'

const atAGlance = [
  "A Financial POA authorizes someone to manage your money and property in the UAE.",
  "Attestation makes the document legally valid for banks, courts, and government departments.",
  "Cost depends on where the document originates and how many verification steps it needs.",
  "UAE-issued documents usually process within days. Documents prepared abroad take longer.",
  "Index Office Services handles the full process, from drafting to final attestation.",
]

const whenNeeded = [
  { icon: "✈️", label: "Living or working outside the UAE for extended periods" },
  { icon: "🏠", label: "Managing property or investments while abroad" },
  { icon: "🏥", label: "Recovering from illness or injury" },
  { icon: "💼", label: "Running a business that needs daily financial decisions" },
  { icon: "🛡️", label: "Planning ahead for unexpected emergencies" },
]

const covers = [
  "Operating bank accounts",
  "Paying bills and financial obligations",
  "Managing investments",
  "Handling insurance matters",
  "Collecting payments on your behalf",
]

const doesNotCover = [
  "Selling property, unless stated explicitly",
  "Making healthcare decisions",
  "Transferring company shares",
  "Acting after your death",
]

const typePairs = [
  { title: "General vs Special", icon: "⚖️", desc: "A General POA covers broad matters, including financial ones. A Special POA limits the agent to specific financial tasks, such as managing one bank account or paying a fixed set of bills. Most people choose a Special POA for financial matters. It keeps the agent's authority focused and reduces risk." },
  { title: "Durable vs Non-durable", icon: "🔒", desc: "A Durable POA stays valid even after the principal becomes incapacitated. A Non-durable POA ends automatically the moment that happens. UAE law does not define durability as clearly as some other countries do. Acceptance depends heavily on how the document is drafted and which authority reviews it. Clear, specific wording matters more than the label on the document." },
]

const outsideSteps = [
  { step: "01", title: "Notary Public", desc: "Sign the document before a Notary Public in the issuing country." },
  { step: "02", title: "Home Ministry of Foreign Affairs", desc: "Get it authenticated by that country's Ministry of Foreign Affairs." },
  { step: "03", title: "UAE Embassy or Consulate", desc: "Have the UAE Embassy or Consulate legalize the document." },
  { step: "04", title: "UAE Ministry of Foreign Affairs", desc: "Submit it for final attestation at the UAE Ministry of Foreign Affairs." },
  { step: "05", title: "Legal Translation", desc: "Translate it into Arabic through a legal translator approved by the UAE Ministry of Justice." },
]

const insideSteps = [
  { step: "01", title: "Draft the document", desc: "Draft the document for its intended purpose." },
  { step: "02", title: "Notarization", desc: "Complete notarization through Dubai Courts, the Abu Dhabi Judicial Department, or an approved e-Notary platform." },
  { step: "03", title: "MOFA attestation", desc: "Add MOFA attestation only if the document will be used outside the UAE." },
]

const stageConfirms = [
  { icon: "🪪", label: "Notarization confirms your identity and consent" },
  { icon: "🏛️", label: "Foreign Ministry attestation confirms the notary's authority" },
  { icon: "🏢", label: "Embassy legalization confirms the document passed through the correct channel" },
  { icon: "✅", label: "UAE MOFA attestation gives it final legal recognition inside the country" },
]

const docsIndividual = [
  "Original passport and a copy",
  "Emirates ID, for UAE residents",
  "Passport copy of your chosen agent",
  "Draft Financial POA with clearly stated powers",
  "Bank account details, needed when the POA covers banking matters",
]

const docsCompany = [
  "Valid trade licence",
  "Memorandum of Association",
  "Board Resolution authorizing the POA",
  "Passport and Emirates ID of the signatory",
  "Company stamp, where required",
]

const docsAbroad = [
  "Notary certification from the country of origin",
  "Home country Ministry of Foreign Affairs attestation",
  "UAE Embassy or Consulate attestation",
  "Certified Arabic translation",
]

const costFactors = [
  "Where the document was drafted, inside the UAE or abroad",
  "How many attestation stages it needs to pass through",
  "Whether legal translation is required",
  "The complexity of the drafting itself",
]

const safeguards = [
  { icon: "🎯", title: "Keep the scope narrow", desc: "Grant only the specific powers your agent actually needs. Broad wording opens the door to tasks you never intended to allow." },
  { icon: "🏦", title: "Inform your bank directly", desc: "Tell them about the POA and its limits. Banks can flag unusual activity faster when they already know what your agent is authorized to do." },
  { icon: "📋", title: "Add a reporting requirement", desc: "Ask your agent to report transactions to a third party you trust, such as a family member or accountant. Regular reporting catches problems early." },
  { icon: "🔄", title: "Remember it is not permanent", desc: "You can revoke a Financial POA at any time through the same legal channel that issued it. Revocation needs to follow proper legal steps to count as official." },
  { icon: "⚠️", title: "Watch for warning signs", desc: "An agent who resists sharing account information, pushes for broader authority, or avoids questions about spending deserves closer attention." },
]

const rejectionReasons = [
  "Name mismatches between the passport and the POA document",
  "Expired passports or Emirates IDs",
  "Missing embassy or MOFA stamps",
  "Incorrect or incomplete Arabic translation",
  "Vague wording that fails to state specific financial powers",
  "Outdated document formats no longer accepted by authorities",
  "Missing bank account details when the POA covers banking matters",
]

const trustPoints = [
  "We have handled attestation work across 100+ countries since 2000.",
  "Our team includes 200+ attestation professionals who work with government offices daily.",
  "Thousands of clients have completed their Financial POA process through us, from individuals to large corporations.",
  "Two physical offices, one in Dubai and one in Abu Dhabi, give you a real place to walk in and ask questions.",
  "We explain every step in plain language before we start any work.",
]

const faqs = [
  { q: "Can my agent sell my property using a Financial POA?", a: "Only when the document states that power directly. A Financial POA generally covers money matters like accounts and bills, not property sales, unless you add that authority specifically." },
  { q: "Can I cancel a Financial POA after it is issued?", a: "Yes. Revocation happens through the same legal channel that issued the original document. Once revoked, the POA no longer carries legal authority." },
  { q: "Does a Financial POA expire automatically?", a: "Some do, some do not. Expiry depends on how the document is drafted. A POA tied to a specific task or time period ends automatically once that condition is met." },
  { q: "What happens if my bank rejects my Financial POA?", a: "This usually happens due to vague wording or a missing stamp. Our team reviews the document, identifies the exact issue, and corrects it before resubmission." },
  { q: "How do I know my documents are handled securely?", a: "Every document you share with us stays confidential. We use it only for the purpose you authorized and never pass it to third parties beyond what attestation requires." },
  { q: "Can I appoint more than one agent in a single Financial POA?", a: "Yes. The document should state clearly how your agents must act, separately or together, on every decision." },
]
---

<BaseLayout
  title="Financial Power of Attorney Attestation UAE | Index Office Services"
  description="Need a Financial Power of Attorney attested in the UAE? Index Office Services offers 25+ years of experience with drafting, notarization and attestation."
>

<style>
  .sec-inner { position: relative; z-index: 1; }
  .in-link { color: #fff; font-weight: 700; text-decoration: underline; text-decoration-color: #38B2AC; text-underline-offset: 3px; transition: color 0.2s; }
  .in-link:hover { color: #38B2AC; }
  .in-link-dark { color: #1A202C; font-weight: 700; text-decoration: underline; text-decoration-color: #38B2AC; text-underline-offset: 3px; transition: color 0.2s; }
  .in-link-dark:hover { color: #38B2AC; }
  .step-card { display: flex; align-items: flex-start; gap: 16px; background: #fff; border: 1px solid #eef0f6; border-radius: 14px; padding: 18px; transition: all 0.25s; }
  .step-card:hover { border-color: #B2F5EA; box-shadow: 0 10px 24px rgba(56,178,172,0.08); }
  .benefit-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px; }
  .poa-type-card { background: #F8FAFF; border: 1px solid #eef0f6; border-radius: 16px; padding: 26px; transition: all 0.25s; }
  .poa-type-card:hover { border-color: #B2F5EA; box-shadow: 0 8px 24px rgba(56,178,172,0.08); }
  .area-chip { display: flex; align-items: center; gap: 12px; background: #fff; border: 1px solid #eef0f6; border-radius: 12px; padding: 14px 16px; font-size: 0.9rem; font-weight: 600; color: #1A202C; line-height: 1.5; transition: all 0.25s; }
  .area-chip:hover { border-color: #B2F5EA; box-shadow: 0 8px 20px rgba(56,178,172,0.08); }
  .faq-item { border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden; }
  .faq-q { width: 100%; background: #fff; border: none; text-align: left; padding: 18px 20px; font-size: 0.9rem; font-weight: 600; color: #1A202C; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .faq-a { padding: 0 20px; max-height: 0; overflow: hidden; transition: max-height 0.35s ease, padding 0.2s; }
  .faq-a.open { max-height: 320px; padding: 0 20px 16px; }
  .faq-icon { font-size: 1.1rem; transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-icon { transform: rotate(45deg); }

  .split-grid { display: grid !important; }
  .three-col { display: grid !important; }
  .two-col { display: grid !important; }
  .four-col { display: grid !important; }

  @media(max-width:768px){
    .hero-title { font-size: 2rem !important; }
    .split-grid { grid-template-columns: 1fr !important; gap: 32px !important; }
    .three-col { grid-template-columns: 1fr !important; }
    .two-col { grid-template-columns: 1fr !important; }
    .four-col { grid-template-columns: 1fr !important; }
    .img-first { order: -1 !important; }
    .hero-btns { flex-direction: column !important; align-items: stretch !important; }
    .hero-btns a { text-align: center; justify-content: center; }
  }
</style>

<!-- ════════════ HERO ════════════ -->
<section style="position:relative;overflow:hidden;min-height:500px;display:flex;align-items:center;">
  <img src="/images/img-16.webp" alt="Financial Power of Attorney Attestation in the UAE" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%;display:block;" loading="eager" fetchpriority="high" width="1200" height="600" />
  <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(26,32,44,0.92) 0%,rgba(45,55,72,0.80) 100%);"></div>
  <div style="position:absolute;inset:0;background-image:radial-gradient(rgba(56,178,172,0.18) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:880px;margin:0 auto;padding:96px 24px;text-align:center;width:100%;">
    <h1 class="hero-title" style="font-size:clamp(2rem,4vw,3.2rem);font-weight:900;color:#fff;line-height:1.15;margin:0 0 20px;">
      Financial Power of Attorney Attestation in the UAE
    </h1>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 20px;max-width:660px;">
      A Financial Power of Attorney lets a person you trust handle your money matters when you cannot do it yourself. This could mean managing your bank account, paying bills, or handling investments in the UAE. The person who grants this authority is the principal. The person who receives it is the agent.
    </p>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 20px;max-width:660px;">
      UAE law treats this document seriously. Federal Law No. 5 of 1985 on Civil Transactions and Federal Law No. 4 of 2013 on the Notary Public Profession set the rules for how a POA gets created and accepted. Skip a step in this process and banks, courts, or government offices may reject your document.
    </p>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 32px;max-width:660px;">
      Index Office Services has handled Financial POA attestation for over 25 years. Our team has worked across 100+ countries and supports clients from two offices, one in Dubai and one in Abu Dhabi. We know the exact requirements because we have processed thousands of these cases already.
    </p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;" class="hero-btns">
      <a href="#get-in-touch" style="display:inline-flex;align-items:center;gap:8px;background:#38B2AC;color:#fff;font-weight:700;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none;box-shadow:0 4px 20px rgba(56,178,172,0.4);">Get Started &rarr;</a>
      <a href="#details" style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.3);color:#fff;font-weight:600;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none;">Learn More</a>
    </div>
  </div>
</section>

<!-- ════ AT A GLANCE ════ -->
<section id="details" style="background:#fff;padding:56px 24px;position:relative;overflow:hidden;">
  <div class="sec-inner" style="max-width:1100px;margin:0 auto;">
    <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:18px;padding:34px 38px;">
      <h2 style="font-size:1.1rem;font-weight:900;color:#1A202C;margin:0 0 18px;display:flex;align-items:center;gap:10px;">
        <span style="font-size:1.3rem;">⚡</span>At a Glance
      </h2>
      <div style="display:flex;flex-direction:column;gap:10px;">
        {atAGlance.map(item => (
          <div style="display:flex;align-items:flex-start;gap:12px;">
            <span style="color:#38B2AC;font-weight:bold;font-size:1rem;flex-shrink:0;margin-top:2px;">✓</span>
            <p style="font-size:0.9rem;color:#374151;line-height:1.6;margin:0;">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ════ WHY DO YOU NEED ════ -->
<section style="background:#F8FAFF;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner split-grid" style="max-width:1280px;margin:0 auto;grid-template-columns:1.2fr 1fr;gap:52px;align-items:center;">
    <div>
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;display:flex;align-items:center;gap:8px;margin-bottom:12px;">
        <span style="display:inline-block;width:28px;height:1px;background:#2D3748;"></span>Service Overview
      </p>
      <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);font-weight:900;color:#1A202C;line-height:1.2;margin:0 0 18px;">Why Do You Need a Financial Power of Attorney?</h2>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">
        Life does not always let you stay in one place. Business trips, family emergencies, and long-term travel can pull you away right when a bill needs paying or a bank transaction needs your signature.
      </p>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">
        A Financial POA solves this problem directly. Your chosen agent steps in and keeps your finances moving. Nobody waits weeks for your signature. No payment deadline gets missed because you were unreachable.
      </p>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">
        Illness or injury creates a similar gap. Sudden incapacity can freeze your accounts unless someone already holds legal authority to act for you. Without this document, your family may need to approach a court for guardianship. That process takes time, costs money, and becomes part of the public record.
      </p>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">
        Business owners face this risk too. For example, a company director stuck abroad still needs someone to sign cheques, approve payments, or handle vendor contracts. A properly attested Financial POA keeps operations running without interruption.
      </p>
    </div>

    <div>
      <div style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 12px 40px rgba(0,0,0,0.12);">
        <img src="/images/img-11.webp" alt="Why you need a financial power of attorney" style="width:100%;height:460px;object-fit:cover;display:block;" loading="lazy" width="800" height="450" />
        <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(26,32,44,0.72) 100%);"></div>
        <div style="position:absolute;bottom:20px;left:20px;right:20px;">
          <p style="color:#fff;font-size:0.9rem;font-weight:800;margin:0 0 4px;">Keep Your Finances Moving</p>
          <p style="color:#B2F5EA;font-size:0.75rem;margin:0;">No missed deadlines, no waiting for a signature</p>
        </div>
        <div style="position:absolute;bottom:84px;left:-14px;background:#2D3748;color:#fff;padding:10px 16px;border-radius:10px;font-size:0.75rem;font-weight:700;box-shadow:0 6px 20px rgba(0,0,0,0.2);">
          25+ Years of Experience
        </div>
      </div>
    </div>
  </div>

  <div class="sec-inner" style="max-width:1280px;margin:52px auto 0;">
    <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">Here is when people usually need one:</p>
    <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-bottom:24px;" class="four-col">
      {whenNeeded.map(w => (
        <div class="area-chip" style="flex-direction:column;text-align:center;gap:8px;">
          <span style="font-size:1.6rem;">{w.icon}</span>
          <span style="font-size:0.82rem;">{w.label}</span>
        </div>
      ))}
    </div>
    <div style="background:#fff;border:1px solid #B2F5EA;border-radius:12px;padding:18px 22px;">
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0;">
        Getting this document ready before a crisis hits saves stress later. Rushing through the process during an emergency rarely ends well.
      </p>
    </div>
  </div>
</section>

<!-- ════ TYPES ════ -->
<section style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1200px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:40px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Choosing the Right Format</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">Types of Financial Power of Attorney</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;max-width:750px;margin:0 auto;">
        Not every POA works the same way. UAE authorities recognize different formats depending on how much authority you want to give and how long that authority should last.
      </p>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:32px;" class="two-col">
      {typePairs.map(t => (
        <div class="poa-type-card">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
            <span style="font-size:1.5rem;">{t.icon}</span>
            <h3 style="font-size:1.05rem;font-weight:800;color:#1A202C;margin:0;">{t.title}</h3>
          </div>
          <p style="font-size:0.87rem;color:#6B7280;line-height:1.75;margin:0;">{t.desc}</p>
        </div>
      ))}
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:24px;" class="two-col">
      <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:16px;padding:26px;">
        <h3 style="font-size:1rem;font-weight:800;color:#1A202C;margin:0 0 12px;">What a Financial POA typically covers</h3>
        <div style="display:flex;flex-direction:column;gap:8px;">
          {covers.map(d => (
            <div style="display:flex;align-items:flex-start;gap:8px;font-size:0.9rem;color:#4B5563;line-height:1.5;">
              <span style="color:#38B2AC;font-weight:bold;flex-shrink:0;margin-top:2px;">✓</span>{d}
            </div>
          ))}
        </div>
      </div>
      <div style="background:#F8FAFF;border:1px solid #eef0f6;border-radius:16px;padding:26px;">
        <h3 style="font-size:1rem;font-weight:800;color:#1A202C;margin:0 0 12px;">What it usually does not cover</h3>
        <div style="display:flex;flex-direction:column;gap:8px;">
          {doesNotCover.map(d => (
            <div style="display:flex;align-items:flex-start;gap:8px;font-size:0.9rem;color:#4B5563;line-height:1.5;">
              <span style="color:#94A3B8;font-weight:bold;flex-shrink:0;margin-top:2px;">✕</span>{d}
            </div>
          ))}
        </div>
      </div>
    </div>

    <div style="background:#fff;border:1px solid #eef0f6;border-radius:12px;padding:18px 22px;">
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0;">
        Choosing the right type from the start prevents rejection later. Vague documents cause more delays than any other single issue.
      </p>
    </div>
  </div>
</section>

<!-- ════ HOW ATTESTATION WORKS ════ -->
<section style="background:#F0FFFE;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:44px 44px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1200px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:40px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Step-by-Step</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">How the Attestation Process Works?</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;max-width:750px;margin:0 auto;">
        The process depends on where you drafted your POA. A document prepared inside the UAE follows a shorter path. A document prepared abroad needs extra verification.
      </p>
    </div>

    <h3 style="font-size:1rem;font-weight:800;color:#1A202C;margin:0 0 16px;">Financial POA drafted outside the UAE</h3>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:32px;" class="two-col">
      {outsideSteps.map(s => (
        <div class="step-card">
          <div style="width:42px;height:42px;border-radius:10px;background:#2D3748;color:#38B2AC;font-weight:900;font-size:1rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;">{s.step}</div>
          <div>
            <p style="font-size:1.05rem;font-weight:700;color:#1A202C;margin:0 0 4px;">{s.title}</p>
            <p style="font-size:0.9rem;color:#6B7280;line-height:1.6;margin:0;">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <h3 style="font-size:1rem;font-weight:800;color:#1A202C;margin:0 0 16px;">Financial POA drafted inside the UAE</h3>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:32px;" class="two-col">
      {insideSteps.map(s => (
        <div class="step-card">
          <div style="width:42px;height:42px;border-radius:10px;background:#2D3748;color:#38B2AC;font-weight:900;font-size:1rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;">{s.step}</div>
          <div>
