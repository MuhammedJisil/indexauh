<!-- ════ SCRIPTS ════ -->
<script>
(function(){
  const tabBtns = document.querySelectorAll('.mofa-tab-btn');
  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const target = btn.dataset.tab;
      ['outside','inside'].forEach(id => {
        const el = document.getElementById('mofa-' + id);
        if(el) el.style.display = id === target ? 'block' : 'none';
      });
    });
  });

  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-q')?.addEventListener('click', () => {
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(x => {
        x.classList.remove('open');
        x.querySelector('.faq-a').classList.remove('open');
      });
      if (!isOpen) {
        item.classList.add('open');
        item.querySelector('.faq-a').classList.add('open');
      }
    });
  });
})();
</script>

