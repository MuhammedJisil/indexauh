---
import ContactForm from '../components/ContactForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro'

const linkStyle = "color:#1A202C;font-weight:700;text-decoration:underline;text-decoration-color:#38B2AC;text-underline-offset:3px;"

const trustPills = ["Since 2000", "25+ Years Experience", "400,000+ Clients Served", "100+ Countries Covered", "200+ Attestation Professionals", "Doorstep Pickup and Delivery"]

const otherNames = [
  "MOFA attestation and MOFA UAE attestation",
  "MOFAIC attestation, named after the ministry's longer title",
  "Ministry of Foreign Affairs attestation",
  "Foreign affairs attestation",
  "The MOFA attestation stamp, shown as a paper stamp or a digital attestation page with a QR code or reference number"
]

const whoNeeds = [
  { who: "New hires", what: "degrees and employment documents tied to a work visa." },
  { who: "Spouses", what: "marriage certificates in a family visa file." },
  { who: "Parents", what: "birth certificates when sponsoring a child." },
  { who: "Students", what: "degrees used in study or equivalency requests." },
  { who: "HR and PRO managers", what: "staff visa files." },
  { who: "Businesses", what: "trade licences, contracts and company papers." },
  { who: "Residents", what: "UAE documents they plan to use abroad." }
]

const mofaBasics = [
  "The original must be written in Arabic or English. Documents in any other language must come with a certified legal translation.",
  "Earlier attestation by the competent authorities, where it applies",
  "No lamination, because MOFA rejects laminated documents"
]

const digitalDocs = [
  "A genuine digital PDF that carries a scannable code, a barcode, a verification link or a reference number",
  "The issuing body must be a recognised UAE authority, and the document must fall under a category MOFA accepts",
  "Scans and photos do not count as originals"
]

const checklist = [
  "Original in hand and unlaminated",
  "Translation ready for other languages",
  "Earlier attestations complete",
  "Names and dates match across every document",
  "Destination country known, for UAE documents going abroad",
  "UAE PASS ready for individual applications",
  "Extra papers your sponsor, school or embassy requested"
]

const featuredDocs = [
  {
    title: "MOFA attestation degree certificate",
    desc: "Employers, universities and visa offices often ask for attested degrees. Before MOFA will look at a degree from abroad, it has to be stamped by the education or government bodies of the awarding country and by that country's UAE embassy or consulate. UAE degrees start with the issuing authority.",
    link: "/degree-certificate-attestation/", linkText: "See our degree certificate attestation page"
  },
  {
    title: "MOFA attestation of marriage certificate",
    desc: "Family visa files usually need it. Foreign certificates follow the full chain. UAE certificates start with the issuing authority.",
    link: "/marriage-certificate-attestation-in-the-uae/", linkText: "Read about marriage certificate attestation"
  },
  {
    title: "MOFA attestation for birth certificate",
    desc: "Child sponsorship and school admission often depend on it. The Ministry of Health and Prevention, or the local health authority, attests UAE birth certificates first.",
    link: "/birth-certificate-attestation-in-uae/", linkText: "Explore birth certificate attestation"
  }
]

const documentTypes = [
  {
    title: "Educational documents",
    desc: "Used for employment, higher education, professional licensing and visa purposes.",
    items: [
      { t: "Diploma certificate attestation", href: "/diploma-certificate-attestation/" },
      { t: "Mark sheets and transcripts attestation", href: "/educational-certificate-attestation-in-dubai/" },
      { t: "School leaving certificate attestation", href: "/transfer-certificate-attestation/" },
      { t: "Equivalency certificate", href: "/equivalency-certificate/" },
      { t: "Experience certificate attestation", href: "/experience-certificate-attestation/" },
      { t: "Professional qualification certificate attestation" }
    ],
    extra: ""
  },
  {
    title: "Personal documents",
    desc: "Used for identity, family relationships and civil status, including family visa, spouse sponsorship and dependent visa files.",
    items: [
      { t: "Divorce certificate attestation", href: "/divorce-certificate-attestation/" },
      { t: "Death certificate attestation", href: "/death-certificate-attestation/" },
      { t: "Medical certificate attestation", href: "/medical-certificate-attestation/" },
      { t: "Police clearance certificate (PCC) attestation", href: "/police-clearance-certificate/" },
      { t: "Power of attorney attestation", href: "/power-of-attorney-notarization/" }
    ],
    extra: ""
  },
  {
    title: "Commercial documents",
    desc: "Used for business operations, trade licensing, bank approvals and legal transactions.",
    items: [
      { t: "Memorandum of Association (MOA) attestation", href: "https://indexauh.com/memorandum-of-association/" },
      { t: "Articles of Association (AOA) attestation" },
      { t: "Commercial licence attestation" },
      { t: "Commercial invoice attestation" },
      { t: "Board resolution attestation" },
      { t: "Company agreement attestation" },
      { t: "Corporate power of attorney", href: "/corporate-power-of-attorney/" }
    ],
    extra: `See also our <a href='/business-setup-in-the-uae/' style='${linkStyle}'>business setup in the UAE</a> service.`
  },
  {
    title: "Documents in other languages",
    desc: "Documents that are not in Arabic or English need legal translation before attestation.",
    items: [],
    extra: ""
  }
]

const outsideUAESteps = [
  { step: "01", title: "Issuing country", desc: "The competent authority attests the document." },
  { step: "02", title: "Foreign ministry", desc: "That country's Ministry of Foreign Affairs attests it." },
  { step: "03", title: "UAE Embassy or Consulate", desc: "The mission in that country completes its embassy attestation. Some missions use digital attestation, and the original is still required." },
  { step: "04", title: "MOFA in the UAE", desc: "The final attestation happens online, and the original travels by courier." }
]

const insideUAESteps = [
  { step: "01", title: "Issuing entity", desc: "The government body attests first. For example, the Ministry of Health and Prevention attests birth certificates." },
  { step: "02", title: "MOFA", desc: "Eligible digital documents use digital attestation. Other documents use the courier route." },
  { step: "03", title: "Embassy stage", desc: "Depending on where the document will be used, an additional stamp may be needed, either from the UAE Embassy in that destination country or from that country's embassy located in the UAE." }
]

const digitalRoute = [
  "Suited to qualifying digital documents issued within the UAE and intended for use in another country",
  "MOFA lists examples such as MOHAP birth and death certificates",
  "We retrieve the attested file from the MOFA account and deliver it to you"
]

const courierRoute = [
  "Used when a document is not eligible for digital attestation",
  "We arrange an approved courier for collection and delivery"
]

const timeFactors = ["Country of issue and its route", "Digital or courier route", "Document type, personal or commercial", "Completion of earlier attestations", "Errors or mismatched details", "Courier option you select"]

const feeFactors = ["Number of documents", "Attestation option, with or without the embassy step", "Personal or commercial category", "Translation and earlier stage costs", "Government fee changes over time"]

const stageView = [
  { step: "01", title: "Review", desc: "Our team checks every original." },
  { step: "02", title: "Authority", desc: "The home country or UAE entity attests." },
  { step: "03", title: "Embassy", desc: "This stage applies only when needed." },
  { step: "04", title: "MOFA", desc: "We file, pay and track the application." },
  { step: "05", title: "Delivery", desc: "The document returns to your door." }
]

const mistakes = [
  "Details that do not match the document",
  "A scan, photo or altered copy instead of the original",
  "The wrong issuing authority or document type",
  "Lamination",
  "Missing earlier attestations",
  "An eligible digital document sent through the courier route",
  "A missing certified translation",
  "No check on the destination country's embassy step",
  "Leaving everything to the last minute"
]

const whyChooseUs = [
  "Established in 2000, with 25+ years of experience.",
  "400,000+ clients served across the UAE.",
  "100+ countries covered, with home country, embassy and MOFA stages handled in order through our full certificate attestation service.",
  "200+ attestation professionals on our team.",
  "Dedicated compliance experts check every file.",
  "Real time process updates keep you informed.",
  "Doorstep pickup and delivery across the UAE."
]

const faqs = [
  { q: "How long does MOFA attestation take?", a: "Time depends on the route. Digital attestation suits eligible UAE digital documents. Courier based attestation depends on the courier you select. Documents from abroad also need earlier stages. Check the live MOFA page for current times, or contact us for an estimate for your case." },
  { q: "How much does MOFA attestation cost?", a: "Your final MOFA fee is shaped by how many documents you submit, which attestation service you choose and whether the papers are personal or commercial. MOFA shows the total before you pay. Translation and earlier stages add separate costs. Fees change over time. Therefore, contact us for a quote based on your exact documents." },
  { q: "Is MOFA attestation the same as apostille?", a: `No. An apostille is a Hague Convention certificate between member countries. The HCCH status table, updated on 30 June 2026, does not list the UAE as a party. Therefore, an apostille alone does not replace the UAE chain. Rules can change, so we confirm your route first. See our <a href='/apostille-service-uae/' style='${linkStyle}'>apostille service</a> for documents from member countries.` },
  { q: "Is MOFA attestation needed for a degree?", a: "Usually yes. Employers, universities and visa offices commonly ask for an attested degree. MOFA treats the certificate and transcript as two documents. A qualification awarded overseas is first validated by the education and foreign affairs authorities of that country, then by the UAE's diplomatic mission there, and MOFA comes last in the chain. UAE degrees start with the issuing authority. Requirements vary by purpose, so tell us your use." }
]
---

<BaseLayout title="MOFA Attestation in UAE | Trusted Since 2000"
description="MOFA attestation made simple. 25+ years of experience, 100+ countries, doorstep pickup and delivery across the UAE. Get a free quote today."
>

<style>
  .sec-inner { position: relative; z-index: 1; }

  /* pills */
  .idx-pill { background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.28); color: #fff; font-size: 0.78rem; padding: 5px 14px; border-radius: 9999px; font-weight: 500; white-space: nowrap; }

  /* form */
  .idx-form input, .idx-form select, .idx-form textarea { width: 100%; border: 1px solid #e5e7eb; border-radius: 10px; padding: 11px 14px; font-size: 0.85rem; color: #374151; outline: none; font-family: inherit; background: #fff; box-sizing: border-box; }
  .idx-form input:focus, .idx-form select:focus, .idx-form textarea:focus { border-color: #38B2AC; box-shadow: 0 0 0 3px rgba(56,178,172,0.15); }
  .idx-form textarea { resize: none; }
  .idx-submit { width: 100%; background: #2D3748; color: #fff; font-weight: 700; padding: 13px; border-radius: 10px; border: none; cursor: pointer; font-size: 0.95rem; letter-spacing: 0.04em; transition: background 0.2s; }
  .idx-submit:hover { background: #1A202C; }

  /* document type card */
  .doc-type-card { background: #fff; border: 1px solid #eef0f6; border-radius: 16px; padding: 24px; transition: all 0.25s; }
  .doc-type-card:hover { border-color: #B2F5EA; box-shadow: 0 12px 32px rgba(56,178,172,0.06); transform: translateY(-3px); }

  /* steps cards */
  .step-card { display: flex; align-items: flex-start; gap: 18px; padding: 20px; background: #fff; border: 1px solid #eef0f6; border-radius: 14px; transition: all 0.25s; }
  .step-card:hover { border-color: #B2F5EA; box-shadow: 0 10px 24px rgba(56,178,172,0.08); }

  /* list items */
  .check-item { display: flex; align-items: flex-start; gap: 10px; padding: 12px 16px; background: #fff; border: 1px solid #e0e7ef; border-radius: 10px; font-size: 0.85rem; color: #1A202C; font-weight: 500; }

  /* FAQ */
  .faq-item { border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden; }
  .faq-q { width: 100%; background: #fff; border: none; text-align: left; padding: 18px 20px; font-size: 0.9rem; font-weight: 600; color: #1A202C; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .faq-a { padding: 0 20px; max-height: 0; overflow: hidden; transition: max-height 0.35s ease, padding 0.2s; }
  .faq-a.open { max-height: 500px; padding: 0 20px 16px; }
  .faq-icon { font-size: 1.1rem; transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-icon { transform: rotate(45deg); }

  /* mofa tabs */
  .mofa-tab-btn { padding: 10px 22px; border-radius: 9999px; font-size: 0.85rem; font-weight: 600; cursor: pointer; border: none; transition: all 0.2s; }
  .mofa-tab-btn.active { background: #2D3748; color: #fff; }
  .mofa-tab-btn:not(.active) { background: #F0FFFE; color: #2D3748; border: 1px solid #B2F5EA; }

  .idx-btn { display: inline-flex; align-items: center; gap: 8px; background: #38B2AC; color: #fff; font-weight: 700; font-size: 0.9rem; padding: 13px 28px; border-radius: 9999px; text-decoration: none; box-shadow: 0 4px 20px rgba(56,178,172,0.4); }
  .idx-btn-ghost { display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.3); color: #fff; font-weight: 600; font-size: 0.9rem; padding: 13px 28px; border-radius: 9999px; text-decoration: none; }

  @media(max-width:768px){
    .about-hero-title { font-size: 2rem !important; }
    .about-hero-desc { font-size: 0.88rem !important; }
    .split-grid { grid-template-columns: 1fr !important; gap: 32px !important; }
    .benefits-grid { grid-template-columns: 1fr !important; }
    .offices-flex { flex-direction: column !important; }
    .step-sticky { position: static !important; }
    .doctype-grid { grid-template-columns: 1fr !important; }
  }
</style>

<!-- ════════════ HERO ════════════ -->
<section style="position:relative;overflow:hidden;min-height:480px;display:flex;align-items:center;">
  <img src="/images/img-16.webp" alt="MOFA Attestation in UAE" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;display:block;" loading="eager" fetchpriority="high" width="1200" height="600" />
  <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(26,32,44,0.88) 0%,rgba(45,55,72,0.82) 100%);"></div>
  <div style="position:absolute;inset:0;background-image:radial-gradient(rgba(56,178,172,0.18) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:860px;margin:0 auto;padding:96px 24px;text-align:center;width:100%;">
    <div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:18px;">
      {trustPills.map(p => <span class="idx-pill">{p}</span>)}
    </div>
    <h1 class="about-hero-title" style="font-size:clamp(2rem,4vw,3.2rem);font-weight:900;color:#fff;line-height:1.15;margin:0 0 20px;">MOFA Attestation in UAE</h1>
    <p class="about-hero-desc" style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 32px;max-width:700px;">
      The UAE Ministry of Foreign Affairs gives your paperwork its last official review through MOFA attestation. This step verifies that the stamps and signatures on each document are authentic. One wrong stamp can delay your visa by weeks. We prepare your file, manage every stage and deliver it back, so authorities can accept it.
    </p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
      <a href="https://wa.me/971525245208" class="idx-btn">WhatsApp Us Now</a>
      <a href="#get-in-touch" class="idx-btn-ghost">Get a Free Quote</a>
    </div>
  </div>
</section>

<!-- ════ OVERVIEW ════ -->
<section id="details" style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner split-grid" style="max-width:1280px;margin:0 auto;display:grid;grid-template-columns:1.2fr 1fr;gap:52px;align-items:start;">
    <div>
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;display:flex;align-items:center;gap:8px;margin-bottom:12px;">
        <span style="display:inline-block;width:28px;height:1px;background:#2D3748;"></span>Service Overview
      </p>
      <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);font-weight:900;color:#1A202C;line-height:1.2;margin:0 0 18px;">MOFA Attestation in UAE</h2>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">
        The UAE Ministry of Foreign Affairs gives your paperwork its last official review through MOFA attestation. This step verifies that the stamps and signatures on each document are authentic.
      </p>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">
        One wrong stamp can delay your visa by weeks. We prepare your file, manage every stage and deliver it back, so authorities can accept it.
      </p>

      <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:12px;padding:18px;margin-top:8px;">
        <h3 style="color:#1A202C;font-size:0.95rem;font-weight:700;margin:0 0 10px;">Same step, different names</h3>
        <div style="display:flex;flex-direction:column;gap:8px;">
          {otherNames.map(n => (
            <div style="display:flex;align-items:flex-start;gap:8px;font-size:0.88rem;color:#4B5563;line-height:1.6;">
              <span style="color:#38B2AC;font-weight:bold;flex-shrink:0;">•</span> {n}
            </div>
          ))}
        </div>
      </div>
    </div>

    <div style="display:flex;flex-direction:column;gap:24px;">
      <div style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 12px 40px rgba(0,0,0,0.12);">
        <img src="/images/img-16.webp" alt="UAE MOFA attestation documents" style="width:100%;height:340px;object-fit:cover;" loading="lazy" width="800" height="450" />
        <div style="position:absolute;bottom:20px;left:-16px;background:#2D3748;color:#fff;padding:12px 18px;border-radius:12px;font-size:0.9rem;font-weight:700;box-shadow:0 6px 20px rgba(0,0,0,0.2);">
          Since 2000 | 25+ Years Experience
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ════ WHO NEEDS IT ════ -->
<section style="background:#F8FAFF;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1280px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:44px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Who It's For</p>
      <h2 style="font-size:2.2rem;font-weight:900;color:#1A202C;margin:0 0 10px;">Who needs MOFA attestation and when?</h2>
      <p style="color:#6B7280;font-size:1.05rem;max-width:620px;margin:0 auto;">Authorities usually ask for MOFA attestation in these cases:</p>
    </div>

    <div class="doctype-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:28px;">
      {whoNeeds.map(w => (
        <div class="doc-type-card">
          <h3 style="font-size:1.05rem;font-weight:800;color:#1A202C;margin:0 0 8px;border-left:3px solid #38B2AC;padding-left:12px;">{w.who}</h3>
          <p style="font-size:0.88rem;color:#4B5563;line-height:1.6;margin:0;">Need it for {w.what}</p>
        </div>
      ))}
    </div>

    <div style="max-width:820px;margin:0 auto;background:#F0FFFE;border:1px solid #B2F5EA;border-radius:12px;padding:18px;">
      <h3 style="color:#1A202C;font-size:0.95rem;font-weight:700;margin:0 0 6px;">Good to know</h3>
      <p style="color:#4B5563;font-size:0.95rem;line-height:1.75;margin:0;">MOFA confirms that anyone can apply on behalf of the document owner. Therefore, you can hand the whole file to our team.</p>
    </div>
  </div>
</section>

<!-- ════ REQUIRED DOCUMENTS ════ -->
<section style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1280px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:44px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Requirements</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 10px;">What are the MOFA attestation required documents?</h2>
      <p style="color:#4B5563;font-size:1rem;max-width:620px;margin:0 auto;line-height:1.6;">MOFA sets three basic conditions. Your employer, school or embassy may add more.</p>
    </div>

    <div class="split-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:52px;">
      <div>
        <h3 style="font-size:1.3rem;font-weight:900;color:#1A202C;margin:0 0 14px;">MOFA basics</h3>
        <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:28px;">
          {mofaBasics.map(b => (
            <div class="check-item">
              <span style="width:20px;height:20px;border-radius:50%;background:#38B2AC;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" width="10" height="10"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
              <p style="margin:0;line-height:1.6;">{b}</p>
            </div>
          ))}
        </div>

        <h3 style="font-size:1.3rem;font-weight:900;color:#1A202C;margin:0 0 14px;">For UAE issued digital documents</h3>
        <div style="display:flex;flex-direction:column;gap:10px;">
          {digitalDocs.map(b => (
            <div class="check-item">
              <span style="width:20px;height:20px;border-radius:50%;background:#2D3748;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" width="10" height="10"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
              <p style="margin:0;line-height:1.6;">{b}</p>
            </div>
          ))}
        </div>
      </div>

      <div>
        <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:16px;padding:28px;">
          <h3 style="font-size:1.3rem;font-weight:900;color:#1A202C;margin:0 0 16px;">Checklist before you submit</h3>
          <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:22px;">
            {checklist.map(c => (
              <div style="display:flex;align-items:flex-start;gap:10px;font-size:0.95rem;color:#4B5563;background:#fff;border:1px solid #e2e8f0;padding:10px 12px;border-radius:6px;line-height:1.5;">
                <span style="color:#38B2AC;font-weight:bold;">☐</span> {c}
              </div>
            ))}
          </div>
          <a href="#get-in-touch" class="idx-btn">View Required Documents with Our Team</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ════ WHICH DOCUMENTS ════ -->
<section style="background:#F8FAFF;padding:76px 24px;position:relative;overflow:hidden;">
