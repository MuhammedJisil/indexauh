---
import ContactForm from '../components/ContactForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro'

const stats = [
  "25+ Years of Experience",
  "400,000+ Clients Served",
  "100+ Countries Covered",
  "200+ Attestation Professionals",
]

const whoNeeds = [
  { icon: "💼", title: "Employees", desc: "Starting a job or changing employer, with degree or experience certificates" },
  { icon: "👪", title: "Families", desc: "Applying for spouse or child visas, with a Nikah Nama, birth certificate, or Form B" },
  { icon: "🎓", title: "Students", desc: "Applying to UAE universities, with degrees and transcripts" },
  { icon: "🩺", title: "Doctors and Engineers", desc: "Registering their licences" },
  { icon: "🏢", title: "Business Owners", desc: "Signing a Power of Attorney, MOA, or AOA" },
]

const docGroups = [
  { icon: "📄", title: "Every application", items: [
    "Original certificate",
    "Passport copy of the holder",
    "CNIC copy",
    "UAE visa or Emirates ID copy",
  ]},
  { icon: "🎓", title: "Degrees (HEC attestation)", items: [
    "Original degree and mark sheets",
    "Photographs and valid contact details for HEC",
    "PMDC copy for doctors, or PEC copy for engineers",
  ]},
  { icon: "📘", title: "Matric, Intermediate, and diplomas (IBCC attestation)", items: [
    "Original certificate and transcript",
  ]},
  { icon: "💍", title: "Marriage certificate", items: [
    "Original Nikah Nama and the NADRA computerized certificate",
    "English translation, where required",
    "ID and passport copies of both spouses",
  ]},
  { icon: "👶", title: "Birth certificate and Form B", items: [
    "NADRA issued original",
    "Parents’ passport and visa copies",
    "Child’s passport copy",
  ]},
  { icon: "⚖️", title: "Power of Attorney and commercial papers", items: [
    "Stamp paper with notary attestation and magistrate attestation",
    "A physical MOFA visit, since MOFA handles legal documents through walk in service",
  ]},
]

const steps = [
  { step: "01", title: "Free document check", desc: "You share your documents, and we confirm the route." },
  { step: "02", title: "Doorstep pickup", desc: "We collect your originals anywhere in the UAE." },
  { step: "03", title: "Issuing body, HEC, or IBCC attestation", desc: "The board, university, or department verifies the document. HEC handles degrees, and IBCC handles Matric and Intermediate." },
  { step: "04", title: "MOFA Pakistan attestation", desc: "MOFA in Islamabad or a liaison office checks and stamps the earlier attestation." },
  { step: "05", title: "UAE Embassy attestation in Islamabad", desc: "The embassy legalizes the document for UAE use." },
  { step: "06", title: "UAE MOFA attestation", desc: "The final attestation makes the document valid across the UAE." },
  { step: "07", title: "Delivery", desc: "We return your documents to your door and share updates throughout." },
]

const timeFactors = [
  "Document type and issuing body",
  "Regular or express service, where available",
  "Document condition and completeness",
  "Workload at MOFA and the embassy",
  "Physical visits, which legal documents need",
]

const costFactors = [
  "Government fee at each stage",
  "Number and type of documents",
  "Service speed",
  "Courier and handling needs",
]

const rejections = [
  "Name spelling that differs from the passport",
  "Old HEC or IBCC attestation that needs refreshing",
  "Photocopies sent in place of originals",
  "Stages completed out of order",
  "Missing Nikah Nama copy on education files of married women",
]

const checks = [
  "Names match the passport on every page",
  "Dates and numbers match across documents",
  "Originals are clean, with no damage",
  "The stage order fits your document type",
]

const benefits = [
  { title: "Since 2000", desc: "Established in 2000, with 25+ years of attestation experience" },
  { title: "400,000+ Clients", desc: "400,000+ clients served across 100+ countries" },
  { title: "200+ Professionals", desc: "200+ attestation professionals, with dedicated compliance experts who check every file" },
  { title: "End to End Handling", desc: "End to end handling across the home country, embassy, and MOFA stages" },
  { title: "Real Time Updates", desc: "Real time updates, so you never chase for status" },
  { title: "Doorstep Pickup and Delivery", desc: "Doorstep pickup and delivery across the UAE" },
  { title: "Our Offices", desc: "Offices in Dubai (Sheikh Zayed Road, Conrad Hotel Business Tower) and Abu Dhabi (Electra Street)" },
  { title: "Phone and WhatsApp Support", desc: "Phone and WhatsApp support on (+971) 529 300 200" },
]

const faqs = [
  { q: "Can another person submit my documents for attestation?", a: "Yes. A family member, employer, or agency can submit on your behalf. In that case, authorities may ask for an authorization letter. A copy of your passport or Emirates ID may also be needed. We confirm the exact papers during your document check." },
  { q: "Can laminated or damaged Pakistani certificates be attested?", a: "Usually not. Authorities expect certificates in their original, unaltered state. Therefore, the issuing body may need to remove lamination or reissue the document. Plan for this before you apply, because it adds time. Contact us and we explain the options for your certificate." },
  { q: "Does apostille replace UAE embassy attestation for Pakistani documents?", a: "Not automatically. Pakistan joined the Hague Apostille Convention, and MOFA now issues apostilles. However, UAE use depends on your document and the receiving authority. Therefore, we confirm the correct route before we start, so you avoid a wasted stage. For details, see our apostille service." },
  { q: "Is the process different for free zone and mainland use?", a: "The attestation stages stay the same for both. Your purpose decides which documents you need. For example, a visa application, a job contract, and a trade licence ask for different papers. Tell us your goal, and we list the right documents." },
  { q: "Do I need to travel to Pakistan?", a: "No. You hand over your originals in the UAE. We then manage the Pakistan stages, the embassy, and UAE MOFA. Meanwhile, you follow progress on our document tracking page. Therefore, you keep working while the process runs." },
  { q: "How can I check that my attested document is genuine?", a: "UAE MOFA offers an online verification page. Enter the attestation reference number and the issue date to confirm validity. You can open it at verify.mofa.gov.ae. Keep a scan of every stamped page, so you can answer any query quickly. Check the reference number on delivery." },
]
---

<BaseLayout
  title="Pakistan Certificate Attestation UAE | 25+ Years Trusted"
  description="Get your Pakistan certificate attestation done end to end, with doorstep pickup and live updates. Check your documents with our experts today."
>

<style>
  .sec-inner { position: relative; z-index: 1; }
  .idx-pill { background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.28); color: #fff; font-size: 0.78rem; padding: 5px 14px; border-radius: 9999px; font-weight: 500; white-space: nowrap; }
  .purpose-card { background: #fff; border: 1px solid #eef0f6; border-radius: 14px; padding: 22px; transition: all 0.25s; }
  .purpose-card:hover { border-color: #B2F5EA; box-shadow: 0 12px 32px rgba(56,178,172,0.08); transform: translateY(-3px); }
  .step-card { display: flex; align-items: flex-start; gap: 16px; background: #fff; border: 1px solid #eef0f6; border-radius: 14px; padding: 18px; transition: all 0.25s; }
  .step-card:hover { border-color: #B2F5EA; box-shadow: 0 10px 24px rgba(56,178,172,0.08); }
  .benefit-card { border-radius: 14px; padding: 22px; }
  .faq-item { border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden; }
  .faq-q { width: 100%; background: #fff; border: none; text-align: left; padding: 18px 20px; font-size: 0.9rem; font-weight: 600; color: #1A202C; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .faq-a { padding: 0 20px; max-height: 0; overflow: hidden; transition: max-height 0.35s ease, padding 0.2s; }
  .faq-a.open { max-height: 420px; padding: 0 20px 16px; }
  .faq-icon { font-size: 1.1rem; transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-icon { transform: rotate(45deg); }
  .btn-primary { display:inline-flex;align-items:center;gap:8px;background:#38B2AC;color:#fff;font-weight:700;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none;box-shadow:0 4px 20px rgba(56,178,172,0.4); }
  .btn-ghost { display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.3);color:#fff;font-weight:600;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none; }
  .btn-dark { display:inline-flex;align-items:center;gap:8px;background:#2D3748;color:#fff;font-weight:700;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none; }
  .btn-outline { display:inline-flex;align-items:center;gap:8px;background:#fff;border:1px solid #2D3748;color:#2D3748;font-weight:600;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none; }
  @media(max-width:768px){
    .hero-title { font-size: 2rem !important; }
    .split-grid { grid-template-columns: 1fr !important; gap: 32px !important; }
    .three-col { grid-template-columns: 1fr !important; }
  }
</style>

<!-- ════════════ HERO ════════════ -->
<section style="position:relative;overflow:hidden;min-height:500px;display:flex;align-items:center;">
  <img src="/images/img-9.webp" alt="Pakistan Certificate Attestation in the UAE" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%;display:block;" loading="eager" fetchpriority="high" width="1200" height="600" />
  <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(26,32,44,0.92) 0%,rgba(45,55,72,0.80) 100%);"></div>
  <div style="position:absolute;inset:0;background-image:radial-gradient(rgba(56,178,172,0.18) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:880px;margin:0 auto;padding:96px 24px;text-align:center;width:100%;">
    <div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:18px;">
      {stats.map(s => <span class="idx-pill">✔ {s}</span>)}
    </div>
    <h1 class="hero-title" style="font-size:clamp(2rem,4vw,3.2rem);font-weight:900;color:#fff;line-height:1.15;margin:0 0 20px;">Pakistan Certificate Attestation in the UAE</h1>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 32px;max-width:700px;">
      One wrong stamp can delay your visa by weeks. Pakistan certificate attestation is the official chain of stamps that makes your Pakistani documents valid in the UAE. First, the issuing body or HEC verifies your document. Next, Pakistan MOFA and the UAE Embassy in Islamabad attest it. Finally, UAE MOFA completes the process. Since 2000, Index Office Services has managed every stage for you. As a result, you focus on your plans, not queues. Start with a free document check.
    </p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
      <a href="#get-in-touch" class="btn-primary">Get a Free Quote</a>
      <a href="tel:+971529300200" class="btn-ghost">Call (+971) 529 300 200</a>
    </div>
  </div>
</section>

<!-- ════ WHO NEEDS ════ -->
<section style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner split-grid" style="max-width:1280px;margin:0 auto;display:grid;grid-template-columns:0.9fr 1.4fr;gap:48px;align-items:center;">
    <div style="border-radius:20px;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,0.1);">
      <img src="/images/pakistan-flag.webp" alt="Pakistan flag - Pakistan certificate attestation" style="width:100%;height:420px;object-fit:cover;display:block;" loading="lazy" width="800" height="450" />
    </div>
    <div>
      <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);font-weight:900;color:#1A202C;line-height:1.2;margin:0 0 14px;">Who Needs Pakistan Certificate Attestation, and When?</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;margin-bottom:24px;">
        You need Pakistani certificate attestation before UAE authorities act on your document. Typical cases include:
      </p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-bottom:20px;">
        {whoNeeds.map(p => (
          <div class="purpose-card">
            <div style="font-size:1.6rem;margin-bottom:10px;">{p.icon}</div>
            <h3 style="font-size:1.05rem;font-weight:800;color:#1A202C;margin:0 0 6px;">{p.title}</h3>
            <p style="font-size:0.85rem;color:#4B5563;line-height:1.55;margin:0;">{p.desc}</p>
          </div>
        ))}
      </div>
      <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:12px;padding:16px;">
        <p style="color:#1A202C;font-size:1rem;font-weight:700;margin:0;">Start early. Every stage adds time.</p>
      </div>
    </div>
  </div>
</section>

<!-- ════ DOCUMENTS ════ -->
<section style="background:#F8FAFF;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1280px;margin:0 auto;">
    <div style="max-width:760px;margin-bottom:40px;">
      <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);font-weight:900;color:#1A202C;margin:0 0 14px;">Which Documents Do You Need?</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;margin:0;">Requirements change by document type. Use this list as a starting point.</p>
    </div>
    <div class="three-col" style="display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:28px;">
      {docGroups.map(g => (
        <div class="purpose-card">
          <div style="font-size:1.6rem;margin-bottom:10px;">{g.icon}</div>
          <h3 style="font-size:1rem;font-weight:800;color:#1A202C;margin:0 0 12px;border-left:3px solid #38B2AC;padding-left:12px;">{g.title}</h3>
          <div style="display:flex;flex-direction:column;gap:8px;">
            {g.items.map(i => (
              <div style="display:flex;align-items:flex-start;gap:10px;font-size:0.9rem;color:#4B5563;line-height:1.5;">
                <span style="color:#38B2AC;font-weight:bold;flex-shrink:0;">✓</span>{i}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:12px;padding:18px;">
      <p style="color:#1A202C;font-size:1rem;font-weight:600;margin:0;">Rules change, so we check the current list for your case during your free document check.</p>
    </div>
  </div>
</section>

<!-- ════ PROCESS ════ -->
<section style="background:#F0FFFE;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:44px 44px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1200px;margin:0 auto;">
    <div style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,0.1);margin-bottom:44px;">
      <img src="/images/img-7.webp" alt="Pakistan certificate attestation process" style="width:100%;height:220px;object-fit:cover;object-position:center 35%;display:block;" loading="lazy" width="800" height="450" />
      <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(26,32,44,0.88) 0%,rgba(26,32,44,0.5) 55%,transparent 100%);"></div>
      <div style="position:absolute;top:50%;left:40px;transform:translateY(-50%);">
        <h2 style="color:#fff;font-size:clamp(1.4rem,2.5vw,2rem);font-weight:900;margin:0;max-width:520px;line-height:1.25;">How Does Our Pakistan Certificate Attestation Process Work?</h2>
      </div>
    </div>

    <div style="display:flex;flex-direction:column;gap:14px;max-width:860px;margin:0 auto 32px;">
      {steps.map(s => (
        <div class="step-card">
          <div style="width:42px;height:42px;border-radius:10px;background:#2D3748;color:#38B2AC;font-weight:900;font-size:1rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;">{s.step}</div>
          <div>
            <p style="font-size:1.05rem;font-weight:700;color:#1A202C;margin:0 0 4px;">{s.title}</p>
            <p style="font-size:0.9rem;color:#6B7280;line-height:1.6;margin:0;">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
      <a href="#get-in-touch" class="btn-dark">Check My Documents</a>
      <a href="#get-in-touch" class="btn-outline">Request a Call Back</a>
    </div>
  </div>
</section>

<!-- ════ TIME & COST ════ -->
<section style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1100px;margin:0 auto;">
    <div style="max-width:820px;margin-bottom:36px;">
      <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);font-weight:900;color:#1A202C;margin:0 0 14px;">How Long Does It Take, and What Affects the Cost?</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;margin:0;">
        As a guide, Pakistan certificate attestation often takes about 1 to 2 weeks. That is roughly 5 to 10 working days. However, this is an approximate range, not a promise. Your timeline depends on several factors.
      </p>
    </div>
    <div class="split-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:28px;">
      <div style="background:#fff;border:1px solid #B2F5EA;border-radius:16px;padding:24px;">
        <h3 style="font-size:0.95rem;font-weight:800;color:#1A202C;margin:0 0 14px;border-left:3px solid #38B2AC;padding-left:12px;">Time depends on:</h3>
        <div style="display:flex;flex-direction:column;gap:9px;">
          {timeFactors.map(f => (
            <div style="display:flex;align-items:center;gap:10px;font-size:0.98rem;color:#4B5563;">
              <span style="color:#38B2AC;font-weight:bold;flex-shrink:0;">→</span>{f}
            </div>
          ))}
        </div>
      </div>
      <div style="background:#2D3748;border-radius:16px;padding:24px;">
        <h3 style="font-size:0.95rem;font-weight:800;color:#fff;margin:0 0 14px;border-left:3px solid #38B2AC;padding-left:12px;">Cost depends on:</h3>
        <div style="display:flex;flex-direction:column;gap:9px;">
          {costFactors.map(f => (
            <div style="display:flex;align-items:center;gap:10px;font-size:0.98rem;color:#B2F5EA;">
              <span style="color:#38B2AC;font-weight:bold;flex-shrink:0;">✓</span>{f}
            </div>
          ))}
        </div>
      </div>
    </div>
    <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:12px;padding:18px;">
      <p style="color:#4B5563;font-size:1rem;line-height:1.75;margin:0;">Your free document check gives a realistic estimate for your case. Contact us for a quote based on your documents.</p>
    </div>
  </div>
</section>

<!-- ════ REJECTION / DELAY ════ -->
<section style="background:#F8FAFF;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner split-grid" style="max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start;">
    <div>
      <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);font-weight:900;color:#1A202C;margin:0 0 14px;">What Causes Rejection or Delay?</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;margin-bottom:20px;">Small errors cost the most time. These appear often:</p>
      <div style="display:flex;flex-direction:column;gap:10px;">
        {rejections.map(r => (
          <div style="display:flex;align-items:flex-start;gap:10px;background:#fff;border:1px solid #eef0f6;border-radius:12px;padding:14px 16px;font-size:0.95rem;color:#4B5563;line-height:1.5;">
            <span style="color:#38B2AC;font-weight:bold;flex-shrink:0;">→</span>{r}
          </div>
        ))}
      </div>
    </div>
    <div>
      <div style="background:#2D3748;border-radius:16px;padding:28px;margin-bottom:20px;">
        <h3 style="font-size:1.05rem;font-weight:800;color:#fff;margin:0 0 10px;border-left:3px solid #38B2AC;padding-left:12px;">Our pre submission check.</h3>
        <p style="color:#B2F5EA;font-size:0.95rem;line-height:1.7;margin:0 0 16px;">We run four checks before we submit anything:</p>
        <div style="display:flex;flex-direction:column;gap:10px;">
          {checks.map(c => (
            <div style="display:flex;align-items:center;gap:10px;font-size:0.98rem;color:#B2F5EA;">
              <span style="color:#38B2AC;font-weight:bold;flex-shrink:0;">✓</span>{c}
            </div>
          ))}
        </div>
      </div>
      <div style="border-radius:16px;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,0.1);">
        <img src="/images/img-11.webp" alt="Pakistan certificate attestation checks" style="width:100%;height:240px;object-fit:cover;display:block;" loading="lazy" width="800" height="450" />
      </div>
    </div>
  </div>
</section>

<!-- ════ WHY CHOOSE ════ -->
<section style="background:#1A202C;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:radial-gradient(rgba(56,178,172,0.18) 1.5px,transparent 1.5px);background-size:28px 28px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1280px;margin:0 auto;">
    <div class="split-grid" style="display:grid;grid-template-columns:1fr 1.4fr;gap:48px;align-items:center;margin-bottom:48px;">
      <div style="border-radius:20px;overflow:hidden;box-shadow:0 16px 48px rgba(0,0,0,0.3);">
        <img src="/images/img-3.webp" alt="Index Office Services" style="width:100%;height:300px;object-fit:cover;display:block;" loading="lazy" width="800" height="450" />
      </div>
      <div>
        <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);font-weight:900;color:#fff;line-height:1.2;margin:0 0 16px;">Why Choose Index Office Services?</h2>
