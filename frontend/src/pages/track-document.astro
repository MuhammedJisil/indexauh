---
import BaseLayout from '../layouts/BaseLayout.astro';
const trackingApiUrl = import.meta.env.TRACKING_API_URL || 'http://localhost:3001';
---

<BaseLayout
  title="Track Your Document | Index Office Services"
  description="Check the real-time status of your attestation or company formation document using your tracking ID."
  hideCallbackPopup={true}
>

<style>
  .track-page {
    position: relative;
    overflow: hidden;
    background: #F6F9FA;
    min-height: 75vh;
    padding-bottom: 80px;
  }
  .track-page::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(56,178,172,0.15) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
  }

  .track-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 680px;
    margin: 0 auto;
    padding: 72px 20px 56px;
    text-align: center;
    width: 100%;
  }

  .track-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #38B2AC;
    background: rgba(56,178,172,0.1);
    border: 1px solid rgba(56,178,172,0.25);
    padding: 5px 14px;
    border-radius: 9999px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.72rem;
    margin-bottom: 18px;
  }

  .track-title {
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    font-weight: 900;
    color: #1A202C;
    line-height: 1.22;
    margin: 0 0 16px;
    letter-spacing: -0.02em;
  }

  .track-sub {
    font-size: clamp(0.88rem, 2vw, 1.05rem);
    color: #4A5568;
    margin: 0 auto 32px;
    max-width: 520px;
    line-height: 1.5;
  }

  .track-form-wrap {
    max-width: 540px;
    margin: 0 auto;
  }

  .track-form {
    display: flex;
    gap: 10px;
    background: #FFFFFF;
    padding: 8px;
    border-radius: 14px;
    border: 1px solid #E2E8F0;
    box-shadow: 0 12px 36px rgba(15,23,42,0.08);
  }

  .track-input {
    flex: 1;
    min-width: 0;
    border: 1px solid transparent;
    background: transparent;
    color: #1A202C;
    border-radius: 8px;
    padding: 13px 16px;
    font-size: 1rem;
    font-weight: 500;
    outline: none;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: border-color 0.2s;
  }
  .track-input::placeholder {
    color: #94A3B8;
    text-transform: none;
    letter-spacing: normal;
  }
  .track-input:focus {
    border-color: rgba(56,178,172,0.5);
    background: #F6F9FA;
  }

  .track-btn {
    background: #38B2AC;
    color: #FFFFFF;
    font-weight: 800;
    border: none;
    border-radius: 10px;
    padding: 13px 26px;
    cursor: pointer;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all 0.2s;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(56,178,172,0.3);
  }
  .track-btn:hover:not(:disabled) {
    background: #319795;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(56,178,172,0.45);
  }
  .track-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .result-wrap {
    position: relative;
    z-index: 2;
    padding: 0 16px;
    max-width: 760px;
    margin: 0 auto;
  }

  .result-card {
    background: #FFFFFF;
    border-radius: 24px;
    box-shadow: 0 24px 70px rgba(15,23,42,0.12);
    padding: 36px;
    position: relative;
    animation: fadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .result-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 14px;
    padding-bottom: 20px;
    border-bottom: 1px solid #F1F5F9;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .status-pending   { background: #FEF3C7; color: #92400E; }
  .status-progress  { background: #DBEAFE; color: #1E3A8A; }
  .status-completed { background: #DCFCE7; color: #166534; }
  .status-hold      { background: #FEE2E2; color: #991B1B; }

  .track-msg {
    text-align: center;
    color: #2C7A75;
    font-size: 0.92rem;
    margin-top: 18px;
    position: relative;
    z-index: 1;
    font-weight: 500;
  }
  .track-error {
    color: #B91C1C;
    background: rgba(239,68,68,0.08);
    border: 1px solid rgba(239,68,68,0.25);
    padding: 10px 16px;
    border-radius: 10px;
    display: inline-block;
  }

  @media (max-width: 640px) {
    .track-hero-inner {
      padding: 48px 16px 40px;
    }
    .track-form {
      flex-direction: column;
      padding: 8px;
      gap: 8px;
    }
    .track-input {
      padding: 12px 14px;
      font-size: 0.95rem;
      border: 1px solid #E2E8F0;
      border-radius: 8px;
    }
    .track-btn {
      width: 100%;
      padding: 13px;
    }
    .result-card {
      padding: 22px 18px;
      border-radius: 18px;
    }
    .result-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
</style>

<style is:global>
  .steps-list {
    margin-top: 32px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    position: relative;
  }

  .step-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    padding: 0 6px;
  }

  /* Connector line on desktop */
  .step-item:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 18px;
    left: 50%;
    width: 100%;
    height: 3px;
    background: #E2E8F0;
    z-index: 0;
    transition: background 0.3s;
  }
  .step-item.step-done:not(:last-child)::after {
    background: #38B2AC;
  }

  .step-dot {
    position: relative;
    z-index: 1;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 800;
    flex-shrink: 0;
    margin-bottom: 12px;
    border: 3px solid #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    transition: all 0.2s;
  }

  .step-done .step-dot {
    background: #38B2AC;
    color: #fff;
  }
  .step-current .step-dot {
    background: #1A202C;
    color: #38B2AC;
    box-shadow: 0 0 0 4px rgba(56,178,172,0.3);
    animation: pulseDot 2s infinite;
  }
  .step-upcoming .step-dot {
    background: #F1F5F9;
    color: #94A3B8;
    border-color: #E2E8F0;
  }

  @keyframes pulseDot {
    0%, 100% { box-shadow: 0 0 0 4px rgba(56,178,172,0.3); }
    50% { box-shadow: 0 0 0 8px rgba(56,178,172,0.1); }
  }

  .step-label {
    font-weight: 600;
    color: #1E293B;
    font-size: 0.85rem;
    line-height: 1.35;
    word-break: break-word;
  }
  .step-upcoming .step-label { color: #94A3B8; font-weight: 500; }
  .step-current .step-label { color: #0F172A; font-weight: 800; }

  /* Mobile / Tablet vertical stepper */
  @media (max-width: 640px) {
    .steps-list {
      flex-direction: column;
      margin-top: 24px;
      padding-left: 6px;
    }
    .step-item {
      flex-direction: row;
      align-items: flex-start;
      text-align: left;
      width: 100%;
      padding: 0 0 24px 0;
    }
    .step-item:last-child {
      padding-bottom: 0;
    }
    .step-item:not(:last-child)::after {
      top: 36px;
      left: 17px;
      width: 3px;
      height: calc(100% - 10px);
    }
    .step-dot {
      width: 34px;
      height: 34px;
      font-size: 0.78rem;
      margin-bottom: 0;
      margin-right: 16px;
    }
    .step-label {
      padding-top: 6px;
      font-size: 0.88rem;
    }
  }
</style>

<section class="track-page">
  <div class="track-hero-inner">
    <div class="track-badge-pill">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
      </svg>
      Live Tracking
    </div>
    <h1 class="track-title">Track Your Document Status</h1>
    <p class="track-sub">Enter your unique tracking reference number to see real-time updates and milestone progress.</p>
    
    <div class="track-form-wrap">
      <form id="trackForm" class="track-form">
        <input id="trackingIdInput" class="track-input" type="text" placeholder="e.g. IDX-2026-00482" autocomplete="off" spellcheck="false" required />
        <button type="submit" id="trackBtn" class="track-btn">
          <span>Track</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </form>
    </div>
    <p id="trackMsg" class="track-msg"></p>
  </div>

  <div class="result-wrap">
    <div id="resultCard" class="result-card" style="display:none;">
      <div class="result-header">
        <div>
          <p style="color:#64748B;font-size:0.75rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;margin:0 0 4px;">Document Type</p>
          <h2 id="resultDocType" style="font-size:clamp(1.2rem, 3vw, 1.5rem);font-weight:800;color:#0F172A;margin:0;"></h2>
        </div>
        <span id="resultStatus" class="status-badge"></span>
      </div>

      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-top:14px;padding:10px 14px;background:#F8FAFC;border-radius:10px;border:1px solid #E2E8F0;">
        <span style="color:#64748B;font-size:0.84rem;font-weight:500;">Reference ID:</span>
        <strong id="resultTrackingId" style="color:#0F172A;font-family:monospace;font-size:0.95rem;"></strong>
      </div>

      <div id="resultSteps" class="steps-list"></div>

      <div id="resultRemarksWrap" style="margin-top:24px;display:none;">
        <div style="background:#F0FDFA;border:1px solid #99F6E4;border-radius:12px;padding:14px 16px;">
          <p style="color:#0D9488;font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;margin:0 0 4px;">Status Notes / Remarks</p>
          <p id="resultRemarks" style="color:#134E4A;font-size:0.9rem;line-height:1.5;margin:0;"></p>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ TRACKING_API_URL: trackingApiUrl }}>
  const form = document.getElementById('trackForm');
  const input = document.getElementById('trackingIdInput');
  const btn = document.getElementById('trackBtn');
  const msg = document.getElementById('trackMsg');
  const card = document.getElementById('resultCard');

  const statusMeta = {
    'Pending':     { cls: 'status-pending', label: 'Pending' },
    'In Progress': { cls: 'status-progress', label: 'In Progress' },
    'Completed':   { cls: 'status-completed', label: 'Completed' },
    'On Hold':     { cls: 'status-hold', label: 'On Hold' },
  };

  function renderSteps(steps, currentOrder, isCompleted) {
    if (!steps || !steps.length) {
      return '<div style="color:#64748B;font-size:0.88rem;padding:12px 0;">No predefined steps for this document type.</div>';
    }
    const sorted = [...steps].sort((a, b) => a.order - b.order);
    return sorted.map((s, i) => {
      let state = 'upcoming';
      if (isCompleted || s.order < currentOrder) state = 'done';
      else if (s.order === currentOrder) state = 'current';
      const icon = state === 'done' ? '✓' : (i + 1);
      return `
        <div class="step-item step-${state}">
          <div class="step-dot">${icon}</div>
          <div class="step-label">${s.label}</div>
        </div>`;
    }).join('');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const trackingId = input.value.trim().toUpperCase();
    if (!trackingId) return;

    btn.disabled = true;
    btn.innerHTML = '<span>Searching...</span>';
    msg.textContent = '';
    msg.className = 'track-msg';
    card.style.display = 'none';

    try {
      const res = await fetch(`${TRACKING_API_URL}/api/track/${encodeURIComponent(trackingId)}`);
      if (res.status === 404) {
        msg.innerHTML = '<span class="track-error">No record found for tracking ID "<strong>' + trackingId + '</strong>". Please check and try again.</span>';
        return;
      }
      if (!res.ok) throw new Error('Request failed');

      const data = await res.json();
      const status = data.trackingStatus || 'Pending';
      const meta = statusMeta[status] || statusMeta['Pending'];
      const docType = data.document_type || data.documentType || {};
      const steps = docType.stepEntries || [];
      const currentOrder = data.current_step?.order || 1;
      const isCompleted = status === 'Completed';

      document.getElementById('resultDocType').textContent = docType.name || 'Document';
      document.getElementById('resultTrackingId').textContent = data.trackingId;
      const statusEl = document.getElementById('resultStatus');
      statusEl.textContent = meta.label;
      statusEl.className = `status-badge ${meta.cls}`;
      document.getElementById('resultSteps').innerHTML = renderSteps(steps, currentOrder, isCompleted);

      const remarksWrap = document.getElementById('resultRemarksWrap');
      const remarksEl = document.getElementById('resultRemarks');
      if (data.remarks) {
        remarksEl.textContent = data.remarks;
        remarksWrap.style.display = 'block';
      } else {
        remarksWrap.style.display = 'none';
      }

      card.style.display = 'block';
    } catch (err) {
      msg.innerHTML = '<span class="track-error">Unable to connect to the tracking server. Please try again in a moment.</span>';
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<span>Track</span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>';
    }
  });
</script>

</BaseLayout>