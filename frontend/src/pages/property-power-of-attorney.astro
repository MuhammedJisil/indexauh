---
import ContactForm from '../components/ContactForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro'

const useCases = [
  {
    icon: "🏡",
    title: "Can a Power of Attorney Be Used to Sell Property?",
    desc: "Yes. A property owner can give another person authority to complete a property sale when the POA covers the required actions. The document can identify the property and set out the steps the representative is permitted to complete. This may include signing transaction documents and dealing with procedures connected with the sale. For Dubai property transactions, the Dubai Land Department allows authorised representatives to act within the powers stated in the POA. Clear wording is therefore important. The representative should receive sufficient authority for the particular sale.",
  },
  {
    icon: "🔑",
    title: "Can You Buy Property Through a Special Power of Attorney?",
    desc: "Yes. A Special Power of Attorney for buying property can give a chosen representative authority to complete a specified property purchase. The document can describe the property and set out the actions the representative is permitted to take. This keeps the authority limited to the intended purchase. In Abu Dhabi, property owners can register a POA through the official digital property system for transactions such as buying and selling property.",
  },
  {
    icon: "🔄",
    title: "Property Transfer",
    desc: "A property owner can also appoint someone to deal with specific transfer formalities. The POA should explain the powers needed for the intended transfer. Requirements may vary depending on the emirate and the type of transaction involved.",
  },
  {
    icon: "🗝️",
    title: "Leasing and Property Management",
    desc: "Property owners can grant limited authority for leasing or management activities. For instance, the representative may be authorised to deal with specified tenancy matters or other agreed property responsibilities. The POA should state these powers clearly.",
  },
]

const includeItems = [
  "Full details of the property owner",
  "Details of the appointed representative",
  "Property identification and relevant details",
  "Purpose of the POA",
  "Specific property transaction",
  "Powers granted to the representative",
  "Any limitations on those powers",
  "Requirements of the relevant property authority",
]

const docsRequired = [
  "Passport or Emirates ID of the property owner",
  "Identification documents of the representative",
  "Property documents, where required",
  "Title deed or relevant property details",
  "Supporting documents connected with the transaction",
  "Original POA or properly authenticated document for an overseas POA",
]

const getSteps = [
  { step: "01", title: "Provide the property information", desc: "Tell us about the property and explain the task you want another person to complete." },
  { step: "02", title: "Provide the necessary paperwork", desc: "Submit the owner's identification, details of the proposed representative and documents connected with the property." },
  { step: "03", title: "Draft the POA", desc: "The document is prepared according to the transaction and the powers you want to grant." },
  { step: "04", title: "Complete notarisation", desc: "The POA is taken through the appropriate notarisation process based on the circumstances." },
  { step: "05", title: "Handle attestation or legalisation", desc: "A POA created outside the UAE may require authentication in its country of issue and further formalities through the relevant UAE authorities. For Dubai transactions, a foreign issued POA must complete the required ratification process before it can be accepted for applicable property transactions." },
  { step: "06", title: "Arrange certified translation", desc: "A translated version may be needed when the receiving authority requires the document in another language." },
  { step: "07", title: "Proceed with the property formalities", desc: "After completing the required document formalities, the representative can proceed with the intended transaction subject to the requirements of the relevant authority." },
]

const emirates = [
  {
    icon: "🏙️",
    title: "Dubai",
    desc: "The Dubai Land Department permits an authorised representative to complete property transactions within the authority granted by the POA. DLD states that a POA covering transactions such as sale, mortgage and grants is valid for two years. For property purchase, the stated period is five years from notarisation at the notary public.",
  },
  {
    icon: "🏛️",
    title: "Abu Dhabi",
    desc: "In Abu Dhabi, property owners can register a POA through the official digital property system. The service allows an owner to authorise a representative for property transactions, including buying and selling. The application is reviewed through the applicable property authority process.",
  },
]

const services = [
  "POA drafting",
  "Document processing",
  "Notarisation",
  "Attestation",
  "Legalisation",
  "Certified translation",
  "Property document coordination",
  "Assistance for owners in the UAE and abroad",
  "Pickup and delivery support where applicable",
]

const faqs = [
  { q: "Does a property Power of Attorney need to identify the property?", a: "The document should provide enough property information and authority details for the intended transaction. The exact information required can depend on the property and the relevant authority." },
  { q: "Can one person be appointed to handle property matters on my behalf?", a: "Yes. A property owner can appoint a representative and define the powers that person can exercise through the POA." },
  { q: "Can a property POA issued outside the UAE be used for a UAE transaction?", a: "It may be used after completing the required authentication and attestation formalities. The exact process depends on the country of issue and the UAE authority receiving the document." },
  { q: "What happens when the POA wording does not match the property transaction?", a: "The representative may not have sufficient authority to complete the intended transaction. This is why the POA should be prepared around the specific property matter and applicable requirements." },
  { q: "Can a property Power of Attorney be cancelled?", a: "A POA may be cancelled or revoked subject to the applicable legal and procedural requirements. The transaction status and relevant authority requirements should be considered before taking this step." },
]
---

<BaseLayout
  title="Property Power of Attorney UAE | Index Office Services"
  description="Need a property power of attorney in the UAE? Index Office Services assists with drafting, notarisation, attestation and legalisation."
>

<style>
  .sec-inner { position: relative; z-index: 1; }
  .in-link { color: #fff; font-weight: 700; text-decoration: underline; text-decoration-color: #38B2AC; text-underline-offset: 3px; transition: color 0.2s; }
  .in-link:hover { color: #38B2AC; }
  .in-link-dark { color: #1A202C; font-weight: 700; text-decoration: underline; text-decoration-color: #38B2AC; text-underline-offset: 3px; transition: color 0.2s; }
  .in-link-dark:hover { color: #38B2AC; }
  .step-card { display: flex; align-items: flex-start; gap: 16px; background: #fff; border: 1px solid #eef0f6; border-radius: 14px; padding: 18px; transition: all 0.25s; }
  .step-card:hover { border-color: #B2F5EA; box-shadow: 0 10px 24px rgba(56,178,172,0.08); }
  .benefit-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px; }
  .poa-type-card { background: #F8FAFF; border: 1px solid #eef0f6; border-radius: 16px; padding: 26px; transition: all 0.25s; }
  .poa-type-card:hover { border-color: #B2F5EA; box-shadow: 0 8px 24px rgba(56,178,172,0.08); }
  .faq-item { border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden; }
  .faq-q { width: 100%; background: #fff; border: none; text-align: left; padding: 18px 20px; font-size: 0.9rem; font-weight: 600; color: #1A202C; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .faq-a { padding: 0 20px; max-height: 0; overflow: hidden; transition: max-height 0.35s ease, padding 0.2s; }
  .faq-a.open { max-height: 320px; padding: 0 20px 16px; }
  .faq-icon { font-size: 1.1rem; transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-icon { transform: rotate(45deg); }

  .split-grid { display: grid !important; }
  .three-col { display: grid !important; }
  .two-col { display: grid !important; }
  .four-col { display: grid !important; }

  @media(max-width:768px){
    .hero-title { font-size: 2rem !important; }
    .split-grid { grid-template-columns: 1fr !important; gap: 32px !important; }
    .three-col { grid-template-columns: 1fr !important; }
    .two-col { grid-template-columns: 1fr !important; }
    .four-col { grid-template-columns: 1fr !important; }
    .img-first { order: -1 !important; }
    .hero-btns { flex-direction: column !important; align-items: stretch !important; }
    .hero-btns a { text-align: center; justify-content: center; }
  }
</style>

<!-- ════════════ HERO ════════════ -->
<section style="position:relative;overflow:hidden;min-height:500px;display:flex;align-items:center;">
  <img src="/images/img-16.webp" alt="Property Power of Attorney in the UAE" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%;display:block;" loading="eager" fetchpriority="high" width="1200" height="600" />
  <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(26,32,44,0.92) 0%,rgba(45,55,72,0.80) 100%);"></div>
  <div style="position:absolute;inset:0;background-image:radial-gradient(rgba(56,178,172,0.18) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:880px;margin:0 auto;padding:96px 24px;text-align:center;width:100%;">
    <h1 class="hero-title" style="font-size:clamp(2rem,4vw,3.2rem);font-weight:900;color:#fff;line-height:1.15;margin:0 0 20px;">
      Property Power of Attorney in the UAE | Index Office Services
    </h1>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 20px;max-width:660px;">
      A property power of attorney lets a property owner give another person defined authority to deal with a property matter. This can be useful when the owner cannot attend a transaction, lives in another country, or wants someone else to manage a specific responsibility.
    </p>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 20px;max-width:660px;">
      The authority may relate to selling, buying, transferring, leasing, or managing property. The document should describe the permitted actions clearly and follow the requirements of the authority handling the transaction.
    </p>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 32px;max-width:660px;">
      Index Office Services provides complete assistance with property Power of Attorney services, including drafting, processing, notarisation, attestation, legalisation and <a href="https://indexauh.com/legal-translation-in-uae/" class="in-link">certified translation</a>.
    </p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;" class="hero-btns">
      <a href="#get-in-touch" style="display:inline-flex;align-items:center;gap:8px;background:#38B2AC;color:#fff;font-weight:700;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none;box-shadow:0 4px 20px rgba(56,178,172,0.4);">Get Started &rarr;</a>
      <a href="#details" style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.3);color:#fff;font-weight:600;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none;">Learn More</a>
    </div>
  </div>
</section>

<!-- ════ WHEN DO YOU NEED ════ -->
<section id="details" style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner split-grid" style="max-width:1280px;margin:0 auto;grid-template-columns:1.2fr 1fr;gap:52px;align-items:center;">
    <div>
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;display:flex;align-items:center;gap:8px;margin-bottom:12px;">
        <span style="display:inline-block;width:28px;height:1px;background:#2D3748;"></span>Service Overview
      </p>
      <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);font-weight:900;color:#1A202C;line-height:1.2;margin:0 0 18px;">When Do You Need a Property Power of Attorney?</h2>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">
        A property POA can help when the owner is unable to complete a property related task personally.
      </p>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">
        An owner who is based overseas, for instance, can give a trusted person authority to complete the required steps for a property sale in the UAE. Someone else may need similar assistance when purchasing a property or dealing with transfer formalities.
      </p>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">
        The document can also cover selected leasing and property management duties. The owner can decide which responsibilities the appointed person may carry out.
      </p>
      <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:12px;padding:18px;">
        <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0;">
          The powers depend on the wording of the POA. For this reason, the document should reflect the actual transaction rather than rely on a broad standard format.
        </p>
      </div>
    </div>

    <div>
      <div style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 12px 40px rgba(0,0,0,0.12);">
        <img src="/images/img-11.webp" alt="When do you need a property power of attorney" style="width:100%;height:460px;object-fit:cover;display:block;" loading="lazy" width="800" height="450" />
        <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(26,32,44,0.72) 100%);"></div>
        <div style="position:absolute;bottom:20px;left:20px;right:20px;">
          <p style="color:#fff;font-size:0.9rem;font-weight:800;margin:0 0 4px;">Sell · Buy · Transfer · Manage</p>
          <p style="color:#B2F5EA;font-size:0.75rem;margin:0;">Complete property POA process handled end-to-end</p>
        </div>
        <div style="position:absolute;bottom:84px;left:-14px;background:#2D3748;color:#fff;padding:10px 16px;border-radius:10px;font-size:0.75rem;font-weight:700;box-shadow:0 6px 20px rgba(0,0,0,0.2);">
          Dubai &amp; Abu Dhabi Covered
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ════ WHAT CAN IT BE USED FOR ════ -->
<section style="background:#F8FAFF;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1280px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:48px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Common Transactions</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">What Can a Property Power of Attorney Be Used For?</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;max-width:700px;margin:0 auto;">
        A property POA can be prepared for several types of property transactions. The powers given to the representative depend on the owner's instructions.
      </p>
    </div>

    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:24px;" class="two-col">
      {useCases.map(c => (
        <div class="poa-type-card">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
            <span style="font-size:1.5rem;">{c.icon}</span>
            <h3 style="font-size:1rem;font-weight:800;color:#1A202C;margin:0;">{c.title}</h3>
          </div>
          <p style="font-size:0.85rem;color:#6B7280;line-height:1.7;margin:0;">{c.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ════ WHAT SHOULD IT INCLUDE ════ -->
<section style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner split-grid" style="max-width:1200px;margin:0 auto;grid-template-columns:1fr 1.2fr;gap:48px;align-items:center;">
    <div class="img-first" style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,0.1);">
      <img src="/images/img-7.webp" alt="What a property power of attorney should include" style="width:100%;height:520px;object-fit:cover;display:block;" loading="lazy" width="800" height="450" />
      <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(26,32,44,0.7) 100%);"></div>
      <div style="position:absolute;bottom:16px;left:16px;right:16px;">
        <p style="color:#fff;font-size:0.98rem;font-weight:800;margin:0;">Clear Wording, Matched Authority</p>
      </div>
    </div>

    <div>
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Drafting</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">What Should a Property Power of Attorney Include?</h2>
      <p style="color:#4B5563;font-size:0.95rem;line-height:1.8;margin:0 0 16px;">
        A property POA should provide clear information about the owner, the appointed person and the powers being granted. It may contain:
      </p>
      <div style="background:#F8FAFF;border:1px solid #eef0f6;border-radius:16px;padding:24px;margin-bottom:18px;">
        <div style="display:flex;flex-direction:column;gap:10px;">
          {includeItems.map(d => (
            <div style="display:flex;align-items:flex-start;gap:10px;font-size:0.9rem;color:#4B5563;line-height:1.5;">
              <span style="color:#38B2AC;font-weight:bold;flex-shrink:0;margin-top:2px;">→</span>{d}
            </div>
          ))}
        </div>
      </div>
      <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:12px;padding:18px;">
        <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0 0 8px;">
          The wording should match the intended transaction. Vague or unsuitable powers can create difficulties when the document is submitted for processing.
        </p>
        <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0;">
          Preparing the POA around the actual property matter can help reduce unnecessary issues during the transaction.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ════ DOCUMENTS REQUIRED ════ -->
<section style="background:#F0FFFE;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:44px 44px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner split-grid" style="max-width:1280px;margin:0 auto;grid-template-columns:1.2fr 1fr;gap:52px;align-items:center;">
    <div>
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Requirements</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">Documents Required for a Property Power of Attorney</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;margin-bottom:16px;">
        The paperwork depends on the property transaction, the owner's circumstances and the authority involved. Common documents may include:
      </p>
      <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:20px;">
        {docsRequired.map(item => (
          <div style="display:flex;align-items:flex-start;gap:12px;background:#fff;border:1px solid #eef0f6;border-radius:10px;padding:12px 16px;">
            <span style="color:#38B2AC;font-weight:bold;font-size:1rem;flex-shrink:0;margin-top:2px;">→</span>
            <p style="font-size:0.9rem;color:#374151;line-height:1.6;margin:0;">{item}</p>
          </div>
        ))}
      </div>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">
        The receiving authority may request additional paperwork based on the transaction.
      </p>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin:0;">
        Index Office Services can assess the available documents and assist with the formalities needed for the intended use.
      </p>
    </div>

    <div>
      <div style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 12px 40px rgba(0,0,0,0.12);">
        <img src="/images/img-1.webp" alt="Documents required for property power of attorney" style="width:100%;height:460px;object-fit:cover;display:block;" loading="lazy" width="800" height="450" />
        <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(26,32,44,0.72) 100%);"></div>
        <div style="position:absolute;bottom:20px;left:20px;right:20px;">
          <p style="color:#fff;font-size:0.9rem;font-weight:800;margin:0 0 4px;">Have the Right Documents Ready</p>
          <p style="color:#B2F5EA;font-size:0.75rem;margin:0;">Title deed, IDs and supporting paperwork</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ════ HOW TO GET ════ -->
<section style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1200px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:40px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Step-by-Step</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">How Do You Get Power of Attorney for Property?</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;max-width:700px;margin:0 auto;">
        The first step is to establish the property transaction and decide what authority the representative needs.
      </p>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:28px;" class="two-col">
      {getSteps.map(s => (
        <div class="step-card">
          <div style="width:42px;height:42px;border-radius:10px;background:#2D3748;color:#38B2AC;font-weight:900;font-size:1rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;">{s.step}</div>
          <div>
            <p style="font-size:1.05rem;font-weight:700;color:#1A202C;margin:0 0 4px;">{s.title}</p>
            <p style="font-size:0.9rem;color:#6B7280;line-height:1.6;margin:0;">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:14px;padding:20px 26px;">
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0;">
        Index Office Services can assist throughout the process, from preparing the POA to completing the required document formalities.
      </p>
    </div>
  </div>
</section>

<!-- ════ OWNERS OUTSIDE THE UAE ════ -->
<section style="background:#F8FAFF;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1200px;margin:0 auto;">
    <div style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,0.1);margin-bottom:40px;">
