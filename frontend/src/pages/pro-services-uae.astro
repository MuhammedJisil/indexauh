---

<BaseLayout
  title="PRO Services UAE | Professional PRO Services in Dubai"
  description="Professional PRO services in Dubai & UAE for visas, trade licences and government approvals. Index Office Services brings 25+ years of experience."
>

<style>
  .sec-inner { position: relative; z-index: 1; }
  .sec { padding: 76px 24px; position: relative; overflow: hidden; }
  .sec-alt { background: #F8FAFF; }
  .sec-white { background: #fff; }
  .bg-grid { position:absolute; inset:0; background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px); background-size:40px 40px; pointer-events:none; z-index:0; }
  .bg-diag { position:absolute; inset:0; background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px); pointer-events:none; z-index:0; }
  .wrap { max-width: 1280px; margin: 0 auto; }
  .eyebrow { color:#2D3748; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; font-size:0.75rem; display:flex; align-items:center; gap:8px; margin:0 0 12px; }
  .eyebrow::before { content:""; display:inline-block; width:28px; height:1px; background:#2D3748; }
  .h2 { font-size:clamp(1.7rem,3vw,2.2rem); font-weight:900; color:#1A202C; line-height:1.2; margin:0 0 18px; }
  .h3 { font-size:1.05rem; font-weight:800; color:#1A202C; margin:0 0 8px; border-left:4px solid #38B2AC; padding-left:12px; }
  .p { color:#4B5563; font-size:0.95rem; line-height:1.8; margin:0 0 16px; }
  .p-sm { color:#4B5563; font-size:0.9rem; line-height:1.7; margin:0 0 12px; }
  .idx-pill { background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.28); color: #fff; font-size: 0.78rem; padding: 5px 14px; border-radius: 9999px; font-weight: 500; white-space: nowrap; }
  .svc-arrow-card { background: #fff; border: 1px solid #eef0f6; border-radius: 14px; padding: 18px 20px; display: flex; align-items: flex-start; gap: 12px; transition: all 0.25s; }
  .svc-arrow-card:hover { border-color: #B2F5EA; box-shadow: 0 12px 32px rgba(56,178,172,0.08); }
  .box-card { background: #fff; border: 1px solid #eef0f6; border-radius: 20px; padding: 28px; transition: all 0.25s; }
  .box-card:hover { border-color: #B2F5EA; box-shadow: 0 12px 32px rgba(56,178,172,0.08); }
  .arrow-list { list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:8px; }
  .arrow-list li { display:flex; align-items:flex-start; gap:10px; font-size:0.88rem; color:#4B5563; line-height:1.65; }
  .arrow-list li::before { content:"→"; color:#38B2AC; font-weight:900; flex-shrink:0; }
  .grid-3 { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; }
  .grid-2 { display:grid; grid-template-columns:repeat(2,1fr); gap:20px; }
  .split-grid { display:grid; grid-template-columns:1.2fr 0.9fr; gap:52px; align-items:center; }
  .tbl-wrap { overflow-x:auto; border-radius:16px; border:1px solid #eef0f6; box-shadow:0 12px 32px rgba(0,0,0,0.04); background:#fff; }
  .tbl { width:100%; border-collapse:collapse; min-width:560px; }
  .tbl th { background:#2D3748; color:#fff; text-align:left; font-size:0.82rem; letter-spacing:0.05em; text-transform:uppercase; padding:14px 18px; }
  .tbl td { padding:14px 18px; font-size:0.9rem; color:#4B5563; line-height:1.6; border-top:1px solid #eef0f6; vertical-align:top; }
  .tbl td:first-child { color:#1A202C; font-weight:700; width:36%; }
  .tbl tr:nth-child(even) td { background:#F8FAFF; }
  .step-num { flex-shrink:0; width:42px; height:42px; border-radius:9999px; background:#38B2AC; color:#fff; font-weight:900; display:flex; align-items:center; justify-content:center; }
  .faq { background:#fff; border:1px solid #eef0f6; border-radius:14px; padding:0; margin-bottom:12px; transition:all 0.25s; }
  .faq[open] { border-color:#B2F5EA; box-shadow:0 12px 32px rgba(56,178,172,0.08); }
  .faq summary { cursor:pointer; list-style:none; padding:18px 22px; font-weight:700; color:#1A202C; font-size:0.95rem; display:flex; justify-content:space-between; gap:16px; }
  .faq summary::-webkit-details-marker { display:none; }
  .faq summary::after { content:"+"; color:#38B2AC; font-weight:900; font-size:1.2rem; line-height:1; }
  .faq[open] summary::after { content:"–"; }
  .faq p { margin:0; padding:0 22px 20px; color:#4B5563; font-size:0.9rem; line-height:1.75; }
  .note { color:#6B7280; font-size:0.8rem; line-height:1.7; margin:14px 0 0; font-style:italic; }
  @media(max-width:900px){
    .grid-3 { grid-template-columns:repeat(2,1fr); }
  }
  @media(max-width:768px){
    .hero-title { font-size: 2rem !important; }
    .split-grid, .grid-3, .grid-2 { grid-template-columns: 1fr !important; gap: 24px !important; }
  }
</style>

<!-- ════════════ HERO ════════════ -->
<section style="position:relative;overflow:hidden;min-height:500px;display:flex;align-items:center;">
  <img src="/images/img-16.webp" alt="PRO Services UAE" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%;display:block;" loading="eager" fetchpriority="high" width="1200" height="600" />
  <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(26,32,44,0.92) 0%,rgba(45,55,72,0.80) 100%);"></div>
  <div style="position:absolute;inset:0;background-image:radial-gradient(rgba(56,178,172,0.18) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:880px;margin:0 auto;padding:96px 24px;text-align:center;width:100%;">
    <div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:18px;">
      <span class="idx-pill">Visas</span>
      <span class="idx-pill">Trade Licences</span>
      <span class="idx-pill">Government Approvals</span>
      <span class="idx-pill">25+ Yrs Experience</span>
    </div>
    <h1 class="hero-title" style="font-size:clamp(2rem,4vw,3.2rem);font-weight:900;color:#fff;line-height:1.15;margin:0 0 20px;">PRO Services UAE | Professional PRO Services UAE</h1>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 32px;max-width:720px;">
      Managing visas, trade licences, government approvals, and business documents can take valuable time away from running your business. PRO Services UAE help businesses handle these essential tasks smoothly while staying compliant with government requirements. At Index Office Services, we bring over 25 years of experience supporting businesses across the UAE with professional document and government liaison services. Explore this page to understand our PRO services in Dubai, what we offer, and how our team can support your business needs.
    </p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
      <a href="#get-in-touch" style="display:inline-flex;align-items:center;gap:8px;background:#38B2AC;color:#fff;font-weight:700;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none;box-shadow:0 4px 20px rgba(56,178,172,0.4);">Get Started &rarr;</a>
    </div>
  </div>
</section>

<!-- ════ WHY BUSINESSES NEED PRO ════ -->
<section class="sec sec-alt">
  <div class="bg-grid"></div>
  <div class="sec-inner wrap">
    <div class="split-grid">
      <div>
        <p class="eyebrow">Why PRO Services</p>
        <h2 class="h2">Why Businesses Need PRO Services in the UAE</h2>
        <p class="p">Government procedures are part of almost every stage of running a business in the UAE. From starting a company to hiring employees and renewing licences, each process requires accurate documentation and timely submissions. Missing a requirement can lead to delays, extra costs, or interruptions to business operations.</p>
        <p class="p" style="margin:0;">With more than 25 years of experience, Index Office Services has supported businesses across the UAE through these government procedures. Our team understands the documentation standards, application processes, and compliance requirements that help businesses move forward with greater confidence.</p>
      </div>
      <div style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,0.1);">
        <img src="/images/img-55.webp" alt="PRO Services in the UAE" style="width:100%;height:380px;object-fit:cover;display:block;" loading="lazy" width="800" height="450" />
        <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(26,32,44,0.75) 100%);"></div>
        <div style="position:absolute;bottom:20px;left:20px;right:20px;">
          <p style="color:#fff;font-size:0.9rem;font-weight:800;margin:0 0 4px;">Professional PRO Services UAE</p>
          <p style="color:#B2F5EA;font-size:0.75rem;margin:0;">Visas · Trade Licences · Approvals · Attestation</p>
        </div>
      </div>
    </div>

    <p style="color:#1A202C;font-weight:700;font-size:1rem;margin:44px 0 18px;">Businesses usually need PRO services to:</p>
    <div class="grid-2">
      {needs.map(item => (
        <div class="svc-arrow-card">
          <span style="color:#38B2AC;font-weight:900;font-size:1rem;flex-shrink:0;margin-top:2px;">→</span>
          <p style="font-size:0.9rem;color:#4B5563;line-height:1.65;margin:0;">{item}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ════ OUR PRO SERVICES IN DUBAI ════ -->
<section class="sec sec-white">
  <div class="bg-diag"></div>
  <div class="sec-inner wrap">
    <div style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,0.1);margin-bottom:40px;">
      <img src="/images/img-41.webp" alt="PRO services in Dubai" style="width:100%;height:220px;object-fit:cover;object-position:center 35%;display:block;" loading="lazy" width="800" height="450" />
      <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(26,32,44,0.88) 0%,rgba(26,32,44,0.5) 55%,transparent 100%);"></div>
      <div style="position:absolute;top:50%;left:40px;transform:translateY(-50%);">
        <p style="color:#38B2AC;font-weight:700;font-size:0.75rem;letter-spacing:0.12em;text-transform:uppercase;margin:0 0 6px;">What We Cover</p>
        <h2 style="color:#fff;font-size:clamp(1.4rem,2.5vw,2rem);font-weight:900;margin:0;max-width:500px;line-height:1.25;">OUR PRO SERVICES IN DUBAI</h2>
      </div>
    </div>

    <p class="p" style="max-width:900px;">Every business has different administrative requirements. Some need support with employee visas, while others require help with company documentation or government approvals. At Index Office Services, we provide a wide range of PRO services in Dubai to support businesses at every stage.</p>

    <div class="grid-2" style="margin-top:28px;">
      {services.map(s => (
        <div class="box-card">
          <h3 class="h3">{s.title}</h3>
          <p class="p-sm" style="margin-bottom:14px;">{s.intro}</p>
          <ul class="arrow-list">{s.items.map(i => <li>{i}</li>)}</ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ════ GOVERNMENT AUTHORITIES ════ -->
<section class="sec sec-alt">
  <div class="bg-grid"></div>
  <div class="sec-inner wrap">
    <p class="eyebrow">Coordination</p>
    <h2 class="h2">Government Authorities We Coordinate With</h2>
    <p class="p" style="max-width:900px;">Many business procedures involve approvals from different government authorities. Knowing which department handles each process helps avoid confusion and keeps applications moving in the right direction. At Index Office Services, our team coordinates with the relevant authorities based on the service required.</p>
    <div class="tbl-wrap">
      <table class="tbl">
        <thead><tr><th>Government Authority</th><th>Purpose</th></tr></thead>
        <tbody>{authorities.map(([a, b]) => <tr><td>{a}</td><td>{b}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="p" style="margin:20px 0 0;">Every business has different requirements, and the authorities involved can vary depending on the type of company, visa, or government service needed. Our experience allows us to guide businesses through the correct process while helping them prepare the required documentation for each stage.</p>
  </div>
</section>

<!-- ════ WHO CAN BENEFIT ════ -->
<section class="sec sec-white">
  <div class="bg-diag"></div>
  <div class="sec-inner wrap">
    <p class="eyebrow">Who We Help</p>
    <h2 class="h2">Who Can Benefit from PRO Services?</h2>
    <p class="p" style="max-width:900px;">Businesses of every size need government support at different stages of their journey. Some require help during company formation, while others need ongoing assistance with visas, licences, and compliance. Our PRO services UAE are suitable for:</p>
    <div class="grid-3" style="margin-top:28px;">
      {audiences.map(a => (
        <div class="box-card">
          <h3 class="h3">{a.title}</h3>
