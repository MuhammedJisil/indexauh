  { title: "For Family Visa Services", items: ["Sponsor's passport and Emirates ID copy.", "Family member's passport copy.", "Passport-sized photographs.", "Attested marriage certificate or birth certificate, depending on the application.", "Proof of accommodation and other supporting documents, where required."] },
  { title: "For Investor and Partner Visa Services", items: ["Passport copy.", "Passport-sized photograph.", "Trade licence copy.", "Company incorporation documents.", "Shareholder or partnership documents."] },
