const faqs = [
  ["Can businesses use PRO services for a single requirement?", "Yes. Businesses may seek support for one specific requirement, such as a visa application, trade licence renewal, or document processing, without using ongoing PRO support."],
  ["Are PRO services available for mainland and free zone companies?", "Yes. Both mainland and free zone businesses can use PRO services. The process and required approvals vary depending on the licensing authority and business structure."],
