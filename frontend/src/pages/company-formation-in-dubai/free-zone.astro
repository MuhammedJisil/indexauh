---
import ContactForm from '../../components/ContactForm.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const link = (href, text, color = '#1A202C') =>
  `<a href="${href}" style="color:${color};font-weight:700;text-decoration:underline;text-decoration-color:#38B2AC;text-underline-offset:3px;">${text}</a>`;

const WHATSAPP = "https://wa.me/971525245208";

const stats = [
  "Established in 2000",
  "25+ Years of Experience",
  "2,500+ Companies Formed",
  "100+ Countries Covered",
]

const services = [
  "Zone and licence activity selection based on your business plan",
  "Structure advice: FZE, FZCO/FZ-LLC or branch",
  "Name reservation, application and initial approval",
  "Attestation of corporate and personal documents",
  "MOA/AOA preparation and signing",
  "Trade licence and flexi-desk or office arrangement",
  "Establishment card, immigration card, residence visas and Emirates ID",
  "Corporate bank account support",
  "Corporate tax and VAT registration support",
]

const benefits = [
  "100% foreign ownership with no local sponsor",
  "Full repatriation of capital and profits, with no currency restrictions",
  "Residence visas for owners, directors, employees and their families",
  "Options from flexi-desks to full offices, suited to startups and SMEs",
  "Digital incorporation in most zones",
  "Business clusters that place you near suppliers and clients",
]

const compareCols = ["Free zone", "Mainland", "Offshore"]
const compareRows = [
  { label: "Where you trade", vals: ["Inside the zone and internationally", "Anywhere in the UAE", "Outside the UAE only"] },
  { label: "Office and visas", vals: ["Yes, linked to premises", "Yes", "No UAE office or visas"] },
  { label: "Best for", vals: ["Export, trading, services, holding, e-commerce", "Retail and UAE-focused businesses", "Holding and asset structuring"] },
]

const suitsYou = [
  "Most of your customers are overseas or in other free zones",
  "You want to pursue 0% tax on qualifying income",
  "You do not need retail premises or direct sales to UAE consumers",
]

const zones = [
  { zone: "DMCC", best: "Commodities, trading, crypto, precious metals, holding structures" },
  { zone: "JAFZA", best: "Logistics, industrial, general trading" },
  { zone: "IFZA and Meydan", best: "Cost-conscious SMEs, consultancy, professional services" },
  { zone: "Dubai South and DWC", best: "Logistics, aviation-linked and light industrial activity" },
  { zone: "Internet City, Media City, Silicon Oasis", best: "Technology, media, telecom, engineering" },
  { zone: "DIFC", best: "Banking, financial services, legal" },
  { zone: "DAFZA", best: "Aviation, aerospace, trading" },
  { zone: "Dubai Commercity", best: "E-commerce, logistics" },
]

const structures = [
  { name: "FZE (Free Zone Establishment)", desc: "One shareholder, individual or corporate. Ideal for solo founders." },
  { name: "FZCO or FZ-LLC", desc: "Two or more shareholders. Suited to partnerships and corporate-backed ventures. Naming varies by zone." },
  { name: "Branch of a foreign company", desc: "An extension of your existing business. It has no separate legal personality, so the parent remains liable." },
]

const personalDocs = [
  "Passport copy, plus UAE visa or entry stamp and Emirates ID if applicable",
  "Proof of address dated within three months",
  "Bank or professional reference letter",
  "CV or summary of professional history",
  "Passport-size photographs",
  "Business plan or activity description (some zones ask for a detailed plan)",
]

const corporateDocs = [
  "Certificate of incorporation",
  "Memorandum and Articles of Association",
  "Board resolution approving the UAE entity",
  "Certificate of good standing",
]

const processSteps = [
  { step: "01", title: "Consultation and plan", desc: "We review your activity, shareholders and target market." },
  { step: "02", title: "Zone, structure and name", desc: "We recommend the zone, entity type and activity list, and reserve your name." },
  { step: "03", title: "Documents and attestation", desc: "We collect, check and attest your documents first, as this takes the longest." },
  { step: "04", title: "Initial approval", desc: "We submit your application. Many zones approve within one to three business days." },
  { step: "05", title: "MOA signing and fees", desc: "We prepare the MOA/AOA for e-signature and process payment." },
  { step: "06", title: "Trade licence", desc: "Most zones issue the licence electronically." },
  { step: "07", title: "Premises", desc: "We arrange your flexi-desk, virtual office or physical office, which also sets your visa allocation." },
  { step: "08", title: "Cards and visas", desc: `Our ${link('/pro-services-uae/', 'PRO services')} team handles establishment and immigration cards, medicals, Emirates ID and visa stamping.` },
  { step: "09", title: "Bank account and tax registration", desc: "We support your bank application and register you for corporate tax, and VAT where required." },
]

const timeline = [
  { stage: "Licence", time: "About 10 working days to 4 weeks, depending on the zone" },
  { stage: "Residence visa", time: "2 to 4 weeks each" },
  { stage: "Bank account", time: "2 to 6 weeks" },
  { stage: "Start to working bank account", time: "4 to 8 weeks" },
]

const costFactors = [
  "The free zone and licence type",
  "The number of business activities",
  "Premises: flexi-desk, virtual office or physical office",
  "The number of residence visas",
  "Your shareholder structure and document attestation needs",
]

const gccLinks = [
  { text: "Company formation in Abu Dhabi", href: "/company-formation-in-abu-dhabi/" },
  { text: "Company formation in Saudi Arabia", href: "/company-formation-in-saudi/" },
  { text: "Company formation in Qatar", href: "/company-formation-in-qatar/" },
  { text: "Company formation in Kuwait", href: "/company-formation-in-kuwait/" },
  { text: "Company formation in Oman", href: "/company-formation-in-oman/" },
  { text: "Company formation in Bahrain", href: "/bahrain-company-formation/" },
]

const whyChoose = [
  { title: "25+ Years of Experience", desc: "25+ years of experience in company formation." },
  { title: "2,500+ Companies Formed", desc: "2,500+ companies formed for founders and businesses across 100+ countries." },
  { title: "One Team, No Gaps", desc: "One team for company setup and attestation, so nothing is lost between providers." },
  { title: "UAE and GCC Coverage", desc: "Business setup across every emirate in the UAE and in GCC countries, so you can expand without changing providers." },
  { title: "Honest Zone Advice", desc: "Zone advice based on your activity and customers, not on the cheapest licence." },
  { title: "One Point of Contact", desc: "One point of contact from first call to bank account." },
]

const faqs = [
  { q: "Can I set up a free zone company in Dubai if I live outside the UAE?", a: "Yes. Most zones allow remote incorporation and we manage the application for you. You travel only for visa medicals, Emirates ID biometrics and, usually, the bank meeting." },
  { q: "How many visas does a free zone company get?", a: "It depends on the zone and premises. Flexi-desk and virtual packages commonly include two to three, and larger offices receive more in line with floor area. We choose premises with your visa needs in mind." },
  { q: "Can you help open a bank account for my free zone company?", a: "Yes. Banks review free zone applications closely, and first-time rejections are common. We prepare your activity proof and recommend the bank that suits your zone and business, including a staged route through a digital bank where that helps." },
  { q: "Can I add activities after my licence is issued?", a: "Yes, with a fee and sometimes extra approvals. We map activities to your 12-month plan upfront to avoid this." },
  { q: "Do some activities need extra approvals?", a: "Yes. Regulated activities such as education or healthcare may need approval from an external authority before the zone issues a licence. We identify this at the planning stage." },
  { q: "Can my company get a Tax Residency Certificate?", a: "Yes. It helps if you plan to use the UAE’s double tax treaty network." },
  { q: "How are licences and visas renewed?", a: "Licences are renewed periodically, typically yearly, and residence visas every few years. We track both and handle renewals. If you hold 0% status, we also flag your audited accounts and annual tax filings." },
  { q: "Can I move to the mainland later?", a: "Yes, through a mainland or dual licence. We advise on the right sequence and which documents carry over." },
]

const attestationPara = `Corporate documents normally must be attested before a zone accepts them. That means verification in the country of issue, then ${link('/mofa-attestation-in-uae/', 'MOFA attestation')} in the UAE and, depending on the country, ${link('/embassy-attestation-in-uae/', 'embassy attestation')} or an ${link('/apostille-service-uae/', 'apostille')}. Our ${link('/commercial-documents-attestation/', 'commercial documents attestation')} team handles this alongside your application, and we arrange ${link('/legal-translation-in-uae/', 'legal translation')} where a document is not in an accepted language. We check every document against the zone’s checklist before submission.`;
---

<BaseLayout
  title="Free Zone Company Formation in Dubai | Index Office Services"
  description="Free zone company formation in Dubai handled end to end: zone selection, attested documents, licence, visas and bank account. Get a free quote."
>

<style>
  .sec-inner { position: relative; z-index: 1; }
  .idx-pill { background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.28); color: #fff; font-size: 0.78rem; padding: 5px 14px; border-radius: 9999px; font-weight: 500; white-space: nowrap; }
  .step-card { background: #fff; border: 1px solid #eef0f6; border-radius: 16px; padding: 22px; transition: all 0.25s; }
  .step-card:hover { border-color: #B2F5EA; box-shadow: 0 10px 24px rgba(56,178,172,0.08); }
  .route-card { background: #fff; border: 1px solid #eef0f6; border-radius: 16px; padding: 24px; transition: all 0.25s; }
  .route-card:hover { border-color: #B2F5EA; box-shadow: 0 10px 24px rgba(56,178,172,0.08); }
  .benefit-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px; }
  .gcc-link { display:flex; align-items:center; gap:12px; background:#fff; border:1px solid #eef0f6; border-radius:12px; padding:14px 18px; text-decoration:none; color:#1A202C; font-weight:700; font-size:0.9rem; transition: all 0.25s; }
  .gcc-link:hover { border-color:#38B2AC; box-shadow: 0 10px 24px rgba(56,178,172,0.12); transform: translateY(-2px); }
  .cmp-wrap { overflow-x: auto; border-radius: 16px; border: 1px solid #eef0f6; background: #fff; }
  .cmp-table { width: 100%; border-collapse: collapse; min-width: 640px; }
  .cmp-table th { background: #2D3748; color: #fff; font-size: 0.85rem; font-weight: 800; text-align: left; padding: 14px 18px; }
  .cmp-table th:first-child { background: #1A202C; }
  .cmp-table td { padding: 14px 18px; font-size: 0.88rem; color: #4B5563; line-height: 1.55; border-top: 1px solid #eef0f6; vertical-align: top; }
  .cmp-table td:first-child { font-weight: 800; color: #1A202C; background: #F0FFFE; }
  .faq-item { border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden; }
  .faq-q { width: 100%; background: #fff; border: none; text-align: left; padding: 18px 20px; font-size: 0.9rem; font-weight: 600; color: #1A202C; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .faq-a { padding: 0 20px; max-height: 0; overflow: hidden; transition: max-height 0.35s ease, padding 0.2s; }
  .faq-a.open { max-height: 320px; padding: 0 20px 16px; }
  .faq-icon { font-size: 1.1rem; transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-icon { transform: rotate(45deg); }

  .split-grid { display: grid !important; }
  .three-col { display: grid !important; }
  .two-col { display: grid !important; }

  @media(max-width:768px){
    .hero-title { font-size: 2rem !important; }
    .split-grid { grid-template-columns: 1fr !important; gap: 32px !important; }
    .three-col { grid-template-columns: 1fr !important; }
    .two-col { grid-template-columns: 1fr !important; }
    .hero-btns { flex-direction: column !important; align-items: stretch !important; }
    .hero-btns a { text-align: center; justify-content: center; }
  }
</style>

<!-- ════════════ HERO ════════════ -->
<section style="position:relative;overflow:hidden;min-height:500px;display:flex;align-items:center;">
  <img src="/images/img-16.webp" alt="Free zone company formation in Dubai" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%;display:block;" loading="eager" fetchpriority="high" width="1200" height="600" />
  <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(26,32,44,0.92) 0%,rgba(45,55,72,0.80) 100%);"></div>
  <div style="position:absolute;inset:0;background-image:radial-gradient(rgba(56,178,172,0.18) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:880px;margin:0 auto;padding:96px 24px;text-align:center;width:100%;">
    <div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:18px;">
      {stats.map(s => <span class="idx-pill">{s}</span>)}
    </div>
    <h1 class="hero-title" style="font-size:clamp(2rem,4vw,3.2rem);font-weight:900;color:#fff;line-height:1.15;margin:0 0 20px;">Free Zone Company Formation in Dubai</h1>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 32px;max-width:700px;">
      Free zone company formation in Dubai gives you a UAE licence, premises and residence visas with 100% foreign ownership. A free zone company is licensed by a free zone authority rather than the mainland licensing department, which also sets it apart from an offshore company. Index Office Services manages the entire setup, from zone selection and document attestation to your licence, visas and bank account.
    </p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;" class="hero-btns">
      <a href={WHATSAPP} style="display:inline-flex;align-items:center;gap:8px;background:#38B2AC;color:#fff;font-weight:700;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none;box-shadow:0 4px 20px rgba(56,178,172,0.4);">WhatsApp Us Now - 971 525 245 208</a>
      <a href="#details" style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.3);color:#fff;font-weight:600;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none;">Learn More</a>
    </div>
  </div>
</section>

<!-- ════ SERVICES + BENEFITS ════ -->
<section id="details" style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner split-grid" style="max-width:1280px;margin:0 auto;grid-template-columns:1.2fr 1fr;gap:52px;align-items:center;">
    <div>
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;display:flex;align-items:center;gap:8px;margin-bottom:12px;">
        <span style="display:inline-block;width:28px;height:1px;background:#2D3748;"></span>Service Overview
      </p>
      <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);font-weight:900;color:#1A202C;line-height:1.2;margin:0 0 18px;">Our Free Zone Company Setup Services in Dubai</h2>
      <p style="color:#2D3748;font-size:0.82rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;margin:0 0 10px;">We manage your entire free zone business setup in Dubai:</p>
      <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:24px;">
        {services.map(item => (
          <div style="display:flex;align-items:flex-start;gap:12px;background:#F8FAFF;border:1px solid #eef0f6;border-radius:10px;padding:10px 14px;">
            <span style="color:#38B2AC;font-weight:bold;font-size:1rem;flex-shrink:0;">→</span>
            <p style="font-size:0.88rem;color:#374151;line-height:1.5;margin:0;">{item}</p>
          </div>
        ))}
      </div>
      <p style="color:#2D3748;font-size:0.82rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;margin:0 0 10px;">Benefits of a Free Zone Company in Dubai</p>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.7;margin:0 0 10px;">Businesses choose a free zone in Dubai for:</p>
      <div style="display:flex;flex-direction:column;gap:8px;">
        {benefits.map(item => (
          <div style="display:flex;align-items:flex-start;gap:12px;background:#F0FFFE;border:1px solid #B2F5EA;border-radius:10px;padding:10px 14px;">
            <span style="color:#38B2AC;font-weight:bold;font-size:1rem;flex-shrink:0;margin-top:1px;">✓</span>
            <p style="font-size:0.88rem;color:#374151;line-height:1.5;margin:0;">{item}</p>
          </div>
        ))}
      </div>
    </div>

    <div>
      <div style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 12px 40px rgba(0,0,0,0.12);">
        <img src="/images/img-1.webp" alt="Free zone company setup services in Dubai" style="width:100%;height:560px;object-fit:cover;display:block;" loading="lazy" width="400" height="260" />
        <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(26,32,44,0.72) 100%);"></div>
        <div style="position:absolute;bottom:20px;left:20px;right:20px;">
          <p style="color:#fff;font-size:0.9rem;font-weight:800;margin:0 0 4px;">Zone · Licence · Visas · Bank Account</p>
          <p style="color:#B2F5EA;font-size:0.75rem;margin:0;">Complete free zone setup handled end-to-end</p>
        </div>
        <div style="position:absolute;bottom:90px;left:-14px;background:#2D3748;color:#fff;padding:10px 16px;border-radius:10px;font-size:0.75rem;font-weight:700;box-shadow:0 6px 20px rgba(0,0,0,0.2);">
          2,500+ Companies Formed
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ════ FREE ZONE VS MAINLAND VS OFFSHORE ════ -->
<section style="background:#F0FFFE;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:44px 44px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1100px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:36px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Compare Your Options</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0;">Free Zone, Mainland or Offshore?</h2>
    </div>

    <div class="cmp-wrap" style="margin-bottom:24px;">
      <table class="cmp-table">
        <thead>
          <tr>
            <th></th>
            {compareCols.map(c => <th>{c}</th>)}
          </tr>
        </thead>
        <tbody>
          {compareRows.map(r => (
            <tr>
              <td>{r.label}</td>
              {r.vals.map(v => <td>{v}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p style="color:#4B5563;font-size:0.92rem;line-height:1.8;margin:0 0 24px;">
      Many free zone companies can invoice mainland clients, but physical retail or a mainland location needs a dual or mainland licence. We test this against your customer base before you pay for a licence. If the mainland suits you better, we arrange a mainland business setup in Dubai instead.
    </p>

    <div class="two-col" style="grid-template-columns:1fr 1fr;gap:24px;">
      <div class="route-card">
        <h3 style="font-size:0.95rem;font-weight:800;color:#1A202C;margin:0 0 14px;border-left:3px solid #38B2AC;padding-left:12px;">A free zone usually suits you if:</h3>
        <div style="display:flex;flex-direction:column;gap:9px;">
          {suitsYou.map(f => (
            <div style="display:flex;align-items:flex-start;gap:10px;font-size:0.9rem;color:#4B5563;line-height:1.5;">
              <span style="color:#38B2AC;font-weight:bold;flex-shrink:0;">✓</span>{f}
            </div>
          ))}
        </div>
      </div>
      <div class="route-card" style="background:#FFF5F5;border-color:#FED7D7;">
        <h3 style="font-size:0.95rem;font-weight:800;color:#1A202C;margin:0 0 14px;border-left:3px solid #E53E3E;padding-left:12px;">When mainland fits better</h3>
        <p style="font-size:0.9rem;color:#4B5563;line-height:1.7;margin:0;">If most of your clients are UAE businesses or consumers, mainland usually fits better. We review your revenue mix before you commit.</p>
      </div>
    </div>
  </div>
</section>

<!-- ════ WHICH FREE ZONE ════ -->
<section style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1200px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:40px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Choose the Right Zone</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">Which Free Zone Is Right for Your Activity?</h2>
      <p style="color:#4B5563;font-size:0.95rem;line-height:1.75;margin:0 auto;max-width:720px;">
        The UAE has around 40 free zones, and each issues licences only for the sectors it was built around. Matching your activity to the right zone is the first decision.
      </p>
    </div>

    <div class="three-col" style="grid-template-columns:repeat(4,1fr);gap:16px;">
      {zones.map(z => (
        <div class="step-card">
          <h3 style="font-size:0.95rem;font-weight:800;color:#1A202C;margin:0 0 4px;border-left:3px solid #38B2AC;padding-left:10px;">{z.zone}</h3>
          <p style="font-size:0.72rem;font-weight:700;color:#38B2AC;text-transform:uppercase;letter-spacing:0.1em;margin:10px 0 6px;">Best known for</p>
          <p style="font-size:0.85rem;color:#6B7280;line-height:1.6;margin:0;">{z.best}</p>
        </div>
      ))}
    </div>

    <p style="color:#6B7280;font-size:0.85rem;line-height:1.7;text-align:center;margin:28px 0 0;">
      Visa quotas, activity lists and fees differ by zone and change often. We confirm current terms before you commit.
    </p>
  </div>
</section>

<!-- ════ STRUCTURES ════ -->
<section style="background:#F0FFFE;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:44px 44px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1100px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:40px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Legal Structure</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0;">Company Structures We Register</h2>
    </div>

    <div class="three-col" style="grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:24px;">
      {structures.map((s, i) => (
        <div class="step-card">
          <div style="width:42px;height:42px;border-radius:10px;background:#2D3748;color:#38B2AC;font-weight:900;font-size:1rem;display:flex;align-items:center;justify-content:center;margin-bottom:14px;">0{i + 1}</div>
