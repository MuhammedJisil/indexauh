---
import ContactForm from '../components/ContactForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro'

const scopeMatch = [
  "The company's actual requirements",
  "The signatory's authority within the company",
  "The specific transaction involved",
]

const whenNeeded = [
  { icon: "🏢", label: "Company formation and registration" },
  { icon: "🏛️", label: "Government or licensing transactions" },
  { icon: "🏦", label: "Banking matters" },
  { icon: "📈", label: "Share transfers" },
  { icon: "🏠", label: "Property or asset transactions" },
  { icon: "⚖️", label: "Legal representation" },
  { icon: "✍️", label: "Contract and document signing" },
  { icon: "🔒", label: "Company closure or liquidation" },
]

const poaTypes = [
  { title: "Company Formation POA", desc: "Supports incorporation and registration procedures" },
  { title: "Business Management POA", desc: "Covers specified operational and administrative matters" },
  { title: "Banking POA", desc: "Authorises defined banking transactions" },
  { title: "Share Transfer POA", desc: "Authorises specific share related actions" },
  { title: "Commercial Licence POA", desc: "Supports licensing and government procedures" },
  { title: "Legal Representation POA", desc: "Authorises representation before specified authorities" },
  { title: "Property or Asset POA", desc: "Covers defined transactions involving company property" },
  { title: "Specific Transaction POA", desc: "Covers one particular task or deal" },
]

const powersList = [
  "Represent the company before government authorities",
  "Submit and collect company documents",
  "Handle licence related procedures",
  "Sign specified business documents",
  "Manage defined banking matters",
  "Complete company formation steps",
  "Finalise specific share or asset transactions",
  "Represent the company in defined legal matters",
]

const generalVsSpecific = [
  { title: "General POA", icon: "📋", items: ["Covers a broader range of business activities", "Works well for ongoing administration"] },
  { title: "Specific POA", icon: "🎯", items: ["Limits authority to one transaction or purpose", "Fits situations like a share transfer or a single government procedure"] },
]

const signatories = ["The owner", "A director", "An authorised signatory", "A shareholder or partner, in some structures"]
const authorityRecords = ["The trade licence", "The MOA", "A board or shareholder resolution, where required"]

const docsRequired = [
  "Valid trade or commercial licence",
  "MOA or constitutional documents",
  "Board or shareholder resolution, where applicable",
  "Passport and Emirates ID of the authorised signatory",
  "Passport and Emirates ID of the appointed representative",
  "Shareholder or partner details, where required",
  "Draft corporate POA",
  "Documents related to the intended transaction",
]

const getSteps = [
  { step: "01", title: "Contact our team", desc: "Share the purpose of the POA and basic company details." },
  { step: "02", title: "Submit your documents", desc: "Send the company and identification paperwork we confirm with you." },
  { step: "03", title: "Drafting and review", desc: "Our team prepares the wording, or checks yours, based on the required authority." },
  { step: "04", title: "Notarisation", desc: "We coordinate the notarisation process on your behalf." },
  { step: "05", title: "Attestation and legalisation", desc: "For documents needing further authentication, we handle this step too." },
  { step: "06", title: "Delivery", desc: "You receive the completed document through your preferred method." },
]

const overseasSituations = [
  "A shareholder who cannot travel to the UAE",
  "An overseas parent company authorising a local representative",
  "A foreign director appointing someone to complete UAE procedures",
  "A POA issued abroad that needs authentication for UAE use",
]

const commonMistakes = [
  "Vague or overly broad wording",
  "Powers the signatory cannot legally delegate",
  "Company details that don't match official records",
  "Missing supporting documents",
  "A POA that doesn't cover the actual transaction needed",
  "Outdated wording from an old template",
  "Skipped notarisation or attestation steps",
  "Translation errors in bilingual documents",
]

const whyChoose = [
  "25+ years of experience handling company documentation and attestation across the region",
  "200+ professionals working across drafting, notarisation and legalisation",
  "Support in 100+ countries, useful for companies with overseas shareholders or directors",
  "End to end service, from drafting through delivery, so you're not coordinating five separate vendors",
  "Certified translation support for documents that need it",
  "Pickup and delivery, so your team doesn't lose time on office visits",
]

const faqs = [
  { q: "Can a foreign company issue a corporate POA for use in the UAE?", a: "Yes, in most cases. The document usually needs authentication in the country of issue before it works in the UAE. Our team confirms the exact route for your specific country." },
  { q: "Does a corporate POA need notarisation in the UAE?", a: "Most corporate POAs require notarisation. Some transactions also need attestation or legalisation, depending on where the document is going and who's requesting it." },
  { q: "Can a corporate POA be used for banking transactions?", a: "Yes, when it's drafted with that specific authority. A general POA without clear banking language often gets rejected at the bank." },
  { q: "How long does a corporate power of attorney stay valid?", a: "Validity depends on the wording of the document itself. Some POAs include an expiry date. Others remain valid until revoked or replaced." },
  { q: "Can an existing corporate POA be changed or revoked?", a: "Yes. A company can revoke or replace a POA at any time, following the correct legal procedure. Our team can guide you through this process." },
]
---

<BaseLayout
  title="Corporate Power of Attorney UAE | Index Office Services"
  description="Draft, notarise and attest your corporate power of attorney in the UAE with a team that has 25+ years of experience across 100+ countries. Get started today."
>

<style>
  .sec-inner { position: relative; z-index: 1; }
  .in-link { color: #fff; font-weight: 700; text-decoration: underline; text-decoration-color: #38B2AC; text-underline-offset: 3px; transition: color 0.2s; }
  .in-link:hover { color: #38B2AC; }
  .in-link-dark { color: #1A202C; font-weight: 700; text-decoration: underline; text-decoration-color: #38B2AC; text-underline-offset: 3px; transition: color 0.2s; }
  .in-link-dark:hover { color: #38B2AC; }
  .step-card { display: flex; align-items: flex-start; gap: 16px; background: #fff; border: 1px solid #eef0f6; border-radius: 14px; padding: 18px; transition: all 0.25s; }
  .step-card:hover { border-color: #B2F5EA; box-shadow: 0 10px 24px rgba(56,178,172,0.08); }
  .benefit-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px; }
  .poa-type-card { background: #F8FAFF; border: 1px solid #eef0f6; border-radius: 16px; padding: 26px; transition: all 0.25s; }
  .poa-type-card:hover { border-color: #B2F5EA; box-shadow: 0 8px 24px rgba(56,178,172,0.08); }
  .area-chip { display: flex; align-items: center; gap: 12px; background: #fff; border: 1px solid #eef0f6; border-radius: 12px; padding: 14px 16px; font-size: 0.9rem; font-weight: 600; color: #1A202C; line-height: 1.5; transition: all 0.25s; }
  .area-chip:hover { border-color: #B2F5EA; box-shadow: 0 8px 20px rgba(56,178,172,0.08); }
  .faq-item { border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden; }
  .faq-q { width: 100%; background: #fff; border: none; text-align: left; padding: 18px 20px; font-size: 0.9rem; font-weight: 600; color: #1A202C; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .faq-a { padding: 0 20px; max-height: 0; overflow: hidden; transition: max-height 0.35s ease, padding 0.2s; }
  .faq-a.open { max-height: 320px; padding: 0 20px 16px; }
  .faq-icon { font-size: 1.1rem; transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-icon { transform: rotate(45deg); }

  .split-grid { display: grid !important; }
  .three-col { display: grid !important; }
  .two-col { display: grid !important; }
  .four-col { display: grid !important; }

  @media(max-width:768px){
    .hero-title { font-size: 2rem !important; }
    .split-grid { grid-template-columns: 1fr !important; gap: 32px !important; }
    .three-col { grid-template-columns: 1fr !important; }
    .two-col { grid-template-columns: 1fr !important; }
    .four-col { grid-template-columns: 1fr !important; }
    .img-first { order: -1 !important; }
    .hero-btns { flex-direction: column !important; align-items: stretch !important; }
    .hero-btns a { text-align: center; justify-content: center; }
  }
</style>

<!-- ════════════ HERO ════════════ -->
<section style="position:relative;overflow:hidden;min-height:500px;display:flex;align-items:center;">
  <img src="/images/img-16.webp" alt="Corporate Power of Attorney in UAE" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%;display:block;" loading="eager" fetchpriority="high" width="1200" height="600" />
  <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(26,32,44,0.92) 0%,rgba(45,55,72,0.80) 100%);"></div>
  <div style="position:absolute;inset:0;background-image:radial-gradient(rgba(56,178,172,0.18) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:880px;margin:0 auto;padding:96px 24px;text-align:center;width:100%;">
    <h1 class="hero-title" style="font-size:clamp(2rem,4vw,3.2rem);font-weight:900;color:#fff;line-height:1.15;margin:0 0 20px;">
      Corporate Power of Attorney in UAE
    </h1>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 20px;max-width:660px;">
      A corporate power of attorney lets a company authorise another person to act on its behalf. Directors use it. Shareholders use it. Business owners use it whenever they cannot handle a matter themselves.
    </p>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 20px;max-width:660px;">
      Index Office Services has supported companies with this process for over 25 years, across 100+ countries. Our team handles drafting, notarisation, attestation, legalisation and <a href="https://indexauh.com/legal-translation-in-uae/" class="in-link">certified translation</a>, so you deal with one team instead of five.
    </p>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 32px;max-width:660px;">
      Need a corporate power of attorney prepared correctly the first time? Talk to our team today.
    </p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;" class="hero-btns">
      <a href="#get-in-touch" style="display:inline-flex;align-items:center;gap:8px;background:#38B2AC;color:#fff;font-weight:700;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none;box-shadow:0 4px 20px rgba(56,178,172,0.4);">Get Started &rarr;</a>
      <a href="#details" style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.3);color:#fff;font-weight:600;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none;">Learn More</a>
    </div>
  </div>
</section>

<!-- ════ WHAT IS A CORPORATE POA ════ -->
<section id="details" style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner split-grid" style="max-width:1280px;margin:0 auto;grid-template-columns:1.2fr 1fr;gap:52px;align-items:center;">
    <div>
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;display:flex;align-items:center;gap:8px;margin-bottom:12px;">
        <span style="display:inline-block;width:28px;height:1px;background:#2D3748;"></span>Service Overview
      </p>
      <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);font-weight:900;color:#1A202C;line-height:1.2;margin:0 0 18px;">What Is a Corporate Power of Attorney?</h2>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">
        A corporate POA is a document where a company appoints someone to act on its behalf. The company is called the principal. The appointed person is the representative. This document does not hand over unlimited control. It only covers what the wording states.
      </p>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">The scope should match three things:</p>
      <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:20px;">
        {scopeMatch.map(item => (
          <div style="display:flex;align-items:flex-start;gap:12px;background:#F8FAFF;border:1px solid #eef0f6;border-radius:10px;padding:12px 16px;">
            <span style="color:#38B2AC;font-weight:bold;font-size:1rem;flex-shrink:0;margin-top:2px;">→</span>
            <p style="font-size:0.9rem;color:#374151;line-height:1.6;margin:0;">{item}</p>
          </div>
        ))}
      </div>
      <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:12px;padding:18px;">
        <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0;">
          A well drafted POA protects the company. A poorly drafted one creates delays, or worse, gets rejected outright.
        </p>
      </div>
    </div>

    <div>
      <div style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 12px 40px rgba(0,0,0,0.12);">
        <img src="/images/img-11.webp" alt="What is a corporate power of attorney" style="width:100%;height:460px;object-fit:cover;display:block;" loading="lazy" width="800" height="450" />
        <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(26,32,44,0.72) 100%);"></div>
        <div style="position:absolute;bottom:20px;left:20px;right:20px;">
          <p style="color:#fff;font-size:0.9rem;font-weight:800;margin:0 0 4px;">One Team, Every Stage</p>
          <p style="color:#B2F5EA;font-size:0.75rem;margin:0;">Drafting through delivery, handled end-to-end</p>
        </div>
        <div style="position:absolute;bottom:84px;left:-14px;background:#2D3748;color:#fff;padding:10px 16px;border-radius:10px;font-size:0.75rem;font-weight:700;box-shadow:0 6px 20px rgba(0,0,0,0.2);">
          25+ Years With Companies
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ════ WHEN DOES A COMPANY NEED ════ -->
<section style="background:#F8FAFF;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1280px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:44px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Common Cases</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">When Does a Company Need a Corporate POA?</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;max-width:700px;margin:0 auto;">
        Companies request this document for many reasons. Some situations are routine. Others come up once and need to move fast.
      </p>
    </div>

    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:28px;" class="four-col">
      {whenNeeded.map(a => (
        <div class="area-chip" style="padding:18px;">
          <span style="font-size:1.3rem;flex-shrink:0;">{a.icon}</span>{a.label}
        </div>
      ))}
    </div>

    <div style="background:#fff;border:1px solid #B2F5EA;border-radius:12px;padding:18px 22px;">
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0;">
        Each case calls for different wording. That's why the drafting step matters more than most business owners expect.
      </p>
    </div>
  </div>
</section>

<!-- ════ TYPES OF CORPORATE POA ════ -->
<section style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1280px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:44px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Not Every POA Does the Same Job</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">Types of Corporate Power of Attorney in the UAE</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;max-width:700px;margin:0 auto;">
        Here's a quick breakdown.
      </p>
    </div>

    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-bottom:28px;" class="four-col">
      {poaTypes.map(t => (
        <div class="poa-type-card" style="padding:20px;">
          <h3 style="font-size:0.92rem;font-weight:800;color:#1A202C;margin:0 0 8px;">{t.title}</h3>
          <p style="font-size:0.82rem;color:#6B7280;line-height:1.6;margin:0;">{t.desc}</p>
        </div>
      ))}
    </div>

    <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:12px;padding:18px 22px;">
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0;">
        These powers depend entirely on the wording used. No POA automatically includes every power on this list. The document only grants what it states, nothing more.
      </p>
    </div>
  </div>
</section>

<!-- ════ WHAT POWERS CAN IT INCLUDE ════ -->
<section style="background:#F0FFFE;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:44px 44px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner split-grid" style="max-width:1200px;margin:0 auto;grid-template-columns:1fr 1.2fr;gap:48px;align-items:center;">
    <div class="img-first" style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,0.1);">
      <img src="/images/img-7.webp" alt="Powers a corporate power of attorney can include" style="width:100%;height:520px;object-fit:cover;display:block;" loading="lazy" width="800" height="450" />
      <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(26,32,44,0.7) 100%);"></div>
      <div style="position:absolute;bottom:16px;left:16px;right:16px;">
        <p style="color:#fff;font-size:0.98rem;font-weight:800;margin:0;">Wording That Matches Your Records</p>
      </div>
    </div>

    <div>
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Scope of Authority</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">What Powers Can a Corporate POA Include?</h2>
      <p style="color:#4B5563;font-size:0.95rem;line-height:1.8;margin:0 0 16px;">A corporate POA can authorise a representative to:</p>
      <div style="background:#fff;border:1px solid #eef0f6;border-radius:16px;padding:24px;margin-bottom:18px;">
        <div style="display:flex;flex-direction:column;gap:10px;">
          {powersList.map(d => (
            <div style="display:flex;align-items:flex-start;gap:10px;font-size:0.9rem;color:#4B5563;line-height:1.5;">
              <span style="color:#38B2AC;font-weight:bold;flex-shrink:0;margin-top:2px;">→</span>{d}
            </div>
          ))}
        </div>
      </div>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin:0;">
        The wording needs to match the company's constitutional documents and the transaction at hand. Vague language causes more rejections than any other single issue we see.
      </p>
    </div>
  </div>
</section>

<!-- ════ GENERAL VS SPECIFIC ════ -->
<section style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1000px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:36px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Choosing the Right Format</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">General vs Specific Corporate Power of Attorney</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;max-width:750px;margin:0 auto;">
        Choosing between these two formats depends on what you need the representative to do.
      </p>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:24px;" class="two-col">
      {generalVsSpecific.map(g => (
        <div class="poa-type-card">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;">
            <span style="font-size:1.5rem;">{g.icon}</span>
            <h3 style="font-size:1.05rem;font-weight:800;color:#1A202C;margin:0;">{g.title}</h3>
          </div>
          <div style="display:flex;flex-direction:column;gap:8px;">
            {g.items.map(d => (
              <div style="display:flex;align-items:flex-start;gap:8px;font-size:0.88rem;color:#4B5563;line-height:1.5;">
                <span style="color:#38B2AC;font-weight:bold;flex-shrink:0;margin-top:2px;">•</span>{d}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:12px;padding:18px 22px;">
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0;">
        Neither format is better on its own. The right choice comes down to the task in front of you.
      </p>
    </div>
  </div>
</section>

<!-- ════ WHO CAN SIGN ════ -->
<section style="background:#F8FAFF;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1200px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:36px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Authority Chain</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">Who Can Sign a Corporate Power of Attorney?</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;max-width:750px;margin:0 auto;">
