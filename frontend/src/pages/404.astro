---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — Index Office Services"
  description="The page you're looking for doesn't exist."
>
  <section style="min-height: 70vh; display: flex; align-items: center; justify-content: center; padding: 80px 20px; background: #F7FAFC;">
    <div style="text-align: center; max-width: 560px;">
      <p style="font-size: 96px; font-weight: 900; color: #38B2AC; line-height: 1; margin: 0;">404</p>
      <h1 style="font-size: 32px; font-weight: 800; color: #1A202C; margin: 16px 0 12px;">
        Page Not Found
      </h1>
      <p style="font-size: 16px; color: #4A5568; margin-bottom: 32px; line-height: 1.6;">
        Sorry, the page you're looking for doesn't exist or may have been moved.
        Let's get you back on track.
      </p>
      <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
        <a
          href="/"
          style="background: #38B2AC; color: white; padding: 14px 28px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 15px;"
        >
          Back to Home
        </a>
        <a
          href="/certificate-attestation"
          style="background: white; color: #1A202C; padding: 14px 28px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 15px; border: 1.5px solid #CBD5E0;"
        >
          Our Services
        </a>
      </div>
    </div>
  </section>
</BaseLayout>