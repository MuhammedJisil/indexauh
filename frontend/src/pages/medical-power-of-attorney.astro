---
import ContactForm from '../components/ContactForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro'

const whenNeeded = [
  { icon: "🏥", label: "Expect a major medical procedure or surgery" },
  { icon: "🛏️", label: "May need extended hospital care" },
  { icon: "🤝", label: "Want a trusted person to handle specified healthcare matters" },
  { icon: "👨‍👩‍👧", label: "Live away from close family members" },
  { icon: "✈️", label: "Spend significant time outside the UAE" },
  { icon: "🗣️", label: "May become unable to communicate" },
  { icon: "🩺", label: "Want someone to communicate with healthcare providers on your behalf" },
]

const authorizes = [
  { icon: "💬", label: "Communication with doctors and healthcare providers" },
  { icon: "📋", label: "Specified treatment related decisions" },
  { icon: "✅", label: "Consent for specified medical procedures" },
  { icon: "🔐", label: "Access to medical information where authorised" },
  { icon: "🏢", label: "Certain hospital administration matters" },
  { icon: "🎯", label: "Representation for clearly stated healthcare matters" },
]

const requirements = [
  "Passport or Emirates ID details",
  "Full details of the person granting the POA",
  "Full details of the appointed representative",
  "Clear wording describing the authority granted",
  "Supporting documents related to the intended purpose",
  "Arabic or certified translation where required",
  "Notarisation through the applicable authority",
  "Further attestation or legalisation for documents issued outside the UAE",
]

const getSteps = [
  { step: "01", title: "Share your requirements", desc: "Contact Index Office Services and explain the purpose of the Medical Power of Attorney. Provide details of both parties." },
  { step: "02", title: "Submit the documents", desc: "Share the required identification documents and relevant supporting information. The team reviews the details before preparing the document." },
  { step: "03", title: "Draft the POA", desc: "The document is prepared according to the authority you want to grant. The wording should clearly state the representative's powers." },
  { step: "04", title: "Review the document", desc: "Check the names, identification details and powers stated in the POA before proceeding with notarisation." },
  { step: "05", title: "Complete notarisation", desc: "Index Office Services assists with the applicable notarisation process. The UAE Ministry of Justice also provides digital services for eligible powers of attorney." },
  { step: "06", title: "Complete further authentication", desc: "Some documents need attestation or legalisation after notarisation. The required route depends on the document and its intended use." },
  { step: "07", title: "Receive the completed document", desc: "Once the required stages are completed, the final document can be collected or delivered through the available arrangements." },
]

const services = [
  "Power of Attorney drafting",
  "Document preparation",
  "Notarisation",
  "Attestation",
  "Legalisation",
  "Certified translation",
  "Document processing",
  "Coordination with relevant authorities",
  "Pickup and delivery arrangements where applicable",
]

const stats = [
  { num: "25+", label: "Years of experience" },
  { num: "100+", label: "Countries supported" },
]

const faqs = [
  { q: "Can I choose the person who receives the medical authority?", a: "The person granting the POA can nominate a representative. The appointed person's details should appear correctly in the document." },
  { q: "Can the POA cover only specific medical matters?", a: "Yes. The document can be drafted around the authority required for its intended purpose. Clear wording helps define the representative's role." },
  { q: "Can a Medical POA be prepared for a limited period?", a: "A POA can state a specific duration where the applicable format permits it. The UAE Ministry of Justice's POA documentation system includes options for specified periods in applicable forms." },
  { q: "Can someone outside the UAE arrange a Power of Attorney?", a: "Certain UAE digital POA services allow eligible customers residing outside the country to complete transactions remotely. The available route depends on the type of POA and applicable requirements." },
  { q: "Can a Medical POA include more than one representative?", a: "The structure of the document depends on the intended authority and applicable POA requirements. The drafting stage should clearly state how the representatives are expected to act." },
  { q: "Does the appointed person become responsible for every medical decision?", a: "No. The authority depends on the powers stated in the document and the rules applicable to the medical situation. The receiving healthcare provider may also apply its own requirements." },
]
---

<BaseLayout
  title="Medical Power of Attorney in UAE | Index Office Services"
  description="Need a Medical Power of Attorney in the UAE? Index Office Services assists with drafting, notarisation and attestation backed by 25+ years of experience."
>

<style>
  .sec-inner { position: relative; z-index: 1; }
  .in-link { color: #fff; font-weight: 700; text-decoration: underline; text-decoration-color: #38B2AC; text-underline-offset: 3px; transition: color 0.2s; }
  .in-link:hover { color: #38B2AC; }
  .step-card { display: flex; align-items: flex-start; gap: 16px; background: #fff; border: 1px solid #eef0f6; border-radius: 14px; padding: 18px; transition: all 0.25s; }
  .step-card:hover { border-color: #B2F5EA; box-shadow: 0 10px 24px rgba(56,178,172,0.08); }
  .benefit-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px; }
  .area-chip { display: flex; align-items: center; gap: 12px; background: #fff; border: 1px solid #eef0f6; border-radius: 12px; padding: 14px 16px; font-size: 0.9rem; font-weight: 600; color: #1A202C; line-height: 1.5; transition: all 0.25s; }
  .area-chip:hover { border-color: #B2F5EA; box-shadow: 0 8px 20px rgba(56,178,172,0.08); }
  .faq-item { border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden; }
  .faq-q { width: 100%; background: #fff; border: none; text-align: left; padding: 18px 20px; font-size: 0.9rem; font-weight: 600; color: #1A202C; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .faq-a { padding: 0 20px; max-height: 0; overflow: hidden; transition: max-height 0.35s ease, padding 0.2s; }
  .faq-a.open { max-height: 320px; padding: 0 20px 16px; }
  .faq-icon { font-size: 1.1rem; transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-icon { transform: rotate(45deg); }

  .split-grid { display: grid !important; }
  .three-col { display: grid !important; }
  .two-col { display: grid !important; }
  .four-col { display: grid !important; }

  @media(max-width:768px){
    .hero-title { font-size: 2rem !important; }
    .split-grid { grid-template-columns: 1fr !important; gap: 32px !important; }
    .three-col { grid-template-columns: 1fr !important; }
    .two-col { grid-template-columns: 1fr !important; }
    .four-col { grid-template-columns: 1fr !important; }
    .img-first { order: -1 !important; }
    .hero-btns { flex-direction: column !important; align-items: stretch !important; }
    .hero-btns a { text-align: center; justify-content: center; }
  }
</style>

<!-- ════════════ HERO ════════════ -->
<section style="position:relative;overflow:hidden;min-height:500px;display:flex;align-items:center;">
  <img src="/images/img-16.webp" alt="Medical Power of Attorney in UAE" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%;display:block;" loading="eager" fetchpriority="high" width="1200" height="600" />
  <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(26,32,44,0.92) 0%,rgba(45,55,72,0.80) 100%);"></div>
  <div style="position:absolute;inset:0;background-image:radial-gradient(rgba(56,178,172,0.18) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:880px;margin:0 auto;padding:96px 24px;text-align:center;width:100%;">
    <h1 class="hero-title" style="font-size:clamp(2rem,4vw,3.2rem);font-weight:900;color:#fff;line-height:1.15;margin:0 0 20px;">
      Medical Power of Attorney in UAE | Index Office Services
    </h1>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 20px;max-width:660px;">
      A Medical Power of Attorney allows you to appoint a trusted person to handle specified healthcare matters on your behalf when you cannot act or communicate yourself. It can be useful during hospitalisation, surgery, serious illness or other situations that affect your ability to make decisions.
    </p>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 20px;max-width:660px;">
      The authority given to the appointed person depends on the wording of the document and the applicable UAE requirements. A clearly drafted POA can state the matters the representative is authorised to handle.
    </p>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 32px;max-width:660px;">
      Index Office Services assists with Medical Power of Attorney requirements in the UAE, including drafting, notarisation, attestation, legalisation and <a href="https://indexauh.com/legal-translation-in-uae/" class="in-link">certified translation</a>.
    </p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;" class="hero-btns">
      <a href="#get-in-touch" style="display:inline-flex;align-items:center;gap:8px;background:#38B2AC;color:#fff;font-weight:700;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none;box-shadow:0 4px 20px rgba(56,178,172,0.4);">Get Started &rarr;</a>
      <a href="#details" style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.3);color:#fff;font-weight:600;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none;">Learn More</a>
    </div>
  </div>
</section>

<!-- ════ WHEN DO YOU NEED ════ -->
<section id="details" style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner split-grid" style="max-width:1280px;margin:0 auto;grid-template-columns:1.2fr 1fr;gap:52px;align-items:center;">
    <div>
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;display:flex;align-items:center;gap:8px;margin-bottom:12px;">
        <span style="display:inline-block;width:28px;height:1px;background:#2D3748;"></span>Service Overview
      </p>
      <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);font-weight:900;color:#1A202C;line-height:1.2;margin:0 0 18px;">When Do You Need a Medical Power of Attorney?</h2>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">
        Medical situations can happen unexpectedly. Preparing a POA in advance can help you arrange representation for specific healthcare matters.
      </p>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.8;margin-bottom:14px;">You may consider one when you:</p>
      <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:20px;">
        {whenNeeded.map(a => (
          <div class="area-chip" style="background:#F8FAFF;">
            <span style="font-size:1.2rem;flex-shrink:0;">{a.icon}</span>{a.label}
          </div>
        ))}
      </div>
      <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:12px;padding:18px;">
        <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0 0 8px;">
          For example, an individual living abroad may appoint a family member in the UAE for specific medical matters. The document can set out the authority granted to that person.
        </p>
        <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0;">
          The purpose should remain clear from the beginning. This helps ensure the document reflects the actual need instead of granting broader powers than intended.
        </p>
      </div>
    </div>

    <div>
      <div style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 12px 40px rgba(0,0,0,0.12);">
        <img src="/images/img-11.webp" alt="When do you need a medical power of attorney" style="width:100%;height:460px;object-fit:cover;display:block;" loading="lazy" width="800" height="450" />
        <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(26,32,44,0.72) 100%);"></div>
        <div style="position:absolute;bottom:20px;left:20px;right:20px;">
          <p style="color:#fff;font-size:0.9rem;font-weight:800;margin:0 0 4px;">Prepare Before You Need It</p>
          <p style="color:#B2F5EA;font-size:0.75rem;margin:0;">Representation for specific healthcare matters</p>
        </div>
        <div style="position:absolute;bottom:84px;left:-14px;background:#2D3748;color:#fff;padding:10px 16px;border-radius:10px;font-size:0.75rem;font-weight:700;box-shadow:0 6px 20px rgba(0,0,0,0.2);">
          25+ Years of Experience
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ════ WHAT CAN IT AUTHORIZE ════ -->
<section style="background:#F8FAFF;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1200px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:44px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Scope of Authority</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">What Can a Medical Power of Attorney Authorize?</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;max-width:700px;margin:0 auto 10px;">
        The authority granted through a Medical Power of Attorney depends on its wording. Therefore, the document should clearly identify the matters the representative can handle.
      </p>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;max-width:700px;margin:0 auto;">
        Depending on the purpose, it may cover:
      </p>
    </div>

    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:28px;" class="three-col">
      {authorizes.map(a => (
        <div class="area-chip" style="padding:20px;">
          <span style="font-size:1.4rem;flex-shrink:0;">{a.icon}</span>{a.label}
        </div>
      ))}
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;" class="two-col">
      <div style="background:#fff;border:1px solid #eef0f6;border-radius:14px;padding:22px 26px;">
        <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0;">
          The scope should match the person's requirements. A Medical POA does not automatically provide unlimited authority over every healthcare decision.
        </p>
      </div>
      <div style="background:#fff;border:1px solid #B2F5EA;border-radius:14px;padding:22px 26px;display:flex;align-items:flex-start;gap:14px;">
        <span style="font-size:1.3rem;flex-shrink:0;">⚠️</span>
        <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0;">
          UAE legislation also contains specific provisions concerning consent for medical procedures when an adult patient cannot provide consent personally. Therefore, the wording of a POA should not be treated as a substitute for applicable medical consent rules.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ════ REQUIREMENTS ════ -->
<section style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner split-grid" style="max-width:1200px;margin:0 auto;grid-template-columns:1fr 1.2fr;gap:48px;align-items:center;">
    <div class="img-first" style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,0.1);">
      <img src="/images/img-1.webp" alt="Medical power of attorney requirements in UAE" style="width:100%;height:520px;object-fit:cover;display:block;" loading="lazy" width="800" height="450" />
      <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(26,32,44,0.7) 100%);"></div>
      <div style="position:absolute;bottom:16px;left:16px;right:16px;">
        <p style="color:#fff;font-size:0.98rem;font-weight:800;margin:0;">Correct Identification Details Matter</p>
      </div>
    </div>

    <div>
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Requirements</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0 0 14px;">Medical Power of Attorney Requirements in UAE</h2>
      <p style="color:#4B5563;font-size:0.95rem;line-height:1.8;margin:0 0 12px;">
        The documents needed can vary based on the parties, the type of POA and its intended use. Correct identification details are particularly important during preparation.
      </p>
      <p style="color:#4B5563;font-size:0.95rem;line-height:1.8;margin:0 0 16px;">
        Common requirements can include:
      </p>
      <div style="background:#F8FAFF;border:1px solid #eef0f6;border-radius:16px;padding:24px;margin-bottom:18px;">
        <div style="display:flex;flex-direction:column;gap:10px;">
          {requirements.map(d => (
            <div style="display:flex;align-items:flex-start;gap:10px;font-size:0.9rem;color:#4B5563;line-height:1.5;">
              <span style="color:#38B2AC;font-weight:bold;flex-shrink:0;margin-top:2px;">→</span>{d}
            </div>
          ))}
        </div>
      </div>
      <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:12px;padding:18px;">
        <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0 0 8px;">
          The UAE Ministry of Justice provides services for writing and authenticating contracts and deeds, including powers of attorney. Its current process includes electronic application, payment and electronic receipt for eligible services.
        </p>
        <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0;">
          Documents issued outside the UAE may require additional authentication before use. The exact route depends on the country of issue and the authority receiving the document.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ════ HOW TO GET ════ -->
<section style="background:#F0FFFE;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:44px 44px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1200px;margin:0 auto;">
    <div style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,0.1);margin-bottom:40px;">
      <img src="/images/img-7.webp" alt="How to get a medical power of attorney in UAE" style="width:100%;height:240px;object-fit:cover;object-position:center 35%;display:block;" loading="lazy" width="800" height="450" />
      <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(26,32,44,0.88) 0%,rgba(26,32,44,0.5) 55%,transparent 100%);"></div>
      <div style="position:absolute;top:50%;left:40px;transform:translateY(-50%);">
        <p style="color:#38B2AC;font-weight:700;font-size:0.75rem;letter-spacing:0.12em;text-transform:uppercase;margin:0 0 6px;">Step-by-Step</p>
        <h2 style="color:#fff;font-size:clamp(1.4rem,2.5vw,2rem);font-weight:900;margin:0;max-width:520px;line-height:1.25;">How to Get a Medical Power of Attorney in UAE</h2>
      </div>
    </div>

    <p style="color:#4B5563;font-size:0.95rem;line-height:1.8;margin:0 0 24px;">
      The process starts with identifying the purpose of the POA and the authority you want to grant.
    </p>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;" class="two-col">
      {getSteps.map(s => (
        <div class="step-card">
          <div style="width:42px;height:42px;border-radius:10px;background:#2D3748;color:#38B2AC;font-weight:900;font-size:1rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;">{s.step}</div>
          <div>
            <p style="font-size:1.05rem;font-weight:700;color:#1A202C;margin:0 0 4px;">{s.title}</p>
            <p style="font-size:0.9rem;color:#6B7280;line-height:1.6;margin:0;">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ════ EXPATS & OVERSEAS ════ -->
<section style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1000px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:36px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Overseas Use</p>
      <h2 style="font-size:2rem;font-weight:900;color:#1A202C;margin:0;">Medical Power of Attorney for Expats and Overseas Clients</h2>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;" class="two-col">
      <div style="background:#F8FAFF;border:1px solid #eef0f6;border-radius:16px;padding:26px;">
        <div style="font-size:1.5rem;margin-bottom:10px;">🌍</div>
        <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0 0 10px;">
          Expats may have healthcare arrangements that involve family members living in another country. Overseas clients may also need to prepare documentation connected with their affairs in the UAE.
        </p>
        <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0;">
          A Medical Power of Attorney can help establish representation for specific healthcare matters. The process can vary based on where the document is prepared and where it will be used.
        </p>
      </div>
      <div style="background:#F8FAFF;border:1px solid #eef0f6;border-radius:16px;padding:26px;">
        <div style="font-size:1.5rem;margin-bottom:10px;">📑</div>
        <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0;">
          For documents prepared outside the UAE, additional authentication may apply before the document reaches the UAE. Translation can also become necessary when the document does not meet the language requirements of the receiving authority.
        </p>
      </div>
    </div>

    <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:14px;padding:22px 26px;">
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0 0 8px;">
        The UAE Ministry of Justice has introduced digital POA services that allow eligible customers residing inside or outside the UAE to complete certain POA transactions remotely.
      </p>
      <p style="color:#4B5563;font-size:0.9rem;line-height:1.75;margin:0;">
        Index Office Services can assist with the documentation and coordination involved in such requirements.
      </p>
    </div>
  </div>
</section>

<!-- ════ CHANGE OR CANCEL ════ -->
<section style="background:#F8FAFF;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;"></div>

