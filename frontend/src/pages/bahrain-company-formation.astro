---
import ContactForm from '../components/ContactForm.astro';

import BaseLayout from '../layouts/BaseLayout.astro'

const stats = [
  { num: "25+", label: "Years of Experience" },
  { num: "400,000+", label: "Clients Served" },
  { num: "100+", label: "Countries Covered" },
  { num: "200+", label: "Attestation Professionals" },
]

const pathSteps = [
  "Activity review",
  "NPRA security clearance",
  "Name reservation",
  "Address registration",
  "Deed signing",
  "Bank account and capital deposit",
  "Commercial Registration",
]

const whoNeeds = [
  "Foreign founders who want full ownership in an eligible activity.",
  "UAE consultants who want a second base for regional clients.",
  "Existing companies that plan a Bahrain branch.",
  "Investors who need a company behind a residency application.",
  "Logistics and industrial firms that compare mainland and free zone options.",
]

const documents = [
  "Valid passport copies for every shareholder and director.",
  "Signed KYC form, engagement letter and authorization letter.",
  "Three proposed company names, ranked by preference.",
  "Proof of your business address, such as a lease or licensed virtual office.",
  "Bank statements and source of funds details, as your bank asks.",
  "Certificate of incorporation and board resolution for corporate shareholders.",
  "A notarized <a href=\"/corporate-power-of-attorney/\" style=\"color:#2D3748;text-decoration:underline;text-decoration-color:#38B2AC;text-underline-offset:3px;\">corporate power of attorney</a>, in case someone signs for you.",
  "A short business plan for the bank and visa stages.",
]

const steps = [
  { title: "Activity review", body: "We check ownership rules, approvals and the right structure." },
  { title: "Security clearance", body: "Shareholders and directors submit documents to the NPRA for background checks." },
  { title: "Name reservation", body: "We submit your three names through the Sijilat portal." },
  { title: "Address registration", body: "You pick an office, shared desk or licensed virtual office, as your activity allows." },
  { title: "Deed signing", body: "A notary attests the Memorandum and Articles of Association, and shareholders sign." },
  { title: "Bank account and capital deposit", body: "We prepare bank ready documents, but the bank decides on approval." },
  { title: "Commercial Registration", body: "MOIC issues your CR once approvals are complete." },
]

const timelineFactors = [
  "Business activity and any extra approvals.",
  "Shareholder profile and clearance results.",
  "Document quality, including attestation where needed.",
  "Bank choice and the bank review.",
  "Office address and lease readiness.",
]

const costFactors = [
  "Company type and number of shareholders.",
  "License and activity requirements.",
  "Government fees for your case.",
  "Office address term.",
  "Optional visa and VAT services.",
]

const mistakes = [
  "Wrong activity code, which triggers ownership limits or rejection.",
  "Expired passports or missing passport pages, which delay clearance.",
  "Three names that are spelling changes of one idea.",
  "Foreign corporate documents without proper attestation.",
  "Bank statements with unexplained deposits.",
  "An expired office lease after formation, which can suspend your CR.",
]

const whyChoose = [
  "Established in 2000, so our team knows where files stall.",
  "Dedicated compliance experts review your documents before filing.",
  "Real time updates show where your file stands.",
  "Doorstep pickup and delivery across the UAE saves you trips.",
  "Offices in Dubai and Abu Dhabi give you a place to meet us.",
]

const documentServices = [
  "<a href=\"/commercial-documents-attestation/\" style=\"color:#2D3748;text-decoration:underline;text-decoration-color:#38B2AC;text-underline-offset:3px;\">Commercial documents attestation</a> for corporate shareholders.",
  "<a href=\"/apostille-service-uae/\" style=\"color:#2D3748;text-decoration:underline;text-decoration-color:#38B2AC;text-underline-offset:3px;\">Apostille service</a> for documents from Hague Convention countries.",
  "<a href=\"/mofa-attestation-in-uae/\" style=\"color:#2D3748;text-decoration:underline;text-decoration-color:#38B2AC;text-underline-offset:3px;\">MOFA attestation in the UAE</a> for locally issued papers.",
  "<a href=\"/embassy-attestation-in-uae/\" style=\"color:#2D3748;text-decoration:underline;text-decoration-color:#38B2AC;text-underline-offset:3px;\">Embassy attestation</a> when the destination requires it, including <a href=\"/bahrain-embassy-attestation/\" style=\"color:#2D3748;text-decoration:underline;text-decoration-color:#38B2AC;text-underline-offset:3px;\">Bahrain embassy attestation</a>.",
  "<a href=\"/bahrain-certificate-attestation/\" style=\"color:#2D3748;text-decoration:underline;text-decoration-color:#38B2AC;text-underline-offset:3px;\">Bahrain certificate attestation</a> for personal and educational papers.",
  "<a href=\"/notary-attestation-services/\" style=\"color:#2D3748;text-decoration:underline;text-decoration-color:#38B2AC;text-underline-offset:3px;\">Notary attestation services</a> for deeds and resolutions.",
  "<a href=\"/power-of-attorney-notarization/\" style=\"color:#2D3748;text-decoration:underline;text-decoration-color:#38B2AC;text-underline-offset:3px;\">Power of attorney notarization</a> for remote signing.",
  "<a href=\"/legal-translation-in-uae/\" style=\"color:#2D3748;text-decoration:underline;text-decoration-color:#38B2AC;text-underline-offset:3px;\">Legal translation in the UAE</a> for Arabic or English filings.",
]

const faqs = [
  { q: "Can foreigners fully own a company in Bahrain?", a: "Many activities allow full foreign ownership. However, domestic trading and construction can need a Bahraini partner or share. Financial, healthcare and education activities also need sector approval. Rules differ by activity code, so we confirm your activity before you choose a structure or sign anything." },
  { q: "Do I need to be in Bahrain to register a company?", a: "Not always. Document preparation and filing can begin remotely. However, signing, bank onboarding and residency steps may need attendance or a power of attorney. The exact plan depends on your shareholders, activity and chosen bank, so we confirm it before you commit." },
  { q: "Does Bahrain charge income tax on companies?", a: "Most sectors pay no corporate or personal income tax. However, oil and gas companies and large multinationals face different rules. VAT also applies to local sales. Tax law changes, so check current National Bureau for Revenue guidance and your home country position before you decide." },
  { q: "How do I choose a company type?", a: "Most small and medium businesses choose a WLL for limited liability and flexible ownership. A branch suits an existing foreign company. Partnerships carry unlimited liability, so few foreign founders choose them. Joint stock companies fit large capital projects. We match the structure to your goals on the first call." },
  { q: "Can I get a residency visa through a Bahrain company?", a: "Owning a Bahraini company can support an investor visa application through the LMRA. However, formation and visa services are separate, and a valid CR comes first. Medical, biometric and attendance requirements depend on your case. We confirm them with you at the start." },
  { q: "What happens after my CR is issued?", a: "Renew your CR on time, and update shareholder and activity details as they change. Maintain accounting records, and register for VAT once your turnover requires it. Late renewals can bring penalties or CR deletion. Therefore, set reminders early. Banks and ministries can ask for these records at any time." },
]
---

<BaseLayout
  title="Bahrain Company Formation: Trusted UAE Experts"
  description="Plan your Bahrain company formation with Index Office Services. 25+ years, 400,000+ clients. Get a free quote today."
>

<style>
  .sec-inner { position: relative; z-index: 1; }
  .idx-pill { background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.28); color: #fff; font-size: 0.78rem; padding: 5px 14px; border-radius: 9999px; font-weight: 500; white-space: nowrap; }
  .step-chip { background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.25); color: #fff; font-size: 0.78rem; padding: 6px 14px; border-radius: 9999px; font-weight: 600; }
  .company-card { background: #fff; border: 1px solid #eef0f6; border-radius: 14px; padding: 24px; transition: all 0.25s; }
  .company-card:hover { border-color: #B2F5EA; box-shadow: 0 12px 32px rgba(56,178,172,0.08); }
  .btn-primary { display:inline-flex;align-items:center;gap:8px;background:#38B2AC;color:#fff;font-weight:700;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none;box-shadow:0 4px 20px rgba(56,178,172,0.4); }
  .btn-ghost { display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.3);color:#fff;font-weight:600;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none; }
  .btn-dark { display:inline-flex;align-items:center;gap:8px;background:#2D3748;color:#fff;font-weight:700;font-size:0.9rem;padding:13px 28px;border-radius:9999px;text-decoration:none; }
  .btn-dark:hover { background: #1A202C; }
  .faq-item { border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden; }
  .faq-q { width: 100%; background: #fff; border: none; text-align: left; padding: 18px 20px; font-size: 0.9rem; font-weight: 600; color: #1A202C; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .faq-a { padding: 0 20px; max-height: 0; overflow: hidden; transition: max-height 0.35s ease, padding 0.2s; }
  .faq-a.open { max-height: 300px; padding: 0 20px 16px; }
  .faq-icon { font-size: 1.1rem; transition: transform 0.3s; flex-shrink: 0; }
  .faq-item.open .faq-icon { transform: rotate(45deg); }
  @media(max-width:768px){
    .hero-title { font-size: 2rem !important; }
    .split-grid { grid-template-columns: 1fr !important; gap: 32px !important; }
    .three-col { grid-template-columns: 1fr !important; }
    .two-col { grid-template-columns: 1fr !important; }
    .stats-grid { grid-template-columns: repeat(2,1fr) !important; }
  }
</style>

<!-- ════════════ HERO ════════════ -->
<section style="position:relative;overflow:hidden;min-height:500px;display:flex;align-items:center;">
  <img src="/images/img-43.webp" alt="Bahrain Company Formation" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%;display:block;" loading="eager" fetchpriority="high" width="1200" height="600" />
  <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(26,32,44,0.92) 0%,rgba(45,55,72,0.80) 100%);"></div>
  <div style="position:absolute;inset:0;background-image:radial-gradient(rgba(56,178,172,0.18) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:880px;margin:0 auto;padding:96px 24px;text-align:center;width:100%;">
    <div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:18px;">
      {stats.map(s => <span class="idx-pill">{s.num} {s.label}</span>)}
    </div>
    <h1 class="hero-title" style="font-size:clamp(2rem,4vw,3.2rem);font-weight:900;color:#fff;line-height:1.15;margin:0 0 20px;">Bahrain Company Formation for Foreign Founders and UAE Investors</h1>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 14px;max-width:700px;">
      Bahrain company formation means registering a legal entity with the Ministry of Industry and Commerce through the Sijilat portal. Most founders start with a WLL, and foreign ownership is possible in many sectors.
    </p>
    <p style="color:#B2F5EA;font-size:1rem;line-height:1.8;margin:0 auto 24px;max-width:700px;">
      Rejected documents and unclear steps can stall your filing. We guide you through each stage, so your file stays complete and clear.
    </p>
    <p style="color:#fff;font-weight:700;font-size:0.8rem;letter-spacing:0.08em;text-transform:uppercase;margin:0 0 10px;">The path at a glance</p>
    <div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center;align-items:center;margin-bottom:32px;">
      {pathSteps.map((p, i) => (
        <>
          <span class="step-chip">{p}</span>
          {i < pathSteps.length - 1 && <span style="color:#38B2AC;font-weight:700;">&rarr;</span>}
        </>
      ))}
    </div>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
      <a href="#get-in-touch" class="btn-primary">Get a Free Quote &rarr;</a>
      <a href="https://wa.me/971529300200" class="btn-ghost">WhatsApp Us Now</a>
    </div>
    <p style="color:#B2F5EA;font-size:0.8rem;margin:18px 0 0;">Free consultation. Phone and WhatsApp support.</p>
  </div>
</section>

<!-- ════ WHO NEEDS ════ -->
<section id="details" style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner split-grid" style="max-width:1280px;margin:0 auto;display:grid;grid-template-columns:1.2fr 1fr;gap:52px;align-items:center;">
    <div>
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;display:flex;align-items:center;gap:8px;margin-bottom:12px;">
        <span style="display:inline-block;width:28px;height:1px;background:#2D3748;"></span>Overview
      </p>
      <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);font-weight:900;color:#1A202C;line-height:1.2;margin:0 0 18px;">Who Needs Business Setup in Bahrain?</h2>
      <p style="color:#2D3748;font-weight:700;font-size:1.05rem;margin-bottom:14px;">This service fits you in several situations:</p>
      <div style="display:flex;flex-direction:column;gap:10px;">
        {whoNeeds.map(h => (
          <div style="display:flex;align-items:flex-start;gap:10px;background:#F0FFFE;border:1px solid #B2F5EA;border-radius:10px;padding:12px 16px;">
            <span style="color:#38B2AC;font-weight:bold;flex-shrink:0;margin-top:2px;">✓</span>
            <p style="font-size:1rem;color:#2D3748;line-height:1.5;margin:0;font-weight:500;">{h}</p>
          </div>
        ))}
      </div>
    </div>

    <div>
      <div style="position:relative;border-radius:20px;overflow:hidden;box-shadow:0 12px 40px rgba(0,0,0,0.12);">
        <img src="/images/bahrain-flag.webp" alt="Company formation Bahrain" style="width:100%;height:440px;object-fit:cover;display:block;" loading="lazy" width="400" height="260" />
        <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(26,32,44,0.72) 100%);"></div>
        <div style="position:absolute;bottom:20px;left:20px;right:20px;">
          <p style="color:#fff;font-size:0.9rem;font-weight:800;margin:0 0 4px;">Index Office Services</p>
          <p style="color:#B2F5EA;font-size:0.75rem;margin:0;">End to end handling, from home country to embassy and MOFA stages.</p>
        </div>
        <div style="position:absolute;bottom:80px;left:-14px;background:#2D3748;color:#fff;padding:10px 16px;border-radius:10px;font-size:0.75rem;font-weight:700;box-shadow:0 6px 20px rgba(0,0,0,0.2);">
          400,000+ Clients Served
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ════ DOCUMENTS CHECKLIST ════ -->
<section id="documents" style="background:#F8FAFF;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1280px;margin:0 auto;">
    <div style="max-width:760px;margin-bottom:36px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Checklist</p>
      <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);font-weight:900;color:#1A202C;line-height:1.2;margin:0 0 16px;">Documents Checklist for Company Formation</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;margin:0;">Requirements change with your activity and structure. Prepare these items first:</p>
    </div>

    <div class="two-col" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:28px;">
      {documents.map(d => (
        <div style="display:flex;align-items:flex-start;gap:10px;background:#fff;border:1px solid #eef0f6;border-radius:10px;padding:14px 16px;">
          <span style="color:#38B2AC;font-weight:bold;flex-shrink:0;">•</span>
          <p style="font-size:0.98rem;color:#2D3748;font-weight:600;margin:0;line-height:1.5;" set:html={d}></p>
        </div>
      ))}
    </div>

    <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:12px;padding:18px 22px;">
      <p style="font-size:0.98rem;color:#2D3748;line-height:1.7;margin:0;font-weight:500;">Foreign corporate documents usually need attestation or apostille before filing, depending on the country that issued them. We confirm the exact route for your papers at the start.</p>
    </div>
  </div>
</section>

<!-- ════ STEP BY STEP ════ -->
<section style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1280px;margin:0 auto;">
    <div style="max-width:760px;margin-bottom:36px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Process</p>
      <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);font-weight:900;color:#1A202C;line-height:1.2;margin:0;">How Does Company Registration in Bahrain Work, Step by Step?</h2>
    </div>

    <div class="two-col" style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:32px;">
      {steps.map((s, i) => (
        <div class="company-card">
          <h3 style="font-size:0.92rem;font-weight:800;color:#1A202C;margin:0 0 10px;border-left:3px solid #38B2AC;padding-left:10px;">{i + 1}. {s.title}</h3>
          <p style="font-size:0.98rem;color:#4B5563;line-height:1.7;margin:0;">{s.body}</p>
        </div>
      ))}
    </div>

    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:20px;">
      <a href="#documents" class="btn-dark">Check My Documents</a>
      <a href="#get-in-touch" class="btn-primary">Request a Call Back</a>
    </div>
    <p style="color:#2D3748;font-weight:600;font-size:0.95rem;margin:0;">End to end handling, from home country to embassy and MOFA stages.</p>
  </div>
</section>

<!-- ════ TIME AND COST ════ -->
<section style="background:#F8FAFF;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(45,55,72,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(45,55,72,0.02) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1280px;margin:0 auto;">
    <div style="max-width:760px;margin-bottom:36px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Important Considerations</p>
      <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);font-weight:900;color:#1A202C;line-height:1.2;margin:0 0 16px;">What Affects Processing Time and Cost?</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;margin:0;">Every case differs, so we confirm a plan after reviewing your file.</p>
    </div>

    <div class="two-col" style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:28px;">
      <div style="background:#fff;border:1px solid #eef0f6;border-radius:16px;padding:28px;">
        <h3 style="font-size:1rem;font-weight:800;color:#1A202C;margin:0 0 14px;border-bottom:1px solid #B2F5EA;padding-bottom:10px;">Timeline factors</h3>
        <div style="display:flex;flex-direction:column;gap:10px;">
          {timelineFactors.map(t => (
            <div style="display:flex;align-items:flex-start;gap:10px;">
              <span style="color:#38B2AC;font-weight:bold;flex-shrink:0;">•</span>
              <p style="font-size:0.9rem;color:#4B5563;line-height:1.6;margin:0;">{t}</p>
            </div>
          ))}
        </div>
      </div>
      <div style="background:#fff;border:1px solid #eef0f6;border-radius:16px;padding:28px;">
        <h3 style="font-size:1rem;font-weight:800;color:#1A202C;margin:0 0 14px;border-bottom:1px solid #B2F5EA;padding-bottom:10px;">Cost factors</h3>
        <div style="display:flex;flex-direction:column;gap:10px;">
          {costFactors.map(t => (
            <div style="display:flex;align-items:flex-start;gap:10px;">
              <span style="color:#38B2AC;font-weight:bold;flex-shrink:0;">•</span>
              <p style="font-size:0.9rem;color:#4B5563;line-height:1.6;margin:0;">{t}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:12px;padding:18px 22px;">
      <p style="font-size:0.98rem;color:#2D3748;line-height:1.7;margin:0;font-weight:500;">Therefore, we quote after reviewing your activity and shareholders. <a href="/contact/" style="color:#2D3748;font-weight:700;text-decoration:underline;text-decoration-color:#38B2AC;text-underline-offset:3px;">Contact us</a> for a quote.</p>
    </div>
  </div>
</section>

<!-- ════ COMMON MISTAKES ════ -->
<section style="background:#fff;padding:76px 24px;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 48px,rgba(56,178,172,0.04) 48px,rgba(56,178,172,0.04) 49px);pointer-events:none;z-index:0;"></div>

  <div class="sec-inner" style="max-width:1280px;margin:0 auto;">
    <div style="max-width:760px;margin-bottom:36px;">
      <p style="color:#2D3748;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;font-size:0.75rem;margin-bottom:8px;">Avoid Delays</p>
      <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);font-weight:900;color:#1A202C;line-height:1.2;margin:0 0 16px;">Common Mistakes and Rejection Reasons</h2>
      <p style="color:#4B5563;font-size:1.05rem;line-height:1.8;margin:0;">Our team sees these issues most often:</p>
    </div>

    <div class="two-col" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:28px;">
      {mistakes.map(m => (
        <div style="display:flex;align-items:flex-start;gap:10px;background:#F8FAFF;border:1px solid #eef0f6;border-radius:10px;padding:14px 16px;">
          <span style="color:#38B2AC;font-weight:bold;flex-shrink:0;">!</span>
          <p style="font-size:0.98rem;color:#2D3748;font-weight:600;margin:0;line-height:1.5;">{m}</p>
        </div>
      ))}
    </div>

    <div style="background:#F0FFFE;border:1px solid #B2F5EA;border-radius:12px;padding:18px 22px;">
      <p style="font-size:0.98rem;color:#2D3748;line-height:1.7;margin:0;font-weight:500;">One missing stamp on a corporate document can add weeks, so we review every paper before it is filed.</p>
    </div>
  </div>
</section>

